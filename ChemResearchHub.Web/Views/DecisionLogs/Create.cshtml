@model ChemResearchHub.Web.Models.DecisionLogs.CreateDecisionLogViewModel

@{
    ViewData["Title"] = "Add Decision Log";
}

<div class="container py-4">

    <div class="mb-4">

        <div class="text-muted mb-1">
            Research Work Item
        </div>

        <h1 class="h3 mb-1">
            Add Decision Log
        </h1>

        <p class="text-muted mb-0">
            Record a research or workflow decision and its supporting rationale.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                <input asp-for="WorkItemId" type="hidden" />
                <input asp-for="ProjectId" type="hidden" />
                <input asp-for="BoardId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="DecisionType"
                           class="form-label">
                    </label>

                    <select asp-for="DecisionType"
                            class="form-select">

                        <option value="Scientific">
                            Scientific
                        </option>

                        <option value="Validation">
                            Validation
                        </option>

                        <option value="Review">
                            Review
                        </option>

                        <option value="Approval">
                            Approval
                        </option>

                        <option value="Rejection">
                            Rejection
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="DecisionType"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Decision"
                           class="form-label">
                    </label>

                    <textarea asp-for="Decision"
                              class="form-control"
                              rows="5"
                              placeholder="What decision was made?">
                    </textarea>

                    <span asp-validation-for="Decision"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Rationale"
                           class="form-label">
                    </label>

                    <textarea asp-for="Rationale"
                              class="form-control"
                              rows="6"
                              placeholder="Why was this decision made?">
                    </textarea>

                    <span asp-validation-for="Rationale"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Evidence"
                           class="form-label">
                    </label>

                    <textarea asp-for="Evidence"
                              class="form-control"
                              rows="6"
                              placeholder="Supporting observations, results, references, or evidence.">
                    </textarea>

                    <span asp-validation-for="Evidence"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Decision
                    </button>

                    <a asp-controller="WorkItems"
                       asp-action="Details"
                       asp-route-id="@Model.WorkItemId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-boardId="@Model.BoardId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}