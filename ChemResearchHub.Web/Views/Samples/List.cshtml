@model ChemResearchHub.Web.Models.Samples.SamplesListViewModel

@{
    ViewData["Title"] = "نمونه‌ها";
}

<style>
 .sample-reference-copy {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.sample-copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    font-size: 11px;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.sample-copy-button:hover {
    background: #e2e8f0;
    color: #4f46e5;
}

.sample-copy-button.copied {
    color: #16a34a;
    background: #dcfce7;
}
</style>

<div class="samples-page">

    <div class="samples-header">

        <div>
            <h1>نمونه‌ها</h1>

            <p>
                فهرست نمونه‌های ثبت‌شده در آزمایش‌های پژوهشی
            </p>
        </div>

        <div class="samples-count">
            @Model.Items.Count نمونه
        </div>

    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="samples-empty">

            <div class="samples-empty-icon">
                🧫
            </div>

            <h3>
                هنوز نمونه‌ای ثبت نشده است
            </h3>

            <p>
                نمونه‌ها از داخل بخش آزمایش‌های مربوط به کارهای پژوهشی ایجاد می‌شوند.
            </p>

            <a asp-controller="Experiments"
               asp-action="List"
               class="crh-btn crh-btn-primary">
                مشاهده آزمایش‌ها
            </a>

        </div>
    }
    else
    {
        <div class="samples-table-card">

            <div class="table-responsive">

                <table class="table crh-table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>کد نمونه</th>
                            <th>نام نمونه</th>
                            <th>نوع</th>
                            <th>Matrix</th>
                            <th>آزمایش</th>
                            <th>کار پژوهشی</th>
                            <th>تاریخ جمع‌آوری</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                               <div class="sample-reference-copy">

    <span class="crh-id">
        SMP-@item.Id.ToString("D6")
    </span>

    <button type="button"
            class="sample-copy-button"
            data-reference="SMP-@item.Id.ToString("D6")"
            title="کپی شناسه"
            aria-label="کپی شناسه SMP-@item.Id.ToString("D6")">

        📋

    </button>

</div>
                                </td>

                                <td>
                                    <div class="sample-code">
                                        @item.SampleCode
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Name))
                                    {
                                        <div class="crh-primary-text">
                                            @item.Name
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="crh-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.SampleType))
                                    {
                                        <span class="sample-type-badge">
                                            @item.SampleType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="crh-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Matrix))
                                    {
                                        @item.Matrix
                                    }
                                    else
                                    {
                                        <span class="crh-muted">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="crh-primary-text">
                                        @item.ExperimentTitle
                                    </div>

                                    <div class="crh-secondary-text">
                                        آزمایش #@item.ExperimentId
                                    </div>
                                </td>

                                <td>
                                    <div class="crh-primary-text">
                                        @item.WorkItemTitle
                                    </div>

                                    <div class="crh-secondary-text">
                                        کار #@item.WorkItemId
                                    </div>
                                </td>

                                <td>
                                    @if (item.CollectedAt.HasValue)
                                    {
                                        @item.CollectedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                    }
                                    else
                                    {
                                        <span class="crh-muted">
                                            —
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Samples" asp-action="Details"
   asp-route-id="@item.Id"
   class="crh-id">
   مشاهده
</a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

                                        <script>
                                            document.addEventListener("DOMContentLoaded", function () {

    const copyButtons =
        document.querySelectorAll(".sample-copy-button");

    copyButtons.forEach(function (button) {

        button.addEventListener("click", async function (event) {

            event.preventDefault();
            event.stopPropagation();

            const referenceCode =
                button.dataset.reference;

            if (!referenceCode) {
                return;
            }

            try {

                await navigator.clipboard.writeText(
                    referenceCode);

                const originalText =
                    button.textContent;

                button.textContent = "✓";

                button.classList.add("copied");

                button.title = "کپی شد";

                setTimeout(function () {

                    button.textContent =
                        originalText;

                    button.classList.remove("copied");

                    button.title =
                        "کپی شناسه";

                }, 1200);

            }
            catch (error) {

                console.error(
                    "Could not copy sample reference:",
                    error);

            }

        });

    });

});
                                        </script>