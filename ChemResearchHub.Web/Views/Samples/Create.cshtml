@model ChemResearchHub.Web.Models.Samples.CreateSampleViewModel

@{
    ViewData["Title"] = "Create Sample";
}

<div class="container py-4">

    <div class="mb-4">

        <div class="text-muted mb-1">
            Research Experiment
        </div>

        <h1 class="h3 mb-1">
            Create Sample
        </h1>

        <p class="text-muted mb-0">
            Register a new sample for this experiment.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                <input asp-for="ExperimentId"
                       type="hidden" />

                <input asp-for="WorkItemId"
                       type="hidden" />

                <input asp-for="ProjectId"
                       type="hidden" />

                <input asp-for="BoardId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="SampleCode"
                               class="form-label">
                        </label>

                        <input asp-for="SampleCode"
                               class="form-control"
                               placeholder="For example: SAFF-001" />

                        <span asp-validation-for="SampleCode"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="For example: Iranian saffron sample" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="SampleType"
                               class="form-label">
                        </label>

                        <input asp-for="SampleType"
                               class="form-control"
                               placeholder="For example: Saffron" />

                        <span asp-validation-for="SampleType"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Matrix"
                               class="form-label">
                        </label>

                        <input asp-for="Matrix"
                               class="form-control"
                               placeholder="For example: Plant material" />

                        <span asp-validation-for="Matrix"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="PreparationMethod"
                           class="form-label">
                    </label>

                    <textarea asp-for="PreparationMethod"
                              class="form-control"
                              rows="5"
                              placeholder="Describe sample preparation, extraction, dilution, solvent, concentration, etc.">
                    </textarea>

                    <span asp-validation-for="PreparationMethod"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="CollectedAt"
                               class="form-label">
                        </label>

                        <input asp-for="CollectedAt"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="CollectedAt"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="ExternalReference"
                               class="form-label">
                        </label>

                        <input asp-for="ExternalReference"
                               class="form-control"
                               placeholder="Laboratory or external reference" />

                        <span asp-validation-for="ExternalReference"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the sample and its purpose...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Notes"
                           class="form-label">
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="5"
                              placeholder="Additional observations or laboratory notes...">
                    </textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Sample
                    </button>

                    <a asp-controller="WorkItems"
                       asp-action="Details"
                       asp-route-id="@Model.WorkItemId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-boardId="@Model.BoardId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}