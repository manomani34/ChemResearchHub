@model ChemResearchHub.Web.Models.Projects.EditProjectViewModel

@{
    ViewData["Title"] = "ویرایش پروژه";
}

<div class="project-form-page">

    <div class="project-form-header">

        <div>
            <div class="project-form-kicker">
                پروژه #@Model.Id
            </div>

            <h1>
                ویرایش پروژه
            </h1>

            <p>
                اطلاعات و وضعیت پروژه پژوهشی را مدیریت کنید.
            </p>
        </div>

        <div class="project-form-header-actions">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="crh-btn crh-btn-soft">
                مشاهده پروژه
            </a>

            <a asp-action="Index"
               class="crh-btn crh-btn-soft">
                بازگشت
            </a>

        </div>

    </div>

    <div class="project-form-card">

        <form asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="project-validation-summary">
            </div>

            <div class="project-form-section">

                <div class="project-form-section-title">
                    اطلاعات پروژه
                </div>

                <div class="project-form-field">

                    <label asp-for="Name"
                           class="project-form-label">
                    </label>

                    <input asp-for="Name"
                           class="project-form-input"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="project-form-error">
                    </span>

                </div>

                <div class="project-form-field">

                    <label asp-for="Description"
                           class="project-form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="project-form-input project-form-textarea"
                              rows="6">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="project-form-error">
                    </span>

                </div>

            </div>

            <div class="project-form-section">

                <div class="project-form-section-title">
                    وضعیت پروژه
                </div>

                <label class="project-active-toggle">

                    <span class="project-active-toggle-content">

                        <span class="project-active-toggle-title">
                            پروژه فعال باشد
                        </span>

                        <span class="project-active-toggle-description">
                            پروژه غیرفعال از جریان کاری فعال خارج می‌شود، اما اطلاعات آن حفظ خواهد شد.
                        </span>

                    </span>

                    <input asp-for="IsActive"
                           class="project-active-checkbox" />

                    <span class="project-active-switch">
                    </span>

                </label>

            </div>

            <div class="project-form-actions">

                <button type="submit"
                        class="crh-btn crh-btn-primary">
                    ذخیره تغییرات
                </button>

                <a asp-action="Index"
                   class="crh-btn crh-btn-soft">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}