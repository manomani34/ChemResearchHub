@model IReadOnlyList<ChemResearchHub.Application.Projects.Dtos.ProjectDto>

@{
    ViewData["Title"] = "پروژه‌های پژوهشی";
}

<style>
    .project-reference-copy {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .project-copy-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        padding: 0;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        font-size: 11px;
    }

    .project-copy-button:hover {
        background: #e2e8f0;
        color: #4f46e5;
    }

    .project-copy-button.copied {
        color: #16a34a;
        background: #dcfce7;
    }
</style>

<div class="projects-page">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="crh-alert crh-alert-success">
            <span class="crh-alert-icon">✓</span>
            <span>@successMessage</span>
        </div>
    }

    <div class="projects-header">

        <div>
            <div class="projects-header-title">
                پروژه‌های پژوهشی
            </div>

            <div class="projects-header-subtitle">
                مدیریت پروژه‌های تحقیقاتی و مشاهده فضای پژوهش
            </div>
        </div>

        <div>
            <a asp-action="Create"
               class="crh-btn crh-btn-primary">
                + پروژه جدید
            </a>
        </div>

    </div>

    @if (Model.Count == 0)
    {
        <div class="projects-empty">

            <div class="projects-empty-icon">
                🧪
            </div>

            <div class="projects-empty-title">
                هنوز پروژه‌ای ثبت نشده است
            </div>

            <div class="projects-empty-text">
                برای شروع، اولین پروژه پژوهشی خود را ایجاد کنید.
            </div>

            <a asp-action="Create"
               class="crh-btn crh-btn-primary">
                ایجاد اولین پروژه
            </a>

        </div>
    }
    else
    {
        <div class="projects-grid">

            @foreach (var project in Model)
            {
                <div class="project-card">

                    <div class="project-card-header">

                        <div class="project-card-icon">
                            🧪
                        </div>

                         <div class="project-card-id">
                            <div class="project-reference-copy">

                                <span class="crh-id">
                                    @project.ReferenceCode
                                </span>

                                <button type="button"
                                        class="project-copy-button"
                                        data-reference="@project.ReferenceCode"
                                        title="کپی شناسه"
                                        aria-label="کپی شناسه @project.ReferenceCode">
                                    📋
                                </button>

                            </div>
                        </div>

                        <div class="project-status
                            @(project.IsActive
                                ? "project-status-active"
                                : "project-status-inactive")">

                            @(project.IsActive
                                ? "فعال"
                                : "غیرفعال")

                        </div>

                       

                    </div>

                    <div class="project-card-title">
                        @project.Name
                    </div>

                    <div class="project-card-description">

                        @if (string.IsNullOrWhiteSpace(project.Description))
                        {
                            <span class="project-description-empty">
                                توضیحی برای این پروژه ثبت نشده است.
                            </span>
                        }
                        else
                        {
                            @project.Description
                        }

                    </div>

                    <div class="project-card-footer">                        

                        <div class="project-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                جزئیات
                            </a>

                            <a asp-controller="Boards"
                               asp-action="Index"
                               asp-route-projectId="@project.Id"
                               class="crh-btn crh-btn-primary">
                                بورد
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                ویرایش
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".project-copy-button")
                .forEach(function (button) {

                    button.addEventListener("click", async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode =
                            button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(
                                referenceCode
                            );

                            const originalText =
                                button.textContent;

                            button.textContent = "✓";
                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function () {
                                button.textContent = originalText;
                                button.classList.remove("copied");
                                button.title = "کپی شناسه";
                            }, 1200);

                        } catch (error) {
                            console.error(
                                "Could not copy project reference:",
                                error
                            );
                        }
                    });
                });
        });
    </script>
}