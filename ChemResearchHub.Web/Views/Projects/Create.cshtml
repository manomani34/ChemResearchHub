@model ChemResearchHub.Web.Models.Projects.CreateProjectViewModel

@{
    ViewData["Title"] = "ایجاد پروژه";
}

<div class="project-form-page">

    <div class="project-form-header">

        <div>
            <div class="project-form-kicker">
                پروژه پژوهشی
            </div>

            <h1>
                ایجاد پروژه جدید
            </h1>

            <p>
                اطلاعات پایه پروژه پژوهشی را وارد کنید.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="crh-btn crh-btn-soft">
                بازگشت به پروژه‌ها
            </a>
        </div>

    </div>

    <div class="project-form-card">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="project-validation-summary">
            </div>

            <div class="project-form-section">

                <div class="project-form-section-title">
                    اطلاعات پروژه
                </div>

                <div class="project-form-field">

                    <label asp-for="Name"
                           class="project-form-label">
                    </label>

                    <input asp-for="Name"
                           class="project-form-input"
                           autocomplete="off"
                           placeholder="مثلاً توسعه روش تحلیل NMR" />

                    <span asp-validation-for="Name"
                          class="project-form-error">
                    </span>

                </div>

                <div class="project-form-field">

                    <label asp-for="Description"
                           class="project-form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="project-form-input project-form-textarea"
                              rows="6"
                              placeholder="توضیح مختصر درباره هدف و محدوده پروژه...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="project-form-error">
                    </span>

                </div>

            </div>

            <div class="project-form-actions">

                <button type="submit"
                        class="crh-btn crh-btn-primary">
                    ایجاد پروژه
                </button>

                <a asp-action="Index"
                   class="crh-btn crh-btn-soft">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}