@model IReadOnlyList<ChemResearchHub.Application.Users.Dtos.UserDto>

@{
    ViewData["Title"] = "Team Members";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="text-muted mb-1">
                Team Management
            </div>

            <h1 class="h3 mb-1">
                Team Members
            </h1>

            <p class="text-muted mb-0">
                Researchers and team members of ChemResearchHub.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Add User
        </a>

    </div>

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="mb-2">
                    No users
                </h5>

                <p class="text-muted mb-0">
                    There are currently no team members.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Full Name
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                                                        ? "-"
                                                                        : user.FullName)
                            </strong>
                        </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                            @if (user.RoleName == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else if (user.RoleName == "Reviewer")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Reviewer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Researcher
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>