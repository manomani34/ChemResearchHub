@model ChemResearchHub.Web.Models.Results.CreateResultViewModel

@{
    ViewData["Title"] = "Create Result";
}

<div class="container py-4">

    <div class="mb-4">

        <div class="text-muted mb-1">
            Research Sample
        </div>

        <h1 class="h3 mb-1">
            Create Result
        </h1>

        <p class="text-muted mb-0">
            Register a structured result for this sample.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                <input asp-for="SampleId" type="hidden" />
                <input asp-for="ExperimentId" type="hidden" />
                <input asp-for="WorkItemId" type="hidden" />
                <input asp-for="ProjectId" type="hidden" />
                <input asp-for="BoardId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="MetricName"
                           class="form-label">
                    </label>

                    <input asp-for="MetricName"
                           class="form-control"
                           placeholder="For example: Purity" />

                    <span asp-validation-for="MetricName"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="NumericValue"
                               class="form-label">
                        </label>

                        <input asp-for="NumericValue"
                               class="form-control"
                               type="number"
                               step="0.000001" />

                        <span asp-validation-for="NumericValue"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Unit"
                               class="form-label">
                        </label>

                        <input asp-for="Unit"
                               class="form-control"
                               placeholder="%, mg/g, ppm, ..." />

                        <span asp-validation-for="Unit"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="TextValue"
                           class="form-label">
                    </label>

                    <textarea asp-for="TextValue"
                              class="form-control"
                              rows="3"
                              placeholder="For qualitative results, enter the text result here.">
                    </textarea>

                    <span asp-validation-for="TextValue"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Method"
                           class="form-label">
                    </label>

                    <textarea asp-for="Method"
                              class="form-control"
                              rows="3"
                              placeholder="Analytical method or calculation used.">
                    </textarea>

                    <span asp-validation-for="Method"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label">
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">Pending</option>
                        <option value="Pass">Pass</option>
                        <option value="Fail">Fail</option>
                        <option value="Inconclusive">Inconclusive</option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Evidence"
                           class="form-label">
                    </label>

                    <textarea asp-for="Evidence"
                              class="form-control"
                              rows="5"
                              placeholder="Evidence, observed signal, calculation, spectrum reference, etc.">
                    </textarea>

                    <span asp-validation-for="Evidence"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Notes"
                           class="form-label">
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="5"
                              placeholder="Additional research notes.">
                    </textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Result
                    </button>

                    <a asp-controller="WorkItems"
                       asp-action="Details"
                       asp-route-id="@Model.WorkItemId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-boardId="@Model.BoardId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}