@model ChemResearchHub.Web.Models.Boards.CreateBoardViewModel

@{
    var project =
        (ChemResearchHub.Application.Projects.Dtos.ProjectDto)ViewBag.Project;

    ViewData["Title"] = "Create Board";
}

<div class="container py-4">

    <div class="mb-4">
        <div class="text-muted mb-1">
            Project
        </div>

        <h1 class="h3 mb-1">
            @project.Name
        </h1>

        <p class="text-muted mb-0">
            Create a research board for this project.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <input asp-for="ProjectId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">
                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="For example: Main Research Board" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Board
                    </button>

                    <a asp-action="Index"
                       asp-route-projectId="@Model.ProjectId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}