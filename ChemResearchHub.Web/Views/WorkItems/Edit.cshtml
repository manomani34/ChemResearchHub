@model ChemResearchHub.Web.Models.WorkItems.EditWorkItemViewModel

@{
    ViewData["Title"] = "Edit Work Item";
}

<div class="container py-4">

    <div class="mb-4">
        <div class="text-muted mb-1">
            Research Work Item
        </div>

        <h1 class="h3 mb-1">
            Edit Work Item
        </h1>

        <p class="text-muted mb-0">
            Update the work item details and status.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />
                <input asp-for="ProjectId" type="hidden" />
                <input asp-for="BoardId" type="hidden" />
                <input asp-for="BoardColumnId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Type"
                               class="form-label">
                        </label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<ChemResearchHub.Domain.Enums.WorkItemType>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Priority"
                               class="form-label">
                        </label>

                        <input asp-for="Priority"
                               type="number"
                               class="form-control"
                               min="0"
                               max="10" />

                        <span asp-validation-for="Priority"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="DueDate"
                           class="form-label">
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DueDate"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-check mb-4">

                    <input asp-for="IsCompleted"
                           class="form-check-input" />

                    <label asp-for="IsCompleted"
                           class="form-check-label">
                        Completed
                    </label>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Boards"
                       asp-action="Index"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-boardId="@Model.BoardId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}