@model ChemResearchHub.Web.Models.Attachments.AttachmentsListViewModel

@{
    ViewData["Title"] = "پیوست‌ها";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/attachments-index.css"
          asp-append-version="true" />
}

<div class="attachments-page">

    <div class="attachments-header">
        <div class="attachments-heading">
            <div class="attachments-eyebrow">Research Files</div>
            <h1>پیوست‌ها</h1>
            <p>فایل‌های مرتبط با کارهای پژوهشی</p>
        </div>

        <div class="attachments-count">
            <strong>@Model.Items.Count</strong>
            <span>فایل</span>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="attachments-empty">
            <div class="attachments-empty-icon">📎</div>

            <h3>هنوز فایلی ثبت نشده است</h3>

            <p>
                فایل‌ها از داخل بخش کارهای پژوهشی به سامانه اضافه می‌شوند.
            </p>

            <a asp-area="Research"
               asp-controller="WorkItems"
               asp-action="Index"
               class="attachments-btn attachments-btn-primary">
                مشاهده کارهای پژوهشی
            </a>
        </div>
    }
    else
    {
        <div class="attachments-table-card">

            <div class="attachments-table-header">
                <div>
                    <h2>فهرست فایل‌ها</h2>
                    <p>اطلاعات و جزئیات فایل‌های بارگذاری‌شده</p>
                </div>

                <span class="attachments-table-count">
                    @Model.Items.Count مورد
                </span>
            </div>

            <div class="table-responsive">
                <table class="table attachments-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>فایل</th>
                            <th>کار پژوهشی</th>
                            <th>نوع فایل</th>
                            <th>حجم</th>
                            <th>توضیحات</th>
                            <th>تاریخ آپلود</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="attachment-reference-copy">
                                        <span class="attachment-reference">
                                            @item.ReferenceCode
                                        </span>

                                        <button type="button"
                                                class="attachment-copy-button"
                                                data-reference="@item.ReferenceCode"
                                                title="کپی شناسه"
                                                aria-label="کپی شناسه @item.ReferenceCode">
                                            📋
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    <div class="attachment-file">
                                        <span class="attachment-file-icon">📄</span>

                                        <div class="attachment-file-info">
                                            <div class="attachment-primary-text">
                                                @item.OriginalFileName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.ContentType))
                                            {
                                                <div class="attachment-secondary-text">
                                                    @item.ContentType
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="attachment-primary-text">
                                        @item.WorkItemTitle
                                    </div>

                                    <div class="attachment-secondary-text">
                                        کار #@item.WorkItemId
                                    </div>
                                </td>

                                <td>
                                    @{
                                        var extension =
                                            System.IO.Path.GetExtension(item.OriginalFileName);

                                        if (string.IsNullOrWhiteSpace(extension))
                                        {
                                            extension = "—";
                                        }
                                    }

                                    <span class="attachment-extension">
                                        @extension
                                    </span>
                                </td>

                                <td>
                                    @{
                                        string fileSizeText;

                                        if (item.FileSize < 1024)
                                        {
                                            fileSizeText = $"{item.FileSize:N0} B";
                                        }
                                        else if (item.FileSize < 1024 * 1024)
                                        {
                                            fileSizeText = $"{item.FileSize / 1024d:0.##} KB";
                                        }
                                        else
                                        {
                                            fileSizeText = $"{item.FileSize / (1024d * 1024d):0.##} MB";
                                        }
                                    }

                                    <span class="attachment-file-size">
                                        @fileSizeText
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="attachment-description"
                                              title="@item.Description">
                                            @item.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="attachment-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="attachment-date">
                                        @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Attachments"
                                       asp-action="Download"
                                       asp-route-id="@item.Id"
                                       class="attachments-btn attachments-btn-soft attachment-download-btn">
                                        <span>↓</span>
                                        دانلود
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const page = document.querySelector(".attachments-page");

            if (!page) return;

            page.querySelectorAll(".attachment-copy-button")
                .forEach(function (button) {

                    button.addEventListener("click", async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode = button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(referenceCode);

                            const originalText = button.textContent;

                            button.textContent = "✓";
                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function () {
                                button.textContent = originalText;
                                button.classList.remove("copied");
                                button.title = "کپی شناسه";
                            }, 1200);

                        } catch (error) {
                            console.error(error);
                        }
                    });
                });
        });
    </script>
}