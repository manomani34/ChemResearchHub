                            <div class="sidebar-brand-subtitle">
                                سامانه پژوهشی
                            </div>
                        </div>

                    </a>

                    <button type="button"
                            class="btn-close d-lg-none"
                            data-bs-dismiss="offcanvas"
                            aria-label="بستن">
                    </button>

                </div>

                <nav class="sidebar-nav"
                     dir="rtl">

                    <div class="sidebar-section-title">
                        اصلی
                    </div>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            🏠
                        </span>

                        <span>
                            داشبورد
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Projects"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            📁
                        </span>

                        <span>
                            پروژه‌ها
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Boards"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            📋
                        </span>

                        <span>
                            بوردهای پژوهشی
                        </span>

                    </a>


                    <div class="sidebar-section-title mt-4">
                        پژوهش
                    </div>

                    <a asp-area=""
                       asp-controller="WorkItems"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            ✅
                        </span>

                        <span>
                            کارهای پژوهشی
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Experiments"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            🧪
                        </span>

                        <span>
                            آزمایش‌ها
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Samples"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            🧫
                        </span>

                        <span>
                            نمونه‌ها
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Results"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            📊
                        </span>

                        <span>
                            نتایج
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="Attachments"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            📎
                        </span>

                        <span>
                            پیوست‌ها
                        </span>

                    </a>

                    <a asp-area=""
                       asp-controller="DecisionLogs"
                       asp-action="List"
                       class="sidebar-link">

                        <span class="sidebar-link-icon">
                            📋
                        </span>

                        <span>
                            تصمیمات
                        </span>

                    </a>


@if (User.IsInRole("Admin"))
{
