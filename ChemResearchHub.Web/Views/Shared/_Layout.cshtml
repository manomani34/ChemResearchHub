          href="~/css/font.css" />

          <style>
    .work-item-alert-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 21px;
        height: 21px;
        padding: 0 6px;
        margin-right: auto;
        border-radius: 50px;
        background: #dc3545;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
    }

    /* =========================================================
   ChemResearchHub - Light Sidebar Theme
   ========================================================= */

.app-sidebar {
    background: #f7f8fc !important;
    border-left: 1px solid #e9eaf1;
    box-shadow: 5px 0 25px rgba(30, 35, 70, .04);
}

.app-sidebar .sidebar-inner {
    background: #f7f8fc;
}

.app-sidebar .sidebar-brand {
    background: #fff;
    border-bottom: 1px solid #e9eaf1;
}

.app-sidebar .sidebar-brand-icon {
    background: #f0efff;
    color: #6558d3;
    border-radius: 12px;
}

.app-sidebar .sidebar-brand-title {
    color: #292b3c;
    font-weight: 750;
}

.app-sidebar .sidebar-brand-subtitle {
    color: #9294a5;
}

.app-sidebar .sidebar-nav {
    background: #f7f8fc;
    padding: 18px 14px;
}

.app-sidebar .sidebar-section-title {
    color: #999bad;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .4px;
    padding: 0 12px;
    margin-bottom: 9px;
}

.app-sidebar .sidebar-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    margin-bottom: 5px;
    padding: 10px 13px;
    border: 1px solid transparent;
    border-radius: 11px;
    color: #626579;
    font-size: 13px;
    font-weight: 550;
    text-decoration: none;
    background: transparent;
    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.app-sidebar .sidebar-link:hover {
    color: #5144bd;
    background: #f0efff;
    border-color: #e8e5ff;
    transform: translateX(-2px);
}

.app-sidebar .sidebar-link.active {
    color: #5144bd;
    background: #eeecff;
    border-color: #e3dfff;
    font-weight: 700;
    box-shadow: 0 3px 10px rgba(81, 68, 189, .06);
}

.app-sidebar .sidebar-link.active::before {
    content: "";
    position: absolute;
    right: -14px;
    top: 9px;
    bottom: 9px;
    width: 4px;
    border-radius: 4px 0 0 4px;
    background: #6558d3;
}

.app-sidebar .sidebar-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 25px;
    width: 25px;
    height: 25px;
    border-radius: 8px;
    font-size: 15px;
    transition: background .2s ease;
}

.app-sidebar .sidebar-link.active .sidebar-link-icon {
    background: #e2deff;
}

.app-sidebar .sidebar-footer {
    background: #fff;
    border-top: 1px solid #e9eaf1;
    padding: 15px;
}

.app-sidebar .sidebar-user-card {
    background: #f7f8fc;
    border: 1px solid #ececf3;
    border-radius: 13px;
    padding: 11px;
}

.app-sidebar .sidebar-user-icon {
    background: #f0efff;
    color: #6558d3;
    border-radius: 10px;
}

.app-sidebar .sidebar-user-name {
    color: #34364a;
    font-weight: 700;
}

.app-sidebar .sidebar-user-role {
    color: #9294a5;
}

.app-sidebar .sidebar-logout {
    margin-top: 12px;
}

/* Work Item Notification Badge */

.app-sidebar .work-item-alert-badge {
    margin-right: auto;
    flex-shrink: 0;
}

/* Mobile */

@@media (max-width: 991.98px) {
    .app-sidebar {
        box-shadow: -8px 0 30px rgba(30, 35, 70, .10);
    }

    .app-sidebar .sidebar-link.active::before {
        right: -14px;
    }
}
/* =========================================================
   Sidebar - Unified Inline SVG Icons
   ========================================================= */

.app-sidebar .sidebar-link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: #7771a8;
    background: transparent;
    transition:
        color .2s ease,
        background .2s ease,
        transform .2s ease;
}

.app-sidebar .sidebar-link-icon svg {
    display: block;
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.app-sidebar .sidebar-link:hover .sidebar-link-icon {
    color: #6558d3;
    background: #f0efff;
}

.app-sidebar .sidebar-link.active .sidebar-link-icon {
    color: #5144bd;
    background: #e8e5ff;
}

.app-sidebar .sidebar-link.active .sidebar-link-icon svg {
    stroke-width: 2;
}

.app-sidebar .sidebar-brand-icon svg,
.app-sidebar .sidebar-user-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}
</style>

@await RenderSectionAsync("Styles", required: false)

</head>

