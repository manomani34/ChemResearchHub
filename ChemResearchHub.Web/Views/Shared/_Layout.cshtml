       class="sidebar-link">

        <span class="sidebar-link-icon">
            📊
        </span>

        <span>
            داشبورد مدیریت
        </span>

    </a>


    <!-- Reports -->

    <a asp-area="Admin"
       asp-controller="Reports"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-link-icon">
            📈
        </span>

        <span>
            گزارش‌ها
        </span>

    </a>


    <!-- Users -->

    <a asp-area=""
       asp-controller="Users"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-link-icon">
            👥
        </span>

        <span>
            مدیریت اعضای تیم
        </span>

    </a>


    <!-- Reviews -->

    <a asp-area=""
       asp-controller="Reviews"
       asp-action="Index"
       class="sidebar-link">

