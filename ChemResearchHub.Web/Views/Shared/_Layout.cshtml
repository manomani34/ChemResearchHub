@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    string IsActive(string area, string controller, string? action = null)
    {
        var areaMatches = string.Equals(
            currentArea,
            area,
            StringComparison.OrdinalIgnoreCase);

        var controllerMatches = string.Equals(
            currentController,
            controller,
            StringComparison.OrdinalIgnoreCase);

        var actionMatches = action == null ||
            string.Equals(
                currentAction,
                action,
                StringComparison.OrdinalIgnoreCase);

        return areaMatches && controllerMatches && actionMatches
            ? "active"
            : "";
    }

    string IsIdentityActive(string page)
    {
        return string.Equals(
            currentPage,
            page,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }
}

