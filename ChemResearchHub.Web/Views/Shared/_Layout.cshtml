<script>
document.addEventListener("DOMContentLoaded", function () {

    const appShell = document.querySelector(".app-shell");
    const toggleButton = document.getElementById("sidebarDesktopToggle");
    const sidebar = document.getElementById("appSidebar");

    if (!appShell || !toggleButton || !sidebar) {
        return;
    }

    const desktopMedia = window.matchMedia("(min-width: 992px)");
    const storageKey = "chemresearchhub-sidebar-collapsed";

    function setCollapsed(collapsed, save = false) {

        if (!desktopMedia.matches) {
            appShell.classList.remove("sidebar-collapsed");
            return;
        }

        appShell.classList.toggle("sidebar-collapsed", collapsed);

        toggleButton.setAttribute(
            "aria-expanded",
            String(!collapsed)
        );

        const label = collapsed
            ? "باز کردن منو"
            : "جمع کردن منو";

        toggleButton.setAttribute("aria-label", label);
        toggleButton.setAttribute("title", label);

        if (save) {
            try {
                localStorage.setItem(
                    storageKey,
                    String(collapsed)
                );
            } catch (error) {
                console.warn("Sidebar preference could not be saved.", error);
            }
        }
    }

    function initializeTooltips() {

        const links = sidebar.querySelectorAll(".sidebar-link");

        links.forEach(function (link) {

            const textElement = Array.from(link.children).find(function (child) {
                return child.tagName === "SPAN" &&
                    !child.classList.contains("sidebar-link-icon") &&
                    !child.classList.contains("work-item-alert-badge");
            });

            if (!textElement) {
                return;
            }

            const label = textElement.textContent.trim();

            if (label) {
                link.setAttribute("data-sidebar-tooltip", label);
                link.setAttribute("aria-label", label);
            }
        });
    }

    let savedCollapsed = false;

    try {
        savedCollapsed =
            localStorage.getItem(storageKey) === "true";
    } catch (error) {
        console.warn("Sidebar preference could not be loaded.", error);
    }

    initializeTooltips();
    setCollapsed(savedCollapsed);

    toggleButton.addEventListener("click", function () {

        if (!desktopMedia.matches) {
            return;
        }

        const collapsed =
            !appShell.classList.contains("sidebar-collapsed");

        setCollapsed(collapsed, true);
    });

    desktopMedia.addEventListener("change", function (event) {

        if (!event.matches) {
            appShell.classList.remove("sidebar-collapsed");
            return;
        }

        let preference = false;

        try {
            preference =
                localStorage.getItem(storageKey) === "true";
        } catch (error) {
            console.warn("Sidebar preference could not be loaded.", error);
        }

        setCollapsed(preference);
    });

});
</script>

            <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", async function () {

    const badge = document.getElementById("workItemAlertBadge");
    const menuLink = document.getElementById("workItemsMenuLink");

    if (!badge || !menuLink) {
        return;
    }

    const unreadCountUrl =
        "/Research/WorkItemAlerts/UnreadCount";

    const markAsReadUrl =
        "/Research/WorkItemAlerts/MarkAllAsRead";

    function updateBadge(count) {
        const value = Number(count) || 0;

        badge.textContent = value > 99 ? "99+" : value;
        badge.style.display = value > 0 ? "inline-flex" : "none";
    }

    async function loadUnreadCount() {
        try {
            const response = await fetch(unreadCountUrl, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                    "Accept": "application/json"
                }
            });

            if (!response.ok) {
                return;
            }

            const data = await response.json();
            updateBadge(data.count);

        } catch (error) {
            console.error("Loading work item alerts failed:", error);
        }
    }

    // دریافت شمارنده هنگام بارگذاری صفحه
    await loadUnreadCount();

    // اتصال SignalR
    if (typeof signalR !== "undefined") {

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/work-item-alerts")
            .withAutomaticReconnect()
            .build();

        connection.on("UnreadCountChanged", function (count) {
            updateBadge(count);
        });

        try {
            await connection.start();
        } catch (error) {
            console.error("SignalR connection failed:", error);
        }
    }

    // با کلیک روی منوی کارهای پژوهشی، اعلان‌ها خوانده‌شده می‌شوند.
    // Mark Work Item alerts as read before navigating.
menuLink.addEventListener("click", async function (event) {
    event.preventDefault();

    const destinationUrl = menuLink.href;

    try {
        const tokenInput = document.querySelector(
            '#antiForgeryForm input[name="__RequestVerificationToken"]'
        );

        const headers = {
            "Content-Type": "application/json"
        };

        if (tokenInput) {
            headers["RequestVerificationToken"] = tokenInput.value;
        }

        const response = await fetch(markAsReadUrl, {
            method: "POST",
            credentials: "same-origin",
            headers,
            body: "{}"
        });

        if (!response.ok) {
            throw new Error(
                `MarkAllAsRead failed with status ${response.status}`
            );
        }

        updateBadge(0);

    } catch (error) {
        console.error(
            "Marking work item alerts as read failed:",
            error
        );
    } finally {
        window.location.href = destinationUrl;
    }
});

});
</script>


