@model ChemResearchHub.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
Layout = "~/Views/Shared/_Layout.cshtml";
ViewData["Title"] = "داشبورد مدیریت";
}

<div class="admin-dashboard" dir="rtl">


<!-- Header -->
<section class="dashboard-hero">

    <div class="hero-content">

        <div class="hero-badge">
            <span>👑</span>
            پنل مدیریت
        </div>

        <h1>
            داشبورد مدیریتی
        </h1>

        <p>
            نمای کلی از وضعیت پروژه ها، فعالیت های پژوهشی، کاربران و داده های سامانه
        </p>

    </div>

    <div class="hero-actions">
    <a href="/Admin/Reports"
   class="admin-dashboard-nav-btn admin-dashboard-nav-primary">
    <span>📈</span>
    <span>گزارش‌های مدیریتی</span>
</a>
</div>

</section>


<!-- Main KPI -->
<section class="kpi-grid">

    <div class="kpi-card kpi-blue">

        <div class="kpi-top">
            <div class="kpi-icon">
                📁
            </div>

            <span class="kpi-label">
                پروژه ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.ProjectCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveProjectCount پروژه فعال
        </div>

    </div>


    <div class="kpi-card kpi-green">

        <div class="kpi-top">
            <div class="kpi-icon">
                📋
            </div>

            <span class="kpi-label">
                Work Item ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.WorkItemCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.OpenWorkItemCount مورد باز
        </div>

    </div>


    <div class="kpi-card kpi-orange">

        <div class="kpi-top">
            <div class="kpi-icon">
                👥
            </div>

            <span class="kpi-label">
                کاربران
            </span>
        </div>

        <div class="kpi-value">
            @Model.UserCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveUserCount کاربر فعال
        </div>

    </div>


    <div class="kpi-card kpi-purple">

        <div class="kpi-top">
            <div class="kpi-icon">
                🧪
            </div>

            <span class="kpi-label">
                آزمایش ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.ExperimentCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveExperimentCount آزمایش فعال
        </div>

    </div>

</section>


<!-- Quick Actions -->
<section class="dashboard-section">

    <div class="section-title-row">

        <div>
            <span class="section-kicker">
                دسترسی سریع
            </span>

            <h2>
                کارهای مدیریتی
            </h2>
        </div>

        <span class="section-description">
            دسترسی مستقیم به بخش های پرکاربرد سامانه
        </span>

    </div>


    <div class="quick-actions-grid">

        <a asp-area=""
           asp-controller="Users"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                👥
            </div>

            <div class="quick-action-content">
                <h3>اعضای تیم</h3>
                <p>کاربران و نقش ها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area="Admin"
           asp-controller="Reports"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📊
            </div>

            <div class="quick-action-content">
                <h3>گزارش ها</h3>
                <p>گزارش های مدیریتی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Reviews"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🔍
            </div>

            <div class="quick-action-content">
                <h3>بازبینی ها</h3>
                <p>مدیریت Reviewها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Projects"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📁
            </div>

            <div class="quick-action-content">
                <h3>پروژه ها</h3>
                <p>مدیریت پروژه ها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="WorkItems"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📋
            </div>

            <div class="quick-action-content">
                <h3>Work Itemها</h3>
                <p>فعالیت های کاری</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Experiments"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🧪
            </div>

            <div class="quick-action-content">
                <h3>آزمایش ها</h3>
                <p>آزمایش های پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Samples"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🧫
            </div>

            <div class="quick-action-content">
                <h3>نمونه ها</h3>
                <p>نمونه های پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="DecisionLogs"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                ⚖️
            </div>

            <div class="quick-action-content">
                <h3>تصمیمات</h3>
                <p>سوابق تصمیمات پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>

    </div>

</section>


<!-- Secondary Statistics -->
<section class="secondary-stats">

    <div class="secondary-stat">
        <div class="secondary-icon">
            🧫
        </div>

        <div>
            <span>Samples</span>
            <strong>@Model.SampleCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            📄
        </div>

        <div>
            <span>Results</span>
            <strong>@Model.ResultCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            📎
        </div>

        <div>
            <span>Attachments</span>
            <strong>@Model.AttachmentCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            ⚖️
        </div>

        <div>
            <span>Decisions</span>
            <strong>@Model.DecisionCount</strong>
        </div>
    </div>

</section>


<!-- Alerts -->
@if (Model.Alerts.Any())
{
    <section class="section-card alerts-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker section-kicker-danger">
                    نیازمند توجه
                </span>

                <h2>
                    هشدارهای مدیریتی
                </h2>
            </div>

            <span class="section-description">
                مواردی که نیاز به بررسی مدیر دارند
            </span>

        </div>


        <div class="alerts-list">

            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-item alert-@alert.Type">

                    <div class="alert-icon">

                        @if (alert.Type == "danger")
                        {
                            <span>⚠️</span>
                        }
                        else if (alert.Type == "warning")
                        {
                            <span>🟠</span>
                        }
                        else
                        {
                            <span>ℹ️</span>
                        }

                    </div>


                    <div class="alert-content">

                        <strong>
                            @alert.Title
                        </strong>

                        <span>
                            @alert.Description
                        </span>

                    </div>


                    <div class="alert-count">
                        @alert.Count
                    </div>

                </div>
            }

        </div>

    </section>
}


<!-- Charts -->
<section class="charts-grid">

    <div class="section-card chart-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker">
                    تحلیل فعالیت
                </span>

                <h2>
                    وضعیت Work Item ها
                </h2>

                <p>
                    وضعیت کلی فعالیت های کاری
                </p>
            </div>

        </div>

        <div class="chart-container">
            <canvas id="workItemChart"></canvas>
        </div>

    </div>


    <div class="section-card chart-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker">
                    وضعیت پروژه
                </span>

                <h2>
                    وضعیت پروژه ها
                </h2>

                <p>
                    پروژه های فعال و غیرفعال
                </p>
            </div>

        </div>

        <div class="chart-container">
            <canvas id="projectChart"></canvas>
        </div>

    </div>


    <div class="section-card chart-card chart-wide">

        <div class="section-title-row">

            <div>
                <span class="section-kicker">
                    توزیع فعالیت
                </span>

                <h2>
                    Work Item بر اساس مسئول
                </h2>

                <p>
                    توزیع فعالیت ها بین اعضای تیم
                </p>
            </div>

        </div>

        <div class="chart-container chart-large">
            <canvas id="workItemsByUserChart"></canvas>
        </div>

    </div>

</section>


<!-- Details -->
<section class="details-grid">

    <div class="section-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker">
                    فعالیت ها
                </span>

                <h2>
                    وضعیت Work Item
                </h2>

                <p>
                    آمار دقیق فعالیت های کاری
                </p>
            </div>

        </div>


        <div class="metric-list">

            <div class="metric-row">
                <span>
                    <i class="status-dot status-open"></i>
                    باز
                </span>

                <strong>
                    @Model.OpenWorkItemCount
                </strong>
            </div>


            <div class="metric-row">
                <span>
                    <i class="status-dot status-completed"></i>
                    تکمیل شده
                </span>

                <strong>
                    @Model.CompletedWorkItemCount
                </strong>
            </div>


            <div class="metric-row">
                <span>
                    <i class="status-dot status-overdue"></i>
                    سررسید گذشته
                </span>

                <strong>
                    @Model.OverdueWorkItemCount
                </strong>
            </div>


            <div class="metric-row">
                <span>
                    <i class="status-dot status-unassigned"></i>
                    بدون مسئول
                </span>

                <strong>
                    @Model.UnassignedWorkItemCount
                </strong>
            </div>

        </div>

    </div>


    <div class="section-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker">
                    تیم
                </span>

                <h2>
                    کاربران سامانه
                </h2>

                <p>
                    ترکیب کاربران بر اساس نقش
                </p>
            </div>

        </div>


        <div class="role-grid">

            <div class="role-item role-admin">
                <span>Admin</span>
                <strong>@Model.AdminCount</strong>
            </div>

            <div class="role-item role-researcher">
                <span>Researcher</span>
                <strong>@Model.ResearcherCount</strong>
            </div>

            <div class="role-item role-reviewer">
                <span>Reviewer</span>
                <strong>@Model.ReviewerCount</strong>
            </div>

            <div class="role-item role-active">
                <span>Active</span>
                <strong>@Model.ActiveUserCount</strong>
            </div>

        </div>

    </div>

</section>


<!-- Recent Activity -->
<section class="section-card activity-card">

    <div class="section-title-row">

        <div>
            <span class="section-kicker">
                آخرین رویدادها
            </span>

            <h2>
                فعالیت های اخیر
            </h2>

            <p>
                آخرین تصمیم های ثبت شده در سامانه
            </p>
        </div>

    </div>


    @if (Model.RecentActivities.Any())
    {
        <div class="activity-list">

            @foreach (var activity in Model.RecentActivities)
            {
                <div class="activity-item">

                    <div class="activity-icon">
                        📝
                    </div>

                    <div class="activity-content">

                        <strong>
                            @activity.Title
                        </strong>

                        <span>
                            @activity.Description
                        </span>

                    </div>

                    <time>
                        @(activity.CreatedAt.HasValue
                            ? activity.CreatedAt.Value
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm")
                            : "-")
                    </time>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="empty-icon">
                📭
            </div>

            <span>
                هنوز فعالیتی ثبت نشده است.
            </span>

        </div>
    }

</section>


</div>

<!-- Chart.js -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const workItemLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemStatusChart.Select(x => x.Label)));

    const workItemValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemStatusChart.Select(x => x.Value)));


    const projectLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ProjectStatusChart.Select(x => x.Label)));

    const projectValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ProjectStatusChart.Select(x => x.Value)));


    const userLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemsByUserChart.Select(x => x.Label)));

    const userValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemsByUserChart.Select(x => x.Value)));


    new Chart(
        document.getElementById("workItemChart"),
        {
            type: "doughnut",

            data:
            {
                labels: workItemLabels,

                datasets:
                [
                    {
                        data: workItemValues,
                        borderWidth: 0
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                cutout: "68%",

                plugins:
                {
                    legend:
                    {
                        position: "bottom",

                        labels:
                        {
                            padding: 18,
                            usePointStyle: true
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById("projectChart"),
        {
            type: "doughnut",

            data:
            {
                labels: projectLabels,

                datasets:
                [
                    {
                        data: projectValues,
                        borderWidth: 0
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                cutout: "68%",

                plugins:
                {
                    legend:
                    {
                        position: "bottom",

                        labels:
                        {
                            padding: 18,
                            usePointStyle: true
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById("workItemsByUserChart"),
        {
            type: "bar",

            data:
            {
                labels: userLabels,

                datasets:
                [
                    {
                        label: "Work Item",
                        data: userValues,
                        borderRadius: 7,
                        borderSkipped: false
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                indexAxis: "y",

                plugins:
                {
                    legend:
                    {
                        display: false
                    }
                },

                scales:
                {
                    x:
                    {
                        beginAtZero: true,

                        ticks:
                        {
                            precision: 0
                        },

                        grid:
                        {
                            color: "#eef2f7"
                        }
                    },

                    y:
                    {
                        grid:
                        {
                            display: false
                        }
                    }
                }
            }
        }
    );

</script>

<style>

    .admin-dashboard {
        min-height: calc(100vh - 60px);
        padding: 28px;
        background: #f6f8fb;
    }


    /* =========================
       Hero
       ========================= */

    .dashboard-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;

        padding: 28px 30px;
        margin-bottom: 22px;

        border-radius: 22px;

        background:
            linear-gradient(
                135deg,
                #0f172a 0%,
                #1e3a8a 55%,
                #2563eb 100%
            );

        box-shadow:
            0 15px 35px rgba(15, 23, 42, 0.14);

        color: white;
    }

    .hero-content {
        min-width: 0;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        margin-bottom: 10px;
        padding: 6px 11px;

        border-radius: 20px;

        background: rgba(255,255,255,.12);

        color: #dbeafe;

        font-size: 12px;
        font-weight: 700;
    }

    .dashboard-hero h1 {
        margin: 0;

        color: white;

        font-size: 30px;
        font-weight: 800;
    }

    .dashboard-hero p {
        margin: 8px 0 0;

        color: #cbd5e1;

        font-size: 13px;
        line-height: 1.8;
    }

    .hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 42px;

        padding: 0 16px;

        border-radius: 12px;

        text-decoration: none;

        font-size: 13px;
        font-weight: 700;

        transition:
            transform .18s ease,
            box-shadow .18s ease,
            background .18s ease;
    }

    .hero-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .hero-btn-primary {
        background: white;
        color: #1d4ed8;
        box-shadow: 0 8px 18px rgba(0,0,0,.12);
    }

    .hero-btn-primary:hover {
        color: #1d4ed8;
        box-shadow: 0 12px 24px rgba(0,0,0,.18);
    }

    .hero-btn-secondary {
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.08);
        color: white;
    }

    .hero-btn-secondary:hover {
        color: white;
        background: rgba(255,255,255,.15);
    }


    /* =========================
       KPI
       ========================= */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;

        margin-bottom: 24px;
    }

    .kpi-card {
        position: relative;
        overflow: hidden;

        min-height: 158px;

        padding: 20px;

        border: 1px solid #e5e7eb;
        border-radius: 18px;

        background: white;

        box-shadow:
            0 7px 24px rgba(15, 23, 42, .045);

        transition:
            transform .18s ease,
            box-shadow .18s ease;
    }

    .kpi-card::after {
        content: "";

        position: absolute;

        left: -30px;
        bottom: -45px;

        width: 120px;
        height: 120px;

        border-radius: 50%;

        opacity: .07;
    }

    .kpi-card:hover {
        transform: translateY(-3px);

        box-shadow:
            0 12px 30px rgba(15, 23, 42, .08);
    }

    .kpi-blue::after {
        background: #2563eb;
    }

    .kpi-green::after {
        background: #059669;
    }

    .kpi-orange::after {
        background: #d97706;
    }

    .kpi-purple::after {
        background: #7c3aed;
    }

    .kpi-top {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .kpi-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        font-size: 21px;
    }

    .kpi-blue .kpi-icon {
        background: #eff6ff;
    }

    .kpi-green .kpi-icon {
        background: #ecfdf5;
    }

    .kpi-orange .kpi-icon {
        background: #fffbeb;
    }

    .kpi-purple .kpi-icon {
        background: #f5f3ff;
    }

    .kpi-label {
        color: #64748b;

        font-size: 13px;
        font-weight: 700;
    }

    .kpi-value {
        margin-top: 13px;

        color: #0f172a;

        font-size: 31px;
        line-height: 1;

        font-weight: 800;
    }

    .kpi-footer {
        margin-top: 10px;

        color: #94a3b8;

        font-size: 11px;
    }

    .kpi-positive {
        color: #10b981;
        margin-left: 4px;
    }


    /* =========================
       Sections
       ========================= */

    .dashboard-section {
        margin-bottom: 24px;
    }

    .section-title-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 16px;
    }

    .section-kicker {
        display: block;

        margin-bottom: 4px;

        color: #2563eb;

        font-size: 11px;
        font-weight: 800;
    }

    .section-kicker-danger {
        color: #dc2626;
    }

    .section-title-row h2 {
        margin: 0;

        color: #0f172a;

        font-size: 18px;
        font-weight: 800;
    }

    .section-title-row p {
        margin: 5px 0 0;

        color: #94a3b8;

        font-size: 12px;
    }

    .section-description {
        color: #94a3b8;

        font-size: 11px;
    }


    /* =========================
       Quick Actions
