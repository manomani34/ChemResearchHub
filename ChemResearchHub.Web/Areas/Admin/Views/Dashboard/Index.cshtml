    <div class="section-title-row">

        <div>
            <span class="section-kicker">
                دسترسی سریع
            </span>

            <h2>
                کارهای مدیریتی
            </h2>
        </div>

        <span class="section-description">
            دسترسی مستقیم به بخش های پرکاربرد سامانه
        </span>

    </div>


    <div class="quick-actions-grid">

        <a asp-area=""
           asp-controller="Users"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                👥
            </div>

            <div class="quick-action-content">
                <h3>اعضای تیم</h3>
                <p>کاربران و نقش ها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area="Admin"
           asp-controller="Reports"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📊
            </div>

            <div class="quick-action-content">
                <h3>گزارش ها</h3>
                <p>گزارش های مدیریتی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Reviews"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🔍
            </div>

            <div class="quick-action-content">
                <h3>بازبینی ها</h3>
                <p>مدیریت Reviewها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Projects"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📁
            </div>

            <div class="quick-action-content">
                <h3>پروژه ها</h3>
                <p>مدیریت پروژه ها</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="WorkItems"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                📋
            </div>

            <div class="quick-action-content">
                <h3>Work Itemها</h3>
                <p>فعالیت های کاری</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Experiments"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🧪
            </div>

            <div class="quick-action-content">
                <h3>آزمایش ها</h3>
                <p>آزمایش های پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="Samples"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                🧫
            </div>

            <div class="quick-action-content">
                <h3>نمونه ها</h3>
                <p>نمونه های پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>


        <a asp-area=""
           asp-controller="DecisionLogs"
           asp-action="Index"
           class="quick-action-card">

            <div class="quick-action-icon">
                ⚖️
            </div>

            <div class="quick-action-content">
                <h3>تصمیمات</h3>
                <p>سوابق تصمیمات پژوهشی</p>
            </div>

            <span class="quick-action-arrow">
                ←
            </span>

        </a>

    </div>

</section>


<!-- Secondary Statistics -->
<section class="secondary-stats">

    <div class="secondary-stat">
        <div class="secondary-icon">
            🧫
        </div>

        <div>
            <span>Samples</span>
            <strong>@Model.SampleCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            📄
        </div>

        <div>
            <span>Results</span>
            <strong>@Model.ResultCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            📎
        </div>

        <div>
            <span>Attachments</span>
            <strong>@Model.AttachmentCount</strong>
        </div>
    </div>


    <div class="secondary-stat">
        <div class="secondary-icon">
            ⚖️
        </div>

        <div>
            <span>Decisions</span>
            <strong>@Model.DecisionCount</strong>
        </div>
    </div>

</section>


<!-- Alerts -->
@if (Model.Alerts.Any())
{
    <section class="section-card alerts-card">

        <div class="section-title-row">

            <div>
                <span class="section-kicker section-kicker-danger">
                    نیازمند توجه
                </span>

                <h2>
                    هشدارهای مدیریتی
                </h2>
            </div>

            <span class="section-description">
                مواردی که نیاز به بررسی مدیر دارند
            </span>

        </div>


        <div class="alerts-list">

            @foreach (var alert in Model.Alerts)
            {
                <div class="alert-item alert-@alert.Type">

                    <div class="alert-icon">

                        @if (alert.Type == "danger")
                        {
                            <span>⚠️</span>
                        }
                        else if (alert.Type == "warning")
                        {
                            <span>🟠</span>
                        }
                        else
                        {
                            <span>ℹ️</span>
                        }

                    </div>


                    <div class="alert-content">

                        <strong>
                            @alert.Title
                        </strong>

                        <span>
                            @alert.Description
                        </span>

                    </div>


                    <div class="alert-count">
                        @alert.Count
                    </div>

                </div>
            }

        </div>

    </section>
}



<!-- Project Schedule -->
<section class="section-card project-schedule-card">

    <div class="section-title-row">
        <div>
            <span class="section-kicker">زمان‌بندی پژوهشی</span>
            <h2>برنامه زمانی پروژه‌ها</h2>
            <p>نمای کلی تاریخ شروع و پایان پروژه‌ها</p>
        </div>
    </div>

    @if (Model.ProjectSchedule.Any())
    {
        <div class="project-schedule-list">
            @foreach (var project in Model.ProjectSchedule)
            {
                <div class="project-schedule-item">
                    <div class="project-schedule-name">
                        <strong>@project.ReferenceCode</strong>
                        <span>@project.ProjectName</span>
                    </div>
                    <div class="project-schedule-dates">
                        <span>شروع: @(project.StartDateJalali ?? "-")</span>
                        <span>پایان: @(project.EndDateJalali ?? "-")</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📅</div>
            <span>هنوز برای هیچ پروژه‌ای تاریخ شروع یا پایان ثبت نشده است.</span>
        </div>
    }

</section>


<!-- Persian Calendar -->
<section class="section-card persian-calendar-card">

    <div class="section-title-row">
        <div>
            <span class="section-kicker">تقویم پژوهشی</span>
            <h2>تقویم زمان‌بندی پروژه‌ها</h2>
            <p>نمایش پروژه‌ها بر اساس تاریخ شروع و پایان در تقویم شمسی</p>
        </div>
    </div>

    <div class="persian-calendar">

        <div class="calendar-header">
            <button type="button"
                    class="calendar-nav-button"
                    id="calendarPrev">
                →
            </button>

            <div class="calendar-current-month">
                <strong id="calendarMonthName"></strong>
                <span id="calendarYear"></span>
            </div>

            <button type="button"
                    class="calendar-nav-button"
                    id="calendarNext">
                ←
            </button>
        </div>

        <div class="calendar-weekdays">
            <div>شنبه</div>
            <div>یکشنبه</div>
            <div>دوشنبه</div>
            <div>سه‌شنبه</div>
            <div>چهارشنبه</div>
            <div>پنجشنبه</div>
            <div>جمعه</div>
        </div>

        <div class="calendar-grid" id="calendarGrid"></div>

        <div class="calendar-legend">
            <div class="calendar-legend-item">
                <span class="calendar-legend-dot calendar-project-start"></span>
                شروع پروژه
            </div>

            <div class="calendar-legend-item">
                <span class="calendar-legend-dot calendar-project-range"></span>
                در بازه پروژه
            </div>

            <div class="calendar-legend-item">
                <span class="calendar-legend-dot calendar-project-end"></span>
                پایان پروژه
            </div>
        </div>

    </div>

</section>


<script>
(function () {

    const calendarGrid =
        document.getElementById("calendarGrid");

    const calendarMonthName =
        document.getElementById("calendarMonthName");

    const calendarYear =
        document.getElementById("calendarYear");

    const calendarPrev =
        document.getElementById("calendarPrev");

    const calendarNext =
        document.getElementById("calendarNext");

    if (!calendarGrid ||
        !calendarMonthName ||
        !calendarYear) {
        return;
    }

    const projects = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ProjectSchedule.Select(x => new
            {
                projectId = x.ProjectId,
                referenceCode = x.ReferenceCode,
                projectName = x.ProjectName,
                startDate = x.StartDate,
                endDate = x.EndDate
            })));

    const monthNames = [
        "فروردین",
        "اردیبهشت",
        "خرداد",
        "تیر",
        "مرداد",
        "شهریور",
        "مهر",
        "آبان",
        "آذر",
        "دی",
        "بهمن",
        "اسفند"
    ];

    const persianFormatter =
        new Intl.DateTimeFormat(
            "en-US-u-ca-persian",
            {
                year: "numeric",
                month: "numeric",
                day: "numeric"
            });

    function getPersianParts(date) {

        const parts =
            persianFormatter.formatToParts(date);

        return {
            year: Number(
                parts.find(x => x.type === "year")?.value
            ),
            month: Number(
                parts.find(x => x.type === "month")?.value
            ),
            day: Number(
                parts.find(x => x.type === "day")?.value
            )
        };
    }

    function getPersianDate(
        year,
        month,
        day) {

        const approximate =
            new Date(
                Date.UTC(
                    year + 621,
                    month - 1,
                    day
                ));

        for (
            let offset = -370;
            offset <= 370;
            offset++
        ) {

            const date =
                new Date(approximate);

            date.setUTCDate(
                date.getUTCDate() + offset
            );

            const parts =
                getPersianParts(date);

            if (
                parts.year === year &&
                parts.month === month &&
                parts.day === day
            ) {
                return date;
            }
        }

        return null;
    }

    function daysInPersianMonth(
        year,
        month) {

        const start =
            getPersianDate(
                year,
                month,
                1
            );

        if (!start) {
            return 30;
        }

        const next =
            month === 12
                ? getPersianDate(
                    year + 1,
                    1,
                    1)
                : getPersianDate(
                    year,
                    month + 1,
                    1);

        if (!next) {
            return 30;
        }

        return Math.round(
            (next.getTime() -
             start.getTime()) /
            86400000
        );
    }

    function toDate(value) {

        if (!value) {
            return null;
        }

        const date =
            new Date(value);

        return Number.isNaN(
            date.getTime())
            ? null
            : date;
    }

    function dateOnly(date) {

        return new Date(
            date.getFullYear(),
            date.getMonth(),
            date.getDate()
        );
    }

    function isSameDay(a, b) {

        if (!a || !b) {
            return false;
        }

        const first =
            dateOnly(a).getTime();

        const second =
            dateOnly(b).getTime();

        return first === second;
    }

    function isBetween(
        date,
        start,
        end) {

        if (!start || !end) {
            return false;
        }

        const d =
            dateOnly(date).getTime();

        const s =
            dateOnly(start).getTime();

        const e =
            dateOnly(end).getTime();

        return d >= Math.min(s, e) &&
               d <= Math.max(s, e);
    }

    function projectState(
        date,
        project) {

        const start =
            toDate(project.startDate);

        const end =
            toDate(project.endDate);

        if (
            start &&
            isSameDay(date, start) &&
            end &&
            isSameDay(start, end)
        ) {
            return "start-end";
        }

        if (
            start &&
            isSameDay(date, start)
        ) {
            return "start";
        }

        if (
            end &&
            isSameDay(date, end)
        ) {
            return "end";
        }

        if (
            start &&
            end &&
            isBetween(date, start, end)
        ) {
            return "range";
        }

        return null;
    }

    function formatDate(date) {

        if (!date) {
            return "-";
        }

        const parts =
            getPersianParts(date);

        return `${parts.year}/${String(parts.month).padStart(2, "0")}/${String(parts.day).padStart(2, "0")}`;
    }

    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    /* =========================
       Global Tooltip
       ========================= */

    const tooltip =
        document.createElement("div");

    tooltip.className =
        "calendar-project-tooltip";

    tooltip.style.display = "none";

    document.body.appendChild(tooltip);


    function showTooltip(
        element,
        project) {

        const start =
            toDate(project.startDate);

        const end =
            toDate(project.endDate);

        tooltip.innerHTML = `
            <strong>
                ${escapeHtml(project.referenceCode)}
            </strong>

            <span>
                ${escapeHtml(project.projectName)}
            </span>

            ${
                start
                    ? `<small>شروع: ${formatDate(start)}</small>`
                    : ""
            }

            ${
                end
                    ? `<small>پایان: ${formatDate(end)}</small>`
                    : ""
            }
        `;

        tooltip.style.display = "flex";

        const rect =
            element.getBoundingClientRect();

        const tooltipWidth =
            tooltip.offsetWidth;

        const tooltipHeight =
            tooltip.offsetHeight;

        let left =
            rect.right - tooltipWidth;

        let top =
            rect.top -
            tooltipHeight -
            10;

        if (left < 10) {
            left = 10;
        }

        if (
            left + tooltipWidth >
            window.innerWidth - 10
        ) {
            left =
                window.innerWidth -
                tooltipWidth -
                10;
        }

        if (top < 10) {
            top =
                rect.bottom + 10;
        }

        tooltip.style.left =
            `${left}px`;

        tooltip.style.top =
            `${top}px`;
    }


    function hideTooltip() {

        tooltip.style.display =
            "none";
    }


    const today =
        new Date();

    const todayParts =
        getPersianParts(today);

    let currentYear =
        todayParts.year;

    let currentMonth =
        todayParts.month;


    function renderPersianCalendar() {

        hideTooltip();

        calendarGrid.innerHTML = "";

        calendarMonthName.textContent =
            monthNames[currentMonth - 1];

        calendarYear.textContent =
            String(currentYear);

        const firstDay =
            getPersianDate(
                currentYear,
                currentMonth,
                1
            );

        if (!firstDay) {
            return;
        }

        // JavaScript:
        // Sunday = 0 ... Saturday = 6
        //
        // Persian calendar:
        // Saturday = 0 ... Friday = 6

        const jsWeekday =
            firstDay.getDay();

        const leadingEmptyDays =
            (jsWeekday + 1) % 7;

        const days =
            daysInPersianMonth(
                currentYear,
                currentMonth
            );


        for (
            let i = 0;
            i < leadingEmptyDays;
            i++
        ) {

            const empty =
                document.createElement("div");

            empty.className =
                "calendar-cell calendar-cell-empty";

            calendarGrid.appendChild(empty);
        }


        for (
            let day = 1;
            day <= days;
            day++
        ) {

            const date =
                getPersianDate(
                    currentYear,
                    currentMonth,
                    day
                );

            if (!date) {
                continue;
            }

            const cell =
                document.createElement("div");

            cell.className =
                "calendar-cell";


            if (
                isSameDay(
                    date,
                    today)
            ) {
                cell.classList.add(
                    "calendar-today"
                );
            }


            const number =
                document.createElement("div");

            number.className =
                "calendar-day-number";

            number.textContent =
                String(day);

            cell.appendChild(number);


            projects.forEach(project => {

                const state =
                    projectState(
                        date,
                        project
                    );

                if (!state) {
                    return;
                }


                const item =
                    document.createElement("a");

                item.className =
                    "calendar-project calendar-project-" +
                    state;

                item.href =
                    `/Projects/Details/${project.projectId}`;

                item.title =
                    `${project.referenceCode} — ${project.projectName}`;

                item.innerHTML = `
                    <span class="calendar-project-name">
                        ${escapeHtml(project.projectName)}
                    </span>
                `;


                item.addEventListener(
                    "mouseenter",
                    function () {
                        showTooltip(
                            item,
                            project
                        );
                    });


                item.addEventListener(
                    "mouseleave",
                    hideTooltip);


                item.addEventListener(
                    "focus",
                    function () {
                        showTooltip(
                            item,
                            project
                        );
                    });


                item.addEventListener(
                    "blur",
                    hideTooltip);


                cell.appendChild(item);
            });


            calendarGrid.appendChild(cell);
        }
    }


    calendarPrev?.addEventListener(
        "click",
        function () {

            currentMonth--;

            if (currentMonth < 1) {
                currentMonth = 12;
                currentYear--;
            }

            renderPersianCalendar();
        });


    calendarNext?.addEventListener(
        "click",
        function () {

            currentMonth++;

            if (currentMonth > 12) {
                currentMonth = 1;
                currentYear++;
            }

            renderPersianCalendar();
        });


    window.addEventListener(
        "scroll",
        hideTooltip,
        true);


    window.addEventListener(
        "resize",
        hideTooltip);


    renderPersianCalendar();

})();
</script>

<!-- Charts -->
<section class="charts-grid">

