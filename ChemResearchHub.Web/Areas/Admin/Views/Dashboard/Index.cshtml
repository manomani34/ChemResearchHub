@model ChemResearchHub.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
Layout = "~/Views/Shared/_Layout.cshtml";
ViewData["Title"] = "داشبورد مدیریت";
}

<div class="admin-dashboard" dir="rtl">


<!-- Header -->
<section class="dashboard-hero">

    <div class="hero-content">

        <div class="hero-badge">
            <span>👑</span>
            پنل مدیریت
        </div>

        <h1>
            داشبورد مدیریتی
        </h1>

        <p>
            نمای کلی از وضعیت پروژه ها، فعالیت های پژوهشی، کاربران و داده های سامانه
        </p>

    </div>

    <div class="hero-actions">
    <a href="/Admin/Reports"
   class="admin-dashboard-nav-btn admin-dashboard-nav-primary">
    <span>📈</span>
    <span>گزارش‌های مدیریتی</span>
</a>
</div>

</section>


<!-- Main KPI -->
<section class="kpi-grid">

    <div class="kpi-card kpi-blue">

        <div class="kpi-top">
            <div class="kpi-icon">
                📁
            </div>

            <span class="kpi-label">
                پروژه ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.ProjectCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveProjectCount پروژه فعال
        </div>

    </div>


    <div class="kpi-card kpi-green">

        <div class="kpi-top">
            <div class="kpi-icon">
                📋
            </div>

            <span class="kpi-label">
                Work Item ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.WorkItemCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.OpenWorkItemCount مورد باز
        </div>

    </div>


    <div class="kpi-card kpi-orange">

        <div class="kpi-top">
            <div class="kpi-icon">
                👥
            </div>

            <span class="kpi-label">
                کاربران
            </span>
        </div>

        <div class="kpi-value">
            @Model.UserCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveUserCount کاربر فعال
        </div>

    </div>


    <div class="kpi-card kpi-purple">

        <div class="kpi-top">
            <div class="kpi-icon">
                🧪
            </div>

            <span class="kpi-label">
                آزمایش ها
            </span>
        </div>

        <div class="kpi-value">
            @Model.ExperimentCount
        </div>

        <div class="kpi-footer">
            <span class="kpi-positive">●</span>
            @Model.ActiveExperimentCount آزمایش فعال
        </div>

    </div>

</section>


<!-- Quick Actions -->
