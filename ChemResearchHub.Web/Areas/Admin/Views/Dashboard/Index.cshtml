
@model ChemResearchHub.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "داشبورد مدیریت";
}

<div class="admin-dashboard-page" dir="rtl">

    <section class="dashboard-hero">
        <div class="hero-content">
            <div class="hero-badge">
                <span>👑</span>
                پنل مدیریت
            </div>

            <h1>داشبورد مدیریتی</h1>
            <p>نمای کلی از وضعیت پروژه‌ها، فعالیت‌های پژوهشی، کاربران و داده‌های سامانه</p>
        </div>

        <div class="hero-actions">
            <a href="/Admin/Reports"
               class="admin-dashboard-nav-btn admin-dashboard-nav-primary">
                <span>📈</span>
                <span>گزارش‌های مدیریتی</span>
            </a>
        </div>
    </section>

    <section class="kpi-grid">

        <div class="kpi-card kpi-blue">
            <div class="kpi-top">
                <div class="kpi-icon">📁</div>
                <span class="kpi-label">پروژه‌ها</span>
            </div>
            <div class="kpi-value">@Model.ProjectCount</div>
            <div class="kpi-footer">
                <span class="kpi-positive">●</span>
                @Model.ActiveProjectCount پروژه فعال
            </div>
        </div>

        <div class="kpi-card kpi-green">
            <div class="kpi-top">
                <div class="kpi-icon">📋</div>
                <span class="kpi-label">Work Itemها</span>
            </div>
            <div class="kpi-value">@Model.WorkItemCount</div>
            <div class="kpi-footer">
                <span class="kpi-positive">●</span>
                @Model.OpenWorkItemCount مورد باز
            </div>
        </div>

        <div class="kpi-card kpi-orange">
            <div class="kpi-top">
                <div class="kpi-icon">👥</div>
                <span class="kpi-label">کاربران</span>
            </div>
            <div class="kpi-value">@Model.UserCount</div>
            <div class="kpi-footer">
                <span class="kpi-positive">●</span>
                @Model.ActiveUserCount کاربر فعال
            </div>
        </div>

        <div class="kpi-card kpi-purple">
            <div class="kpi-top">
                <div class="kpi-icon">🧪</div>
                <span class="kpi-label">آزمایش‌ها</span>
            </div>
            <div class="kpi-value">@Model.ExperimentCount</div>
            <div class="kpi-footer">
                <span class="kpi-positive">●</span>
                @Model.ActiveExperimentCount آزمایش فعال
            </div>
        </div>

    </section>

    <section class="dashboard-section">
        <div class="section-title-row">
            <div>
                <span class="section-kicker">دسترسی سریع</span>
                <h2>کارهای مدیریتی</h2>
            </div>
            <span class="section-description">
                دسترسی مستقیم به بخش‌های پرکاربرد سامانه
            </span>
        </div>

        <div class="quick-actions-grid">

            <a asp-area=""
               asp-controller="Users"
               asp-action="Index"
               class="quick-action-card">
                <div class="quick-action-icon">👥</div>
                <div class="quick-action-content">
                    <h3>اعضای تیم</h3>
                    <p>کاربران و نقش‌ها</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Reports"
               asp-action="Index"
               class="quick-action-card">
                <div class="quick-action-icon">📊</div>
                <div class="quick-action-content">
                    <h3>گزارش‌ها</h3>
                    <p>گزارش‌های مدیریتی</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area=""
               asp-controller="Reviews"
               asp-action="Index"
               class="quick-action-card">
                <div class="quick-action-icon">🔍</div>
                <div class="quick-action-content">
                    <h3>بازبینی‌ها</h3>
                    <p>مدیریت Reviewها</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Research"
               asp-controller="Projects"
               asp-action="Index"
               class="quick-action-card">
                <div class="quick-action-icon">📁</div>
                <div class="quick-action-content">
                    <h3>پروژه‌ها</h3>
                    <p>مدیریت پروژه‌ها</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Research"
               asp-controller="WorkItems"
               asp-action="Index"
               class="quick-action-card">
                <div class="quick-action-icon">📋</div>
                <div class="quick-action-content">
                    <h3>Work Itemها</h3>
                    <p>فعالیت‌های کاری</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Research"
               asp-controller="Experiments"
               asp-action="List"
               class="quick-action-card">
                <div class="quick-action-icon">🧪</div>
                <div class="quick-action-content">
                    <h3>آزمایش‌ها</h3>
                    <p>آزمایش‌های پژوهشی</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Research"
               asp-controller="Samples"
               asp-action="List"
               class="quick-action-card">
                <div class="quick-action-icon">🧫</div>
                <div class="quick-action-content">
                    <h3>نمونه‌ها</h3>
                    <p>نمونه‌های پژوهشی</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

            <a asp-area="Research"
               asp-controller="DecisionLogs"
               asp-action="List"
               class="quick-action-card">
                <div class="quick-action-icon">⚖️</div>
                <div class="quick-action-content">
                    <h3>تصمیمات</h3>
                    <p>سوابق تصمیمات پژوهشی</p>
                </div>
                <span class="quick-action-arrow">←</span>
            </a>

        </div>
    </section>

    <section class="secondary-stats">

        <div class="secondary-stat">
            <div class="secondary-icon">🧫</div>
            <div>
                <span>Samples</span>
                <strong>@Model.SampleCount</strong>
            </div>
        </div>

        <div class="secondary-stat">
            <div class="secondary-icon">📄</div>
            <div>
                <span>Results</span>
                <strong>@Model.ResultCount</strong>
            </div>
        </div>

        <div class="secondary-stat">
            <div class="secondary-icon">📎</div>
            <div>
                <span>Attachments</span>
                <strong>@Model.AttachmentCount</strong>
            </div>
        </div>

        <div class="secondary-stat">
            <div class="secondary-icon">⚖️</div>
            <div>
                <span>Decisions</span>
                <strong>@Model.DecisionCount</strong>
            </div>
        </div>

    </section>

    @if (Model.Alerts.Any())
    {
        <section class="section-card alerts-card">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker section-kicker-danger">نیازمند توجه</span>
                    <h2>هشدارهای مدیریتی</h2>
                </div>
                <span class="section-description">
                    مواردی که نیاز به بررسی مدیر دارند
                </span>
            </div>

            <div class="alerts-list">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="alert-item alert-@alert.Type">
                        <div class="alert-icon">
                            @if (alert.Type == "danger")
                            {
                                <span>⚠️</span>
                            }
                            else if (alert.Type == "warning")
                            {
                                <span>🟠</span>
                            }
                            else
                            {
                                <span>ℹ️</span>
                            }
                        </div>

                        <div class="alert-content">
                            <strong>@alert.Title</strong>
                            <span>@alert.Description</span>
                        </div>

                        <div class="alert-count">@alert.Count</div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section-card project-schedule-card">
        <div class="section-title-row">
            <div>
                <span class="section-kicker">زمان‌بندی پژوهشی</span>
                <h2>برنامه زمانی پروژه‌ها</h2>
                <p>نمای کلی تاریخ شروع و پایان پروژه‌ها</p>
            </div>
        </div>

        @if (Model.ProjectSchedule.Any())
        {
            <div class="project-schedule-list">
                @foreach (var project in Model.ProjectSchedule)
                {
                    <div class="project-schedule-item">
                        <div class="project-schedule-name">
                            <strong>@project.ReferenceCode</strong>
                            <span>@project.ProjectName</span>
                        </div>

                        <div class="project-schedule-dates">
                            <span>شروع: @(project.StartDateJalali ?? "-")</span>
                            <span>پایان: @(project.EndDateJalali ?? "-")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📅</div>
                <span>هنوز برای هیچ پروژه‌ای تاریخ شروع یا پایان ثبت نشده است.</span>
            </div>
        }
    </section>

    <section class="section-card persian-calendar-card">
        <div class="section-title-row">
            <div>
                <span class="section-kicker">تقویم پژوهشی</span>
                <h2>تقویم زمان‌بندی پروژه‌ها</h2>
                <p>نمایش پروژه‌ها بر اساس تاریخ شروع و پایان در تقویم شمسی</p>
            </div>
        </div>

        <div class="persian-calendar">

            <div class="calendar-header">
                <button type="button"
                        class="calendar-nav-button"
                        id="calendarPrev"
                        aria-label="ماه قبل">
                    →
                </button>

                <div class="calendar-current-month">
                    <strong id="calendarMonthName"></strong>
                    <span id="calendarYear"></span>
                </div>

                <button type="button"
                        class="calendar-nav-button"
                        id="calendarNext"
                        aria-label="ماه بعد">
                    ←
                </button>
            </div>

            <div class="calendar-weekdays">
                <div>شنبه</div>
                <div>یکشنبه</div>
                <div>دوشنبه</div>
                <div>سه‌شنبه</div>
                <div>چهارشنبه</div>
                <div>پنجشنبه</div>
                <div>جمعه</div>
            </div>

            <div class="calendar-grid" id="calendarGrid"></div>

            <div class="calendar-legend">
                <div class="calendar-legend-item">
                    <span class="calendar-legend-dot calendar-project-start"></span>
                    شروع پروژه
                </div>
                <div class="calendar-legend-item">
                    <span class="calendar-legend-dot calendar-project-range"></span>
                    در بازه پروژه
                </div>
                <div class="calendar-legend-item">
                    <span class="calendar-legend-dot calendar-project-end"></span>
                    پایان پروژه
                </div>
            </div>

        </div>
    </section>

    <section class="charts-grid">

        <div class="section-card chart-card">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker">تحلیل فعالیت</span>
                    <h2>وضعیت Work Itemها</h2>
                    <p>وضعیت کلی فعالیت‌های کاری</p>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="workItemChart"></canvas>
            </div>
        </div>

        <div class="section-card chart-card">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker">وضعیت پروژه</span>
                    <h2>وضعیت پروژه‌ها</h2>
                    <p>پروژه‌های فعال و غیرفعال</p>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="projectChart"></canvas>
            </div>
        </div>

        <div class="section-card chart-card chart-wide">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker">توزیع فعالیت</span>
                    <h2>Work Item بر اساس مسئول</h2>
                    <p>توزیع فعالیت‌ها بین اعضای تیم</p>
                </div>
            </div>
            <div class="chart-container chart-large">
                <canvas id="workItemsByUserChart"></canvas>
            </div>
        </div>

    </section>

    <section class="details-grid">

        <div class="section-card">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker">فعالیت‌ها</span>
                    <h2>وضعیت Work Item</h2>
                    <p>آمار دقیق فعالیت‌های کاری</p>
                </div>
            </div>

            <div class="metric-list">
                <div class="metric-row">
                    <span><i class="status-dot status-open"></i>باز</span>
                    <strong>@Model.OpenWorkItemCount</strong>
                </div>

                <div class="metric-row">
                    <span><i class="status-dot status-completed"></i>تکمیل شده</span>
                    <strong>@Model.CompletedWorkItemCount</strong>
                </div>

                <div class="metric-row">
                    <span><i class="status-dot status-overdue"></i>سررسید گذشته</span>
                    <strong>@Model.OverdueWorkItemCount</strong>
                </div>

                <div class="metric-row">
                    <span><i class="status-dot status-unassigned"></i>بدون مسئول</span>
                    <strong>@Model.UnassignedWorkItemCount</strong>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-title-row">
                <div>
                    <span class="section-kicker">تیم</span>
                    <h2>کاربران سامانه</h2>
                    <p>ترکیب کاربران بر اساس نقش</p>
                </div>
            </div>

            <div class="role-grid">
                <div class="role-item role-admin">
                    <span>Admin</span>
                    <strong>@Model.AdminCount</strong>
                </div>

                <div class="role-item role-researcher">
                    <span>Researcher</span>
                    <strong>@Model.ResearcherCount</strong>
                </div>

                <div class="role-item role-reviewer">
                    <span>Reviewer</span>
                    <strong>@Model.ReviewerCount</strong>
                </div>

                <div class="role-item role-active">
                    <span>Active</span>
                    <strong>@Model.ActiveUserCount</strong>
                </div>
            </div>
        </div>

    </section>

    <section class="section-card activity-card">
        <div class="section-title-row">
            <div>
                <span class="section-kicker">آخرین رویدادها</span>
                <h2>فعالیت‌های اخیر</h2>
                <p>آخرین تصمیم‌های ثبت شده در سامانه</p>
            </div>
        </div>

        @if (Model.RecentActivities.Any())
        {
            <div class="activity-list">
                @foreach (var activity in Model.RecentActivities)
                {
                    <div class="activity-item">
                        <div class="activity-icon">📝</div>

                        <div class="activity-content">
                            <strong>@activity.Title</strong>
                            <span>@activity.Description</span>
                        </div>

                        <time>
                            @(activity.CreatedAt.HasValue
                                ? activity.CreatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                : "-")
                        </time>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <span>هنوز فعالیتی ثبت نشده است.</span>
            </div>
        }
    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (function () {
            const calendarGrid = document.getElementById("calendarGrid");
            const calendarMonthName = document.getElementById("calendarMonthName");
            const calendarYear = document.getElementById("calendarYear");
            const calendarPrev = document.getElementById("calendarPrev");
            const calendarNext = document.getElementById("calendarNext");

            if (!calendarGrid || !calendarMonthName || !calendarYear) {
                return;
            }

            const projects = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ProjectSchedule.Select(x => new
                    {
                        projectId = x.ProjectId,
                        referenceCode = x.ReferenceCode,
                        projectName = x.ProjectName,
                        startDate = x.StartDate,
                        endDate = x.EndDate
                    })));

            const monthNames = [
                "فروردین", "اردیبهشت", "خرداد", "تیر",
                "مرداد", "شهریور", "مهر", "آبان",
                "آذر", "دی", "بهمن", "اسفند"
            ];

            const persianFormatter = new Intl.DateTimeFormat(
                "en-US-u-ca-persian",
                {
                    year: "numeric",
                    month: "numeric",
                    day: "numeric"
                });

            function getPersianParts(date) {
                const parts = persianFormatter.formatToParts(date);

                return {
                    year: Number(parts.find(x => x.type === "year")?.value),
                    month: Number(parts.find(x => x.type === "month")?.value),
                    day: Number(parts.find(x => x.type === "day")?.value)
                };
            }

            function getPersianDate(year, month, day) {
                const approximate = new Date(Date.UTC(year + 621, month - 1, day));

                for (let offset = -370; offset <= 370; offset++) {
                    const date = new Date(approximate);
                    date.setUTCDate(date.getUTCDate() + offset);

                    const parts = getPersianParts(date);

                    if (parts.year === year &&
                        parts.month === month &&
                        parts.day === day) {
                        return date;
                    }
                }

                return null;
            }

            function daysInPersianMonth(year, month) {
                const start = getPersianDate(year, month, 1);

                if (!start) {
                    return 30;
                }

                const next = month === 12
                    ? getPersianDate(year + 1, 1, 1)
                    : getPersianDate(year, month + 1, 1);

                if (!next) {
                    return 30;
                }

                return Math.round(
                    (next.getTime() - start.getTime()) / 86400000
                );
            }

            function toDate(value) {
                if (!value) {
                    return null;
                }

                const date = new Date(value);

                return Number.isNaN(date.getTime()) ? null : date;
            }

            function dateOnly(date) {
                return new Date(
                    date.getFullYear(),
                    date.getMonth(),
                    date.getDate()
                );
            }

            function isSameDay(a, b) {
                if (!a || !b) {
                    return false;
                }

                return dateOnly(a).getTime() === dateOnly(b).getTime();
            }

            function isBetween(date, start, end) {
                if (!start || !end) {
                    return false;
                }

                const d = dateOnly(date).getTime();
                const s = dateOnly(start).getTime();
                const e = dateOnly(end).getTime();

                return d >= Math.min(s, e) && d <= Math.max(s, e);
            }

            function projectState(date, project) {
                const start = toDate(project.startDate);
                const end = toDate(project.endDate);

                if (start && isSameDay(date, start) &&
                    end && isSameDay(start, end)) {
                    return "start-end";
                }

                if (start && isSameDay(date, start)) {
                    return "start";
                }

                if (end && isSameDay(date, end)) {
                    return "end";
                }

                if (start && end && isBetween(date, start, end)) {
                    return "range";
                }

                return null;
            }

            function formatDate(date) {
                if (!date) {
                    return "-";
                }

                const parts = getPersianParts(date);

                return `${parts.year}/${String(parts.month).padStart(2, "0")}/${String(parts.day).padStart(2, "0")}`;
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            const tooltip = document.createElement("div");
            tooltip.className = "calendar-project-tooltip";
            tooltip.style.display = "none";
            document.body.appendChild(tooltip);

            function showTooltip(element, project) {
                const start = toDate(project.startDate);
                const end = toDate(project.endDate);

                tooltip.innerHTML = `
                    <strong>${escapeHtml(project.referenceCode)}</strong>
                    <span>${escapeHtml(project.projectName)}</span>
                    ${start ? `<small>شروع: ${formatDate(start)}</small>` : ""}
                    ${end ? `<small>پایان: ${formatDate(end)}</small>` : ""}
                `;

                tooltip.style.display = "flex";

                const rect = element.getBoundingClientRect();
                const tooltipWidth = tooltip.offsetWidth;
                const tooltipHeight = tooltip.offsetHeight;

                let left = rect.right - tooltipWidth;
                let top = rect.top - tooltipHeight - 10;

                if (left < 10) {
                    left = 10;
                }

                if (left + tooltipWidth > window.innerWidth - 10) {
                    left = window.innerWidth - tooltipWidth - 10;
                }

                if (top < 10) {
                    top = rect.bottom + 10;
                }

                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${top}px`;
            }

            function hideTooltip() {
                tooltip.style.display = "none";
            }

            const today = new Date();
            const todayParts = getPersianParts(today);

            let currentYear = todayParts.year;
            let currentMonth = todayParts.month;

            function renderPersianCalendar() {
                hideTooltip();
                calendarGrid.innerHTML = "";

                calendarMonthName.textContent = monthNames[currentMonth - 1];
                calendarYear.textContent = String(currentYear);

                const firstDay = getPersianDate(currentYear, currentMonth, 1);

                if (!firstDay) {
                    return;
                }

                const jsWeekday = firstDay.getDay();
                const leadingEmptyDays = (jsWeekday + 1) % 7;
                const days = daysInPersianMonth(currentYear, currentMonth);

                for (let i = 0; i < leadingEmptyDays; i++) {
                    const empty = document.createElement("div");
                    empty.className = "calendar-cell calendar-cell-empty";
                    calendarGrid.appendChild(empty);
                }

                for (let day = 1; day <= days; day++) {
                    const date = getPersianDate(currentYear, currentMonth, day);

                    if (!date) {
                        continue;
                    }

                    const cell = document.createElement("div");
                    cell.className = "calendar-cell";

                    if (isSameDay(date, today)) {
                        cell.classList.add("calendar-today");
                    }

                    const number = document.createElement("div");
                    number.className = "calendar-day-number";
                    number.textContent = String(day);
                    cell.appendChild(number);

                    projects.forEach(project => {
                        const state = projectState(date, project);

                        if (!state) {
                            return;
                        }

                        const item = document.createElement("a");
                        item.className = "calendar-project calendar-project-" + state;
                        item.href = `/Projects/Details/${project.projectId}`;
                        item.title = `${project.referenceCode} — ${project.projectName}`;

                        item.innerHTML = `
                            <span class="calendar-project-name">
                                ${escapeHtml(project.projectName)}
                            </span>
                        `;

                        item.addEventListener("mouseenter", function () {
                            showTooltip(item, project);
                        });

                        item.addEventListener("mouseleave", hideTooltip);

                        item.addEventListener("focus", function () {
                            showTooltip(item, project);
                        });

                        item.addEventListener("blur", hideTooltip);

                        cell.appendChild(item);
                    });

                    calendarGrid.appendChild(cell);
                }
            }

            calendarPrev?.addEventListener("click", function () {
                currentMonth--;

                if (currentMonth < 1) {
                    currentMonth = 12;
                    currentYear--;
                }

                renderPersianCalendar();
            });

            calendarNext?.addEventListener("click", function () {
                currentMonth++;

                if (currentMonth > 12) {
                    currentMonth = 1;
                    currentYear++;
                }

                renderPersianCalendar();
            });

            window.addEventListener("scroll", hideTooltip, true);
            window.addEventListener("resize", hideTooltip);

            renderPersianCalendar();
        })();

        (function () {
            const workItemLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.WorkItemStatusChart.Select(x => x.Label)));

            const workItemValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.WorkItemStatusChart.Select(x => x.Value)));

            const projectLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ProjectStatusChart.Select(x => x.Label)));

            const projectValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.ProjectStatusChart.Select(x => x.Value)));

            const userLabels = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.WorkItemsByUserChart.Select(x => x.Label)));

            const userValues = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.WorkItemsByUserChart.Select(x => x.Value)));

            const workItemCanvas = document.getElementById("workItemChart");
            const projectCanvas = document.getElementById("projectChart");
            const userCanvas = document.getElementById("workItemsByUserChart");

            if (typeof Chart === "undefined") {
                return;
            }

            if (workItemCanvas) {
                new Chart(workItemCanvas, {
                    type: "doughnut",
                    data: {
                        labels: workItemLabels,
                        datasets: [{
                            data: workItemValues,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "68%",
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: {
                                    padding: 18,
                                    usePointStyle: true
                                }
                            }
                        }
                    }
                });
            }

            if (projectCanvas) {
                new Chart(projectCanvas, {
                    type: "doughnut",
                    data: {
                        labels: projectLabels,
                        datasets: [{
                            data: projectValues,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "68%",
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: {
                                    padding: 18,
                                    usePointStyle: true
                                }
                            }
                        }
                    }
                });
            }

            if (userCanvas) {
                new Chart(userCanvas, {
                    type: "bar",
                    data: {
                        labels: userLabels,
                        datasets: [{
                            label: "Work Item",
                            data: userValues,
                            borderRadius: 7,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: "y",
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                },
                                grid: {
                                    color: "#eef2f7"
                                }
                            },
                            y: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
