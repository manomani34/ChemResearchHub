<!-- Chart.js -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const workItemLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemStatusChart.Select(x => x.Label)));

    const workItemValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemStatusChart.Select(x => x.Value)));


    const projectLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ProjectStatusChart.Select(x => x.Label)));

    const projectValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ProjectStatusChart.Select(x => x.Value)));


    const userLabels = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemsByUserChart.Select(x => x.Label)));

    const userValues = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.WorkItemsByUserChart.Select(x => x.Value)));


    new Chart(
        document.getElementById("workItemChart"),
        {
            type: "doughnut",

            data:
            {
                labels: workItemLabels,

                datasets:
                [
                    {
                        data: workItemValues,
                        borderWidth: 0
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                cutout: "68%",

                plugins:
                {
                    legend:
                    {
                        position: "bottom",

                        labels:
                        {
                            padding: 18,
                            usePointStyle: true
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById("projectChart"),
        {
            type: "doughnut",

            data:
            {
                labels: projectLabels,

                datasets:
                [
                    {
                        data: projectValues,
                        borderWidth: 0
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                cutout: "68%",

                plugins:
                {
                    legend:
                    {
                        position: "bottom",

                        labels:
                        {
                            padding: 18,
                            usePointStyle: true
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById("workItemsByUserChart"),
        {
            type: "bar",

            data:
            {
                labels: userLabels,

                datasets:
                [
                    {
                        label: "Work Item",
                        data: userValues,
                        borderRadius: 7,
                        borderSkipped: false
                    }
                ]
            },

            options:
            {
                responsive: true,
                maintainAspectRatio: false,

                indexAxis: "y",

                plugins:
                {
                    legend:
                    {
                        display: false
                    }
                },

                scales:
                {
                    x:
                    {
                        beginAtZero: true,

                        ticks:
                        {
                            precision: 0
                        },

                        grid:
                        {
                            color: "#eef2f7"
                        }
                    },

                    y:
                    {
                        grid:
                        {
                            display: false
                        }
                    }
                }
            }
        }
    );

</script>

