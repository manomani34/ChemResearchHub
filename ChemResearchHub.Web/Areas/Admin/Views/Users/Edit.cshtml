@model ChemResearchHub.Web.Models.Users.EditUserViewModel

@{
    ViewData["Title"] = "Edit Team Member";

    var roles = ViewBag.Roles as IReadOnlyList<string>
        ?? Array.Empty<string>();

    var selectedRoles = Model.RoleNames ?? new List<string>();
}

<div class="team-user-form-page">
    <div class="team-user-form-header">
        <div>
            <div class="team-user-form-eyebrow">Team Management</div>
            <h1 class="team-user-form-title">Edit Team Member</h1>
            <p class="team-user-form-subtitle">
                Update researcher information, roles and account status.
            </p>
        </div>

        <div class="team-user-form-header-icon">
            <i class="bi bi-person-gear"></i>
        </div>
    </div>

    <div class="team-user-form-layout">
        <main class="team-user-form-main">
            <div class="team-user-form-card">
                <div class="team-user-form-card-header">
                    <div class="team-user-form-card-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div>
                        <h2>Account Information</h2>
                        <p>Update the team member's account details.</p>
                    </div>
                </div>

                <div class="team-user-form-card-body">
                    <form asp-action="Edit" method="post">

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger team-user-validation-summary">
                        </div>

                        <section class="team-user-form-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">01</span>
                                <div>
                                    <h3>Personal Information</h3>
                                    <p>Basic identity and contact details.</p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="FullName" class="form-label">
                                </label>

                                <div class="team-user-input-wrapper">
                                    <i class="bi bi-person"></i>
                                    <input asp-for="FullName"
                                           class="form-control team-user-input" />
                                </div>

                                <span asp-validation-for="FullName"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                </label>

                                <div class="team-user-input-wrapper">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control team-user-input" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>
                        </section>

                        <section class="team-user-form-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">02</span>
                                <div>
                                    <h3>Role Assignment</h3>
                                    <p>Configure the member's access permissions.</p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RoleNames" class="form-label">
                                    Roles
                                </label>

                                <select asp-for="RoleNames"
                                        class="form-select team-user-role-select"
                                        multiple
                                        size="5">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role"
                                                selected="@selectedRoles.Contains(
                                                                                                role,
                                                                                                StringComparer.OrdinalIgnoreCase)">
                                            @role
                                        </option>
                                    }
                                </select>

                                <div class="team-user-form-hint">
                                    <i class="bi bi-info-circle"></i>
                                    Select one or more roles. On Windows, hold Ctrl
                                    while clicking to select multiple roles.
                                </div>

                                <span asp-validation-for="RoleNames"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>
                        </section>

                        <section class="team-user-form-section team-user-last-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">03</span>
                                <div>
                                    <h3>Account Status</h3>
                                    <p>Manage the availability of this account.</p>
                                </div>
                            </div>

                            <div class="team-user-status-card">
                                <div class="team-user-status-info">
                                    <div class="team-user-status-icon">
                                        <i class="bi bi-toggle-on"></i>
                                    </div>

                                    <div>
                                        <strong>Active Account</strong>
                                        <p>
                                            Allow this user account to remain active.
                                        </p>
                                    </div>
                                </div>

                                <div class="form-check form-switch team-user-status-switch">
                                    <input asp-for="IsActive"
                                           class="form-check-input" />

                                    <label asp-for="IsActive"
                                           class="form-check-label">
                                        Active
                                    </label>
                                </div>
                            </div>
                        </section>

                        <div class="team-user-form-actions">
                            <button type="submit"
                                    class="btn btn-primary team-user-submit">
                                <i class="bi bi-check2-circle me-2"></i>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               asp-area="Admin"
                               asp-controller="Users"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </main>

        <aside class="team-user-form-sidebar">
            <div class="team-user-info-card">
                <div class="team-user-info-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <h3>Account Administration</h3>

                <p>
                    Keep team member information and access assignments
                    up to date.
                </p>

                <div class="team-user-info-divider"></div>

                <div class="team-user-info-point">
                    <i class="bi bi-person-check"></i>
                    <span>Update identity and contact information.</span>
                </div>

                <div class="team-user-info-point">
                    <i class="bi bi-shield-check"></i>
                    <span>Manage assigned roles.</span>
                </div>

                <div class="team-user-info-point">
                    <i class="bi bi-toggle-on"></i>
                    <span>Control account activation status.</span>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/team-user-form.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
