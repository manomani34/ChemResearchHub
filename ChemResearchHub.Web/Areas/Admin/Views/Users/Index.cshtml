@model IReadOnlyList<ChemResearchHub.Application.Users.Dtos.UserDto>

@{
    ViewData["Title"] = "Team Members";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/team-members-index.css"
          asp-append-version="true" />
}

<div class="team-members-page" dir="ltr">

    <div class="team-members-header">
        <div class="team-members-heading">
            <div class="team-members-eyebrow">
                <span class="team-members-eyebrow-icon">
                    <i class="bi bi-people"></i>
                </span>
                Team Management
            </div>

            <h1>Team Members</h1>

            <p>
                Researchers and team members of ChemResearchHub.
            </p>
        </div>

        <a asp-action="Create" class="btn team-members-add-button">
            <i class="bi bi-person-plus"></i>
            <span>Add User</span>
        </a>
    </div>

    <div class="team-members-summary">
        <div class="team-members-summary-icon">
            <i class="bi bi-people-fill"></i>
        </div>

        <div class="team-members-summary-content">
            <span class="team-members-summary-label">Total Members</span>
            <strong>@Model.Count</strong>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="team-members-empty-card">
            <div class="team-members-empty-icon">
                <i class="bi bi-person-exclamation"></i>
            </div>

            <h5>No users</h5>

            <p>
                There are currently no team members.
            </p>

            <a asp-action="Create" class="btn team-members-empty-button">
                <i class="bi bi-person-plus"></i>
                Add First User
            </a>
        </div>
    }
    else
    {
        <div class="team-members-list-card">

            <div class="team-members-list-header">
                <div>
                    <h2>Team Directory</h2>
                    <p>Manage researchers and their access roles.</p>
                </div>

                <span class="team-members-count">
                    @Model.Count members
                </span>
            </div>

            <div class="table-responsive">
                <table class="table team-members-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="team-members-identity">
                                        <div class="team-members-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(user.FullName)
                                                ? "-"
                                                : user.FullName)
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="team-members-email">
                                        @user.Email
                                    </span>
                                </td>

                                <td>
                                    <div class="team-members-roles">
                                        @if (user.RoleNames != null && user.RoleNames.Count > 0)
                                        {
                                            foreach (var role in user.RoleNames)
                                            {
                                                var badgeClass = role.Equals(
                                                    "Admin",
                                                    StringComparison.OrdinalIgnoreCase)
                                                    ? "team-role-admin"
                                                    : role.Equals(
                                                        "Reviewer",
                                                        StringComparison.OrdinalIgnoreCase)
                                                        ? "team-role-reviewer"
                                                        : role.Equals(
                                                            "Researcher",
                                                            StringComparison.OrdinalIgnoreCase)
                                                            ? "team-role-researcher"
                                                            : "team-role-default";

                                                <span class="team-role-badge @badgeClass">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="team-members-no-role">
                                                No role assigned
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="team-status-badge team-status-active">
                                            <span class="team-status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="team-status-badge team-status-inactive">
                                            <span class="team-status-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn team-members-edit-button">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>Edit</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

</div>
