@model ChemResearchHub.Web.Models.Users.CreateUserViewModel

@{
    ViewData["Title"] = "Add Team Member";

    var roles = ViewBag.Roles as IReadOnlyList<string>
        ?? Array.Empty<string>();

    var selectedRoles = Model.RoleNames ?? new List<string>();
}

<div class="team-user-form-page">
    <div class="team-user-form-header">
        <div>
            <div class="team-user-form-eyebrow">Team Management</div>
            <h1 class="team-user-form-title">Add Team Member</h1>
            <p class="team-user-form-subtitle">
                Create a new team member account and assign one or more roles.
            </p>
        </div>

        <div class="team-user-form-header-icon">
            <i class="bi bi-person-plus"></i>
        </div>
    </div>

    <div class="team-user-form-layout">
        <main class="team-user-form-main">
            <div class="team-user-form-card">
                <div class="team-user-form-card-header">
                    <div class="team-user-form-card-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div>
                        <h2>Account Information</h2>
                        <p>Enter the new team member's account details.</p>
                    </div>
                </div>

                <div class="team-user-form-card-body">
                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger team-user-validation-summary">
                        </div>

                        <section class="team-user-form-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">01</span>
                                <div>
                                    <h3>Personal Information</h3>
                                    <p>Basic identity and contact details.</p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="FullName" class="form-label">
                                </label>

                                <div class="team-user-input-wrapper">
                                    <i class="bi bi-person"></i>
                                    <input asp-for="FullName"
                                           class="form-control team-user-input"
                                           placeholder="For example: Dr. Ahmad Rezaei" />
                                </div>

                                <span asp-validation-for="FullName"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                </label>

                                <div class="team-user-input-wrapper">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control team-user-input"
                                           autocomplete="email"
                                           placeholder="researcher@example.com" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>
                        </section>

                        <section class="team-user-form-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">02</span>
                                <div>
                                    <h3>Security Credentials</h3>
                                    <p>Set the initial account password.</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label">
                                    </label>

                                    <div class="team-user-input-wrapper">
                                        <i class="bi bi-lock"></i>
                                        <input asp-for="Password"
                                               type="password"
                                               class="form-control team-user-input"
                                               autocomplete="new-password" />
                                    </div>

                                    <span asp-validation-for="Password"
                                          class="text-danger team-user-field-error">
                                    </span>

                                    <div class="team-user-form-hint">
                                        <i class="bi bi-info-circle"></i>
                                        Follow the password requirements configured
                                        for ChemResearchHub.
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword"
                                           class="form-label">
                                    </label>

                                    <div class="team-user-input-wrapper">
                                        <i class="bi bi-shield-lock"></i>
                                        <input asp-for="ConfirmPassword"
                                               type="password"
                                               class="form-control team-user-input"
                                               autocomplete="new-password" />
                                    </div>

                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger team-user-field-error">
                                    </span>
                                </div>
                            </div>
                        </section>

                        <section class="team-user-form-section team-user-last-section">
                            <div class="team-user-section-heading">
                                <span class="team-user-section-number">03</span>
                                <div>
                                    <h3>Role Assignment</h3>
                                    <p>Define the access levels for this member.</p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RoleNames" class="form-label">
                                    Roles
                                </label>

                                <select asp-for="RoleNames"
                                        class="form-select team-user-role-select"
                                        multiple
                                        size="5">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role"
                                                selected="@selectedRoles.Contains(
                                                                                                role,
                                                                                                StringComparer.OrdinalIgnoreCase)">
                                            @role
                                        </option>
                                    }
                                </select>

                                <div class="team-user-form-hint">
                                    <i class="bi bi-info-circle"></i>
                                    Select one or more roles. On Windows, hold Ctrl
                                    while clicking to select multiple roles.
                                </div>

                                <span asp-validation-for="RoleNames"
                                      class="text-danger team-user-field-error">
                                </span>
                            </div>
                        </section>

                        <div class="team-user-form-actions">
                            <button type="submit"
                                    class="btn btn-primary team-user-submit">
                                <i class="bi bi-person-plus me-2"></i>
                                Create User
                            </button>

                            <a asp-action="Index"
                               asp-area="Admin"
                               asp-controller="Users"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </main>

        <aside class="team-user-form-sidebar">
            <div class="team-user-info-card">
                <div class="team-user-info-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>Team Members</h3>

                <p>
                    Add researchers, reviewers and other team members
                    to your ChemResearchHub workspace.
                </p>

                <div class="team-user-info-divider"></div>

                <div class="team-user-info-point">
                    <i class="bi bi-person-check"></i>
                    <span>Maintain individual user accounts.</span>
                </div>

                <div class="team-user-info-point">
                    <i class="bi bi-shield-check"></i>
                    <span>Assign one or more access roles.</span>
                </div>

                <div class="team-user-info-point">
                    <i class="bi bi-lock"></i>
                    <span>Configure account credentials.</span>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/team-user-form.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
