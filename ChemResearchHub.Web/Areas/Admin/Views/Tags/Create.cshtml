@model ChemResearchHub.Web.Areas.Admin.Models.Tags.TagFormViewModel

@{
    ViewData["Title"] = "Create Tag";
}

<div class="container py-4">
    <div class="mb-4">
        <div class="text-muted mb-1">Work Item Management</div>
        <h1 class="h3">Create Tag</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. High Priority" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Color" class="form-label"></label>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="color" id="colorPicker" value="@Model.Color"
                               class="form-control form-control-color" />
                        <input asp-for="Color" id="colorHex" class="form-control" />
                    </div>
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const picker = document.getElementById('colorPicker');
        const hex = document.getElementById('colorHex');
        picker.addEventListener('input', () => hex.value = picker.value.toUpperCase());
        hex.addEventListener('input', () => {
            if (/^#[0-9A-Fa-f]{6}$/.test(hex.value)) picker.value = hex.value;
        });
    </script>
}
