@model ChemResearchHub.Web.Areas.Admin.Models.ReportsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "گزارش‌های مدیریتی";
}

<div class="admin-reports-page" dir="rtl">

    <section class="reports-hero">
        <div class="reports-hero-content">
            <div class="reports-hero-badge">
                <i class="bi bi-bar-chart-line"></i>
                گزارش مدیریتی
            </div>

            <h1>گزارش‌ها و تحلیل‌های سامانه</h1>

            <p>
                بررسی وضعیت پروژه‌ها، فعالیت‌ها، کاربران و داده‌های پژوهشی
            </p>
        </div>

        <div class="reports-header-actions">

            <a href="/Admin/Dashboard"
               class="reports-action-btn reports-action-primary">
                <i class="bi bi-speedometer2"></i>
                <span>داشبورد مدیریت</span>
            </a>

            <button type="button"
                    class="reports-action-btn reports-action-secondary"
                    onclick="window.print()">
                <i class="bi bi-printer"></i>
                <span>چاپ گزارش</span>
            </button>

            <a href="@Url.Action(
                               "ExportExcel",
                               "Reports",
                               new
                               {
                                   area = "Admin",
                                   ReportType = Model.ReportType,
                                   ProjectId = Model.ProjectId,
                                   UserId = Model.UserId,
                                   Status = Model.Status,
                                   FromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                                   ToDate = Model.ToDate?.ToString("yyyy-MM-dd")
                               })"
               class="reports-action-btn reports-action-excel">
                <i class="bi bi-file-earmark-excel"></i>
                <span>خروجی Excel</span>
            </a>

        </div>
    </section>

    <!-- Filters -->
    <section class="reports-section-card reports-filters-card">

        <div class="reports-section-heading">
            <div class="reports-heading-icon">
                <i class="bi bi-funnel"></i>
            </div>

            <div>
                <span class="reports-section-kicker">فیلتر گزارش</span>
                <h2>پارامترهای گزارش</h2>
                <p>
                    اطلاعات مورد نظر خود را برای مشاهده گزارش انتخاب کنید
                </p>
            </div>
        </div>

        <form asp-area="Admin"
              asp-controller="Reports"
              asp-action="Index"
              method="get"
              class="reports-filters-form">

            <div class="reports-filters-grid">

                <div class="reports-filter-field">
                    <label for="ReportType">نوع گزارش</label>

                    <select id="ReportType"
                            name="ReportType"
                            class="form-select">

                        <option value="overview"
                                selected="@(Model.ReportType == "overview")">
                            نمای کلی
                        </option>

                        <option value="projects"
                                selected="@(Model.ReportType == "projects")">
                            پروژه‌ها
                        </option>

                        <option value="workitems"
                                selected="@(Model.ReportType == "workitems")">
                            Work Item ها
                        </option>

                        <option value="users"
                                selected="@(Model.ReportType == "users")">
                            عملکرد کاربران
                        </option>

                        <option value="experiments"
                                selected="@(Model.ReportType == "experiments")">
                            آزمایش‌ها
                        </option>

                        <option value="samples"
                                selected="@(Model.ReportType == "samples")">
                            نمونه‌ها
                        </option>

                        <option value="results"
                                selected="@(Model.ReportType == "results")">
                            نتایج
                        </option>

                        <option value="attachments"
                                selected="@(Model.ReportType == "attachments")">
                            فایل‌ها
                        </option>

                        <option value="decisions"
                                selected="@(Model.ReportType == "decisions")">
                            تصمیم‌ها
                        </option>

                    </select>
                </div>

                <div class="reports-filter-field">
                    <label for="ProjectId">پروژه</label>

                    <select id="ProjectId"
                            name="ProjectId"
                            class="form-select">

                        <option value=""
                                selected="@(!Model.ProjectId.HasValue)">
                            همه پروژه‌ها
                        </option>

                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Id"
                                    selected="@(Model.ProjectId == project.Id)">
                                @project.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="reports-filter-field">
                    <label for="UserId">مسئول</label>

                    <select id="UserId"
                            name="UserId"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(Model.UserId))">
                            همه کاربران
                        </option>

                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id"
                                    selected="@(Model.UserId == user.Id)">
                                @user.FullName
                            </option>
                        }

                    </select>
                </div>

                <div class="reports-filter-field">
                    <label for="Status">وضعیت</label>

                    <select id="Status"
                            name="Status"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(Model.Status))">
                            همه وضعیت‌ها
                        </option>

                        <option value="open"
                                selected="@(Model.Status == "open")">
                            باز
                        </option>

                        <option value="completed"
                                selected="@(Model.Status == "completed")">
                            تکمیل شده
                        </option>

                        <option value="overdue"
                                selected="@(Model.Status == "overdue")">
                            سررسید گذشته
                        </option>

                    </select>
                </div>

                <div class="reports-filter-field">
                    <label for="FromDate">از تاریخ</label>

                    <input id="FromDate"
                           name="FromDate"
                           type="date"
                           class="form-control"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="reports-filter-field">
                    <label for="ToDate">تا تاریخ</label>

                    <input id="ToDate"
                           name="ToDate"
                           type="date"
                           class="form-control"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

            </div>

            <div class="reports-filter-actions">

                <button type="submit"
                        class="reports-filter-btn reports-filter-submit">
                    <i class="bi bi-search"></i>
                    اعمال فیلتر
                </button>

                <a href="/Admin/Reports"
                   class="reports-filter-btn reports-filter-reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    پاک کردن
                </a>

            </div>

        </form>
    </section>

    <!-- Summary -->
    <section class="reports-summary-grid">

        <div class="reports-summary-card reports-summary-blue">
            <div class="reports-summary-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div class="reports-summary-content">
                <span>پروژه‌ها</span>
                <strong>@Model.Summary.TotalProjects</strong>
                <small>
                    @Model.Summary.ActiveProjects فعال
                </small>
            </div>
        </div>

        <div class="reports-summary-card reports-summary-green">
            <div class="reports-summary-icon">
                <i class="bi bi-kanban"></i>
            </div>

            <div class="reports-summary-content">
                <span>Work Itemها</span>
                <strong>@Model.Summary.TotalWorkItems</strong>
                <small>
                    @Model.Summary.OpenWorkItems باز
                </small>
            </div>
        </div>

        <div class="reports-summary-card reports-summary-orange">
            <div class="reports-summary-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div class="reports-summary-content">
                <span>سررسید گذشته</span>
                <strong>@Model.Summary.OverdueWorkItems</strong>
                <small>نیازمند پیگیری</small>
            </div>
        </div>

        <div class="reports-summary-card reports-summary-purple">
            <div class="reports-summary-icon">
                <i class="bi bi-eyedropper"></i>
            </div>

            <div class="reports-summary-content">
                <span>آزمایش‌ها</span>
                <strong>@Model.Summary.TotalExperiments</strong>
                <small>
                    @Model.Summary.ActiveExperiments فعال
                </small>
            </div>
        </div>

        <div class="reports-summary-card reports-summary-cyan">
            <div class="reports-summary-icon">
                <i class="bi bi-moisture"></i>
            </div>

            <div class="reports-summary-content">
                <span>نمونه‌ها</span>
                <strong>@Model.Summary.TotalSamples</strong>
                <small>ثبت شده</small>
            </div>
        </div>

        <div class="reports-summary-card reports-summary-gray">
            <div class="reports-summary-icon">
                <i class="bi bi-file-earmark-bar-graph"></i>
            </div>

            <div class="reports-summary-content">
                <span>نتایج</span>
                <strong>@Model.Summary.TotalResults</strong>
                <small>ثبت شده</small>
            </div>
        </div>

    </section>

    <!-- Report Content -->
    <section class="reports-section-card reports-output-card">

        <div class="reports-section-heading reports-output-heading">
            <div class="reports-heading-icon">
                <i class="bi bi-clipboard-data"></i>
            </div>

            <div class="reports-output-title">
                <span class="reports-section-kicker">خروجی گزارش</span>

                <h2>@GetReportTitle(Model.ReportType)</h2>

                <p>اطلاعات استخراج شده از داده‌های سامانه</p>
            </div>

            <div class="reports-record-count">
                <i class="bi bi-list-ol"></i>
                @Model.Rows.Count رکورد
            </div>
        </div>

        @if (Model.ReportType == "overview")
        {
            <div class="reports-overview-grid">

                <div class="reports-overview-item">
                    <span>پروژه‌های فعال</span>
                    <strong>@Model.Summary.ActiveProjects</strong>
                </div>

                <div class="reports-overview-item">
                    <span>Work Itemهای باز</span>
                    <strong>@Model.Summary.OpenWorkItems</strong>
                </div>

                <div class="reports-overview-item">
                    <span>Work Itemهای تکمیل شده</span>
                    <strong>@Model.Summary.CompletedWorkItems</strong>
                </div>

                <div class="reports-overview-item">
                    <span>Work Itemهای overdue</span>
                    <strong>@Model.Summary.OverdueWorkItems</strong>
                </div>

                <div class="reports-overview-item">
                    <span>آزمایش‌های فعال</span>
                    <strong>@Model.Summary.ActiveExperiments</strong>
                </div>

                <div class="reports-overview-item">
                    <span>پیوست‌ها</span>
                    <strong>@Model.Summary.TotalAttachments</strong>
                </div>

                <div class="reports-overview-item">
                    <span>تصمیمات</span>
                    <strong>@Model.Summary.TotalDecisions</strong>
                </div>

                <div class="reports-overview-item">
                    <span>نمونه‌ها</span>
                    <strong>@Model.Summary.TotalSamples</strong>
                </div>

            </div>
        }
        else if (Model.Rows.Any())
        {
            <div class="reports-table-wrapper">

                <table class="reports-table">

                    <thead>
                        <tr>
                            <th>دسته</th>
                            <th>عنوان</th>
                            <th>وضعیت</th>
                            <th>کل</th>
                            <th>باز</th>
                            <th>تکمیل شده</th>
                            <th>Overdue</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <span class="reports-category-badge">
                                        @row.Category
                                    </span>
                                </td>

                                <td class="reports-name-cell">
                                    @row.Name
                                </td>

                                <td>
                                    <span class="reports-status-badge">
                                        @row.Status
                                    </span>
                                </td>

                                <td>@row.Total</td>
                                <td>@row.Open</td>
                                <td>@row.Completed</td>
                                <td>@row.Overdue</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="reports-empty-state">
                <div class="reports-empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <strong>داده‌ای برای نمایش وجود ندارد</strong>

                <span>
                    فیلترهای انتخاب شده نتیجه‌ای برنگرداندند.
                </span>
            </div>
        }

    </section>

</div>

@functions {

    private static string GetReportTitle(string? reportType)
    {
        return reportType?.ToLowerInvariant() switch
        {
            "projects" => "گزارش پروژه‌ها",
            "workitems" => "گزارش Work Itemها",
            "users" => "گزارش عملکرد کاربران",
            "experiments" => "گزارش آزمایش‌ها",
            "samples" => "گزارش نمونه‌ها",
            "results" => "گزارش نتایج",
            "attachments" => "گزارش پیوست‌ها",
            "decisions" => "گزارش تصمیمات",
            _ => "نمای کلی سامانه"
        };
    }

}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-reports.css"
          asp-append-version="true" />
}
