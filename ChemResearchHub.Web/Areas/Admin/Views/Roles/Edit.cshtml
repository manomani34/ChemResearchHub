@model ChemResearchHub.Web.Areas.Admin.Models.Roles.EditRoleViewModel

@{
    ViewData["Title"] = "Edit Role";
}

<div class="role-form-page">
    <div class="role-form-header">
        <div>
            <div class="role-form-eyebrow">Access Management</div>
            <h1 class="role-form-title">Edit Role</h1>
            <p class="role-form-subtitle">
                Update the name of this access role.
            </p>
        </div>

        <div class="role-form-header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
    </div>

    <div class="role-form-layout">
        <div class="role-form-main">
            <div class="role-form-card">
                <div class="role-form-card-header">
                    <div class="role-form-card-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h2>Role Information</h2>
                        <p>Modify the role details below.</p>
                    </div>
                </div>

                <div class="role-form-card-body">
                    <form asp-action="Edit" method="post">
                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger role-form-validation-summary">
                        </div>

                        <div class="mb-4">
                            <label asp-for="RoleName" class="form-label">
                                Role Name
                            </label>

                            <input asp-for="RoleName"
                                   class="form-control role-form-input" />

                            <span asp-validation-for="RoleName"
                                  class="text-danger role-form-field-error">
                            </span>

                            <div class="role-form-hint">
                                <i class="bi bi-info-circle"></i>
                                Choose a descriptive name for this role.
                            </div>
                        </div>

                        <div class="role-form-actions">
                            <button type="submit" class="btn btn-primary role-form-submit">
                                <i class="bi bi-check2-circle me-2"></i>
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <aside class="role-form-sidebar">
            <div class="role-form-info-card">
                <div class="role-form-info-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3>Role Management</h3>
                <p>
                    Roles help organize access across the application.
                    After updating a role, its assigned permissions remain
                    managed separately.
                </p>
            </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/role-form.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
