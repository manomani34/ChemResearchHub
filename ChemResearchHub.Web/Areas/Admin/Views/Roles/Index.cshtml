@model IReadOnlyList<ChemResearchHub.Web.Areas.Admin.Controllers.RoleListItemViewModel>

@{
    ViewData["Title"] = "Role Management";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/role-management-index.css"
          asp-append-version="true" />
}

<div class="role-management-page" dir="ltr">

    <div class="role-management-header">
        <div class="role-management-heading">
            <div class="role-management-eyebrow">
                <span class="role-management-eyebrow-icon">
                    <i class="bi bi-shield-lock"></i>
                </span>
                Access Management
            </div>

            <h1>Roles</h1>

            <p>
                Manage system roles and their assignments.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Roles"
           asp-action="Create"
           class="btn role-management-create-button">
            <i class="bi bi-plus-lg"></i>
            <span>Create Role</span>
        </a>
    </div>

    <div class="role-management-summary">

        <div class="role-management-summary-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div class="role-management-summary-content">
            <span>Total Roles</span>
            <strong>@Model.Count</strong>
        </div>

        <div class="role-management-summary-divider"></div>

        <div class="role-management-summary-detail">
            <span>System & Custom Access Roles</span>
            <small>Role configuration and permission management</small>
        </div>

    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert role-management-alert role-management-alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMessage</span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert role-management-alert role-management-alert-error alert-dismissible fade show"
             role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@errorMessage</span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="role-management-card">

        <div class="role-management-card-header">
            <div>
                <h2>Role Directory</h2>
                <p>Review roles, assigned users and available actions.</p>
            </div>

            <span class="role-management-count">
                @Model.Count roles
            </span>
        </div>

        <div class="table-responsive">
            <table class="table role-management-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Users</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="role-management-empty">
                                    <div class="role-management-empty-icon">
                                        <i class="bi bi-shield-x"></i>
                                    </div>

                                    <h5>No roles found</h5>

                                    <p>
                                        There are currently no roles configured in the system.
                                    </p>

                                    <a asp-area="Admin"
                                       asp-controller="Roles"
                                       asp-action="Create"
                                       class="btn role-management-empty-button">
                                        <i class="bi bi-plus-lg"></i>
                                        Create First Role
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>
                                    <div class="role-management-identity">
                                        <div class="role-management-role-icon">
                                            <i class="bi bi-shield"></i>
                                        </div>

                                        <div class="role-management-role-info">
                                            <strong>@role.Name</strong>

                                            @if (role.IsSystemRole)
                                            {
                                                <span class="role-management-protected-label">
                                                    <i class="bi bi-lock-fill"></i>
                                                    Protected role
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="role-management-user-count">
                                        <i class="bi bi-people"></i>
                                        @role.UserCount
                                    </span>
                                </td>

                                <td>
                                    @if (role.IsSystemRole)
                                    {
                                        <span class="role-management-type role-management-type-system">
                                            <span class="role-management-type-dot"></span>
                                            System
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="role-management-type role-management-type-custom">
                                            <span class="role-management-type-dot"></span>
                                            Custom
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="role-management-actions">

                                        <a asp-action="Permissions"
                                           asp-route-id="@role.Id"
                                           class="btn role-management-action role-management-permissions-action">
                                            <i class="bi bi-key"></i>
                                            <span>Manage Permissions</span>
                                        </a>

                                        @if (!role.IsSystemRole)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@role.Id"
                                               class="btn role-management-action role-management-edit-action">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Edit</span>
                                            </a>

                                            @if (role.UserCount == 0)
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@role.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this role?');">

                                                    <button type="submit"
                                                            class="btn role-management-action role-management-delete-action">
                                                        <i class="bi bi-trash3"></i>
                                                        <span>Delete</span>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn role-management-action role-management-delete-action role-management-delete-disabled"
                                                        disabled
                                                        title="This role has assigned users.">
                                                    <i class="bi bi-trash3"></i>
                                                    <span>Delete</span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="role-management-protected-action">
                                                <i class="bi bi-lock-fill"></i>
                                                Protected
                                            </span>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>
