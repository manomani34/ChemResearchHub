@model ChemResearchHub.Web.Areas.Admin.Models.Roles.ManageRolePermissionsViewModel

@{
    ViewData["Title"] = "Manage Role Permissions";
}

<div class="role-permissions-page">
    <div class="role-permissions-header">
        <div>
            <div class="role-permissions-eyebrow">Access Management</div>
            <h1 class="role-permissions-title">Manage Role Permissions</h1>
            <p class="role-permissions-subtitle">
                Configure access rights for
                <span class="role-name-highlight">@Model.RoleName</span>
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Roles"
           asp-action="Index"
           class="btn btn-outline-secondary role-permissions-back">
            <i class="bi bi-arrow-left"></i>
            Back to Roles
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show role-permissions-alert">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show role-permissions-alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-area="Admin"
          asp-controller="Roles"
          asp-action="Permissions"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="RoleId" />

        <div class="role-permissions-intro">
            <div class="role-permissions-intro-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div>
                <h2>Permission Groups</h2>
                <p>
                    Select the permissions that should be available to this role.
                </p>
            </div>
        </div>

        <div class="role-permission-groups">
            @foreach (var group in Model.Groups)
            {
                <section class="role-permission-group">
                    <div class="role-permission-group-header">
                        <div class="role-permission-group-icon">
                            <i class="bi bi-grid"></i>
                        </div>
                        <div>
                            <h3>@group.Name</h3>
                            <span>Permissions in this category</span>
                        </div>
                    </div>

                    <div class="role-permission-group-body">
                        <div class="row g-3">
                            @foreach (var permission in group.Permissions)
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="role-permission-item">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedPermissions"
                                                   value="@permission.Name"
                                                   id="permission_@permission.Name"
                                                   checked="@permission.IsSelected" />

                                            <label class="form-check-label"
                                                   for="permission_@permission.Name">
                                                <strong>@permission.DisplayName</strong>
                                            </label>
                                        </div>

                                        <p class="role-permission-description">
                                            @permission.Description
                                        </p>

                                        <div class="role-permission-code">
                                            <i class="bi bi-code-slash"></i>
                                            @permission.Name
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>

        <div class="role-permissions-footer">
            <a asp-area="Admin"
               asp-controller="Roles"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary role-permissions-save">
                <i class="bi bi-check2-circle me-2"></i>
                Save Permissions
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/role-permissions.css"
          asp-append-version="true" />
}
