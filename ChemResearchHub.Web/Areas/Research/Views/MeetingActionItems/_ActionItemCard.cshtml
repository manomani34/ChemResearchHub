@using ChemResearchHub.Application.Meetings.DTOs
@using Microsoft.AspNetCore.Mvc.Rendering
@model MeetingActionItemDto

@{
    var workItems =
        ViewData["WorkItems"] as List<SelectListItem>
        ?? new List<SelectListItem>();

    var meetingSessionId =
        ViewData["MeetingSessionId"];
}

<article class="crm-action-card">

    <div class="crm-action-card__header">

        <h3>@Model.Title</h3>

        <span class="crm-action-type">
            @Model.Type
        </span>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="crm-action-card__description">
            @Model.Description
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.AcceptanceCriteria))
    {
        <div class="crm-action-acceptance">
            <strong>Acceptance Criteria</strong>
            <p>@Model.AcceptanceCriteria</p>
        </div>
    }

    <div class="crm-action-card__meta">

        @if (!string.IsNullOrWhiteSpace(Model.AssignedToUserId))
        {
            <span>
                <i class="bi bi-person"></i>
                @Model.AssignedToUserId
            </span>
        }
        else
        {
            <span class="crm-action-unassigned">
                <i class="bi bi-person-x"></i>
                Unassigned
            </span>
        }

        @if (Model.DueDate.HasValue)
        {
            <span>
                <i class="bi bi-calendar-event"></i>
                @Model.DueDate.Value.ToLocalTime().ToString("yyyy/MM/dd")
            </span>
        }

        @if (Model.ProjectId.HasValue)
        {
            <span>
                <i class="bi bi-folder2"></i>
                Project #@Model.ProjectId
            </span>
        }

        @if (Model.MeetingDecisionId.HasValue)
        {
            <span>
                <i class="bi bi-journal-check"></i>
                Decision #@Model.MeetingDecisionId
            </span>
        }

        @if (Model.WorkItemId.HasValue)
        {
            <span class="crm-action-workitem">
                <i class="bi bi-kanban"></i>
                Work Item #@Model.WorkItemId
            </span>
        }
        else
        {
            <span class="text-muted">
                <i class="bi bi-link-45deg"></i>
                بدون اتصال به Work Item
            </span>
        }

    </div>

    @if (Model.CompletedAt.HasValue)
    {
        <div class="crm-action-completed">
            <i class="bi bi-check-circle"></i>
            Completed at:
            @Model.CompletedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
        </div>
    }

    @if (Model.Type != ChemResearchHub.Domain.Enums.Meetings.MeetingActionItemType.ConvertedWorkItem)
    {
        <div class="crm-action-link-editor mt-3">

            <form asp-area="Research"
                  asp-controller="MeetingActionItems"
                  asp-action="Link"
                  asp-route-meetingSessionId="@meetingSessionId"
                  asp-route-actionItemId="@Model.Id"
                  method="post"
                  class="d-flex flex-wrap gap-2">

                @Html.AntiForgeryToken()

                <select name="workItemId"
                        class="form-select"
                        style="max-width: 350px">

                    <option value="0">انتخاب Work Item</option>

                    @foreach (var workItem in workItems)
                    {
                        if (workItem.Value == Model.WorkItemId?.ToString())
                        {
                            <option value="@workItem.Value" selected>
                                @workItem.Text
                            </option>
                        }
                        else
                        {
                            <option value="@workItem.Value">
                                @workItem.Text
                            </option>
                        }
                    }

                </select>

                <button type="submit"
                        class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-link-45deg"></i>
                    ذخیره ارتباط
                </button>

            </form>

            @if (Model.WorkItemId.HasValue)
            {
                <form asp-area="Research"
                      asp-controller="MeetingActionItems"
                      asp-action="Unlink"
                      asp-route-meetingSessionId="@meetingSessionId"
                      asp-route-actionItemId="@Model.Id"
                      method="post"
                      class="mt-2"
                      onsubmit="return confirm('آیا از قطع ارتباط این Action Item مطمئن هستید؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-link-break"></i>
                        قطع اتصال
                    </button>

                </form>
            }

        </div>
    }

</article>