@model ChemResearchHub.Web.Models.DecisionLogs.CreateDecisionLogViewModel

@{
    ViewData["Title"] = "Add Decision Log";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/decision-log-create.css"
          asp-append-version="true" />
}

<div class="decision-log-page">

    <div class="decision-log-header">

        <div class="decision-log-heading">

            <div class="decision-log-eyebrow">
                <span class="decision-log-eyebrow-icon">
                    <i class="bi bi-kanban"></i>
                </span>
                Research Work Item
            </div>

            <h1>
                Add Decision Log
            </h1>

            <p>
                Record a research or workflow decision and its supporting rationale.
            </p>

        </div>

    </div>

    <div class="decision-log-content">

        <div class="decision-log-card">

            <div class="decision-log-card-header">

                <div class="decision-log-card-icon">
                    <i class="bi bi-journal-check"></i>
                </div>

                <div>
                    <h2>Decision Information</h2>
                    <p>Document the decision and its supporting information.</p>
                </div>

            </div>

            <div class="decision-log-card-body">

                <form asp-action="Create" method="post">

                    <input asp-for="WorkItemId" type="hidden" />
                    <input asp-for="ProjectId" type="hidden" />
                    <input asp-for="BoardId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="decision-log-form-section">

                        <div class="decision-log-section-heading">
                            <span class="decision-log-section-number">01</span>
                            <span>Decision Classification</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="DecisionType"
                                   class="form-label">
                            </label>

                            <select asp-for="DecisionType"
                                    class="form-select">

                                <option value="Scientific">Scientific</option>
                                <option value="Validation">Validation</option>
                                <option value="Review">Review</option>
                                <option value="Approval">Approval</option>
                                <option value="Rejection">Rejection</option>
                                <option value="Other">Other</option>

                            </select>

                            <span asp-validation-for="DecisionType"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="decision-log-form-section">

                        <div class="decision-log-section-heading">
                            <span class="decision-log-section-number">02</span>
                            <span>Decision Statement</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Decision"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Decision"
                                      class="form-control"
                                      rows="5"
                                      placeholder="What decision was made?">
                            </textarea>

                            <span asp-validation-for="Decision"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="decision-log-form-section">

                        <div class="decision-log-section-heading">
                            <span class="decision-log-section-number">03</span>
                            <span>Rationale</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Rationale"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Rationale"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Why was this decision made?">
                            </textarea>

                            <span asp-validation-for="Rationale"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="decision-log-form-section">

                        <div class="decision-log-section-heading">
                            <span class="decision-log-section-number">04</span>
                            <span>Supporting Evidence</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Evidence"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Evidence"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Supporting observations, results, references, or evidence.">
                            </textarea>

                            <span asp-validation-for="Evidence"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="decision-log-form-footer">

                        <button type="submit"
                                class="btn btn-primary decision-log-save">
                            <i class="bi bi-check2-circle"></i>
                            Save Decision
                        </button>

                        <a asp-area="Research"
                           asp-controller="WorkItems"
                           asp-action="Details"
                           asp-route-id="@Model.WorkItemId"
                           asp-route-projectId="@Model.ProjectId"
                           asp-route-boardId="@Model.BoardId"
                           class="btn btn-outline-secondary decision-log-cancel">
                            <i class="bi bi-arrow-left"></i>
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
