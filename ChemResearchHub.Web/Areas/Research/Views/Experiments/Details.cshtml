@model ChemResearchHub.Web.Models.Experiments.ExperimentDetailsViewModel

@{
    ViewData["Title"] = "Experiment Notebook";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/experiment-details.css"
          asp-append-version="true" />
}

<div class="experiment-details-page">

    <!-- Header -->

    <div class="experiment-header">

        <div class="experiment-header-content">

            <div class="experiment-header-info">

                <div class="experiment-eyebrow">
                    Experiment Notebook
                </div>

                <div class="experiment-reference">
                    @Model.ReferenceCode
                </div>

                <h1 class="experiment-title">
                    🔬 @Model.Title
                </h1>

                <div class="experiment-subtitle">
                    دفترچه پژوهشی کامل آزمایش
                </div>

            </div>

            <a asp-controller="Experiments"
               asp-action="List"
               class="experiment-back-button">
                <span>←</span>
                بازگشت
            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- وضعیت -->

        <div class="col-lg-4">

            <div class="notebook-section">

                <div class="notebook-section-title">
                    🧪 وضعیت آزمایش
                </div>

                <div class="status-card mb-3">

                    @if (Model.CompletedAt.HasValue)
                    {
                        <div class="status-label">
                            <span class="status-dot status-completed"></span>
                            تکمیل شده
                        </div>
                    }
                    else if (Model.StartedAt.HasValue)
                    {
                        <div class="status-label">
                            <span class="status-dot status-active"></span>
                            در حال انجام
                        </div>
                    }
                    else
                    {
                        <div class="status-label">
                            <span class="status-dot status-pending"></span>
                            هنوز شروع نشده
                        </div>
                    }

                </div>

                <div class="experiment-field mb-3">
                    <div class="field-label">شروع آزمایش</div>
                    <div class="field-value">
                        @(Model.StartedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                    </div>
                </div>

                <div class="experiment-field">
                    <div class="field-label">پایان آزمایش</div>
                    <div class="field-value">
                        @(Model.CompletedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                    </div>
                </div>

            </div>

        </div>


        <!-- مسیر پژوهشی -->

        <div class="col-lg-8">

            <div class="notebook-section">

                <div class="notebook-section-title">
                    🧭 مسیر پژوهشی
                </div>

                <div class="experiment-field mb-4">

                    <div class="field-label">
                        Work Item
                    </div>

                    <a asp-area="Research"
                       asp-controller="WorkItems"
                       asp-action="Details"
                       asp-route-id="@Model.WorkItemId"
                       class="research-link">

                        <span class="research-link-reference">
                            @Model.WorkItemReferenceCode
                        </span>

                        <span>@Model.WorkItemTitle</span>

                        <span class="research-link-arrow">←</span>

                    </a>

                </div>

                <div class="experiment-field">

                    <div class="field-label">
                        Experiment
                    </div>

                    <div class="field-value experiment-mono">
                        @Model.ReferenceCode
                    </div>

                </div>

            </div>

        </div>


        <!-- توضیحات -->

        <div class="col-lg-6">

            <div class="notebook-section">

                <div class="notebook-section-title">
                    📝 توضیحات آزمایش
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="field-value experiment-long-text">
                        @Model.Description
                    </div>
                }
                else
                {
                    <div class="experiment-empty-inline">
                        توضیحی برای این آزمایش ثبت نشده است.
                    </div>
                }

            </div>

        </div>


        <!-- Protocol -->

        <div class="col-lg-6">

            <div class="notebook-section">

                <div class="notebook-section-title">
                    📋 Protocol
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Protocol))
                {
                    <div class="field-value experiment-long-text">
                        @Model.Protocol
                    </div>
                }
                else
                {
                    <div class="experiment-empty-inline">
                        پروتکلی برای این آزمایش ثبت نشده است.
                    </div>
                }

            </div>

        </div>


        <!-- Samples + Results -->

        <div class="col-12">

            <div class="notebook-section">

                <div class="notebook-section-header">

                    <div>
                        <div class="notebook-section-title mb-1">
                            🧫 Samples & Results
                        </div>

                        <div class="section-description">
                            نمونه‌ها و نتایج ثبت‌شده برای این Experiment
                        </div>
                    </div>

                    <div class="section-counter">
                        <div class="section-counter-number">
                            @Model.Samples.Count
                        </div>

                        <div class="section-counter-label">
                            نمونه
                        </div>
                    </div>

                </div>


                @if (Model.Samples.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">🧫</div>

                        <div class="empty-state-title">
                            هنوز نمونه‌ای برای این آزمایش ثبت نشده است
                        </div>

                        <div class="empty-state-description">
                            پس از ثبت Sample، نمونه‌ها و نتایج آن‌ها نمایش داده می‌شوند.
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-3">

                        @foreach (var sample in Model.Samples)
                        {
                            <div class="sample-card">

                                <div class="sample-header">

                                    <div class="sample-identity">

                                        <div class="sample-reference">
                                            @sample.ReferenceCode
                                        </div>

                                        <div class="sample-code">
                                            🧫 @sample.SampleCode
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(sample.Name))
                                        {
                                            <div class="sample-name">
                                                @sample.Name
                                            </div>
                                        }

                                    </div>

                                    <a asp-area="Research"
                                       asp-controller="Samples"
                                       asp-action="Details"
                                       asp-route-id="@sample.Id"
                                       class="sample-details-button">
                                        مشاهده نمونه
                                        <span>←</span>
                                    </a>

                                </div>


                                <div class="sample-meta">

                                    @if (!string.IsNullOrWhiteSpace(sample.SampleType))
                                    {
                                        <span class="sample-meta-item">
                                            <span class="sample-meta-label">نوع:</span>
                                            @sample.SampleType
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(sample.Matrix))
                                    {
                                        <span class="sample-meta-item">
                                            <span class="sample-meta-label">Matrix:</span>
                                            @sample.Matrix
                                        </span>
                                    }

                                    @if (sample.CollectedAt.HasValue)
                                    {
                                        <span class="sample-meta-item">
                                            <span class="sample-meta-label">جمع‌آوری:</span>
                                            @sample.CollectedAt.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    }

                                </div>


                                <div class="sample-results">

                                    <div class="sample-results-header">

                                        <div class="sample-results-title">
                                            📊 نتایج
                                        </div>

                                        <span class="sample-results-count">
                                            @sample.Results.Count
                                        </span>

                                    </div>


                                    @if (sample.Results.Count == 0)
                                    {
                                        <div class="experiment-empty-inline">
                                            هنوز نتیجه‌ای برای این Sample ثبت نشده است.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">

                                            @foreach (var result in sample.Results)
                                            {
                                                <div class="col-md-6 col-xl-4">

                                                    <div class="result-card">

                                                        <div class="result-header">

                                                            <div class="result-identity">

                                                                <div class="result-reference">
                                                                    @result.ReferenceCode
                                                                </div>

                                                                <div class="result-metric">
                                                                    @result.MetricName
                                                                </div>

                                                            </div>

                                                            <span class="result-status">
                                                                @result.Status
                                                            </span>

                                                        </div>


                                                        @if (result.NumericValue.HasValue)
                                                        {
                                                            <div class="result-value">

                                                                @result.NumericValue.Value

                                                                @if (!string.IsNullOrWhiteSpace(result.Unit))
                                                                {
                                                                    <span class="result-unit">
                                                                        @result.Unit
                                                                    </span>
                                                                }

                                                            </div>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(result.TextValue))
                                                        {
                                                            <div class="result-text-value">
                                                                @result.TextValue
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="result-empty">
                                                                مقدار نتیجه ثبت نشده است.
                                                            </div>
                                                        }


                                                        @if (!string.IsNullOrWhiteSpace(result.Method))
                                                        {
                                                            <div class="result-method">
                                                                Method: @result.Method
                                                            </div>
                                                        }


                                                        @if (!string.IsNullOrWhiteSpace(result.Notes))
                                                        {
                                                            <div class="result-notes">
                                                                @result.Notes
                                                            </div>
                                                        }

                                                    </div>

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- Reviews -->

        <div class="col-lg-6">

            <div class="notebook-section">

                <div class="notebook-section-header">

                    <div class="notebook-section-title mb-0">
                        🔍 Research Reviews
                    </div>

                    <span class="section-count-badge">
                        @Model.Reviews.Count
                    </span>

                </div>


                @if (Model.Reviews.Count == 0)
                {
                    <div class="empty-state">
                        هنوز Reviewای برای این Work Item ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="d-grid gap-3">

                        @foreach (var review in Model.Reviews)
                        {
                            <div class="review-card">

                                <div class="entity-header">

                                    <div>

                                        <div class="entity-reference">
                                            @review.ReferenceCode
                                        </div>

                                        <div class="entity-title">
                                            Review
                                        </div>

                                    </div>

                                    <span class="entity-status">
                                        @review.Status
                                    </span>

                                </div>


                                <div class="entity-field mt-3">

                                    <div class="entity-field-label">
                                        درخواست‌کننده
                                    </div>

                                    <div class="entity-field-value">
                                        @review.RequestedByUserName
                                    </div>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(review.ReviewerUserName))
                                {
                                    <div class="entity-field mt-3">

                                        <div class="entity-field-label">
                                            Reviewer
                                        </div>

                                        <div class="entity-field-value">
                                            @review.ReviewerUserName
                                        </div>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(review.ReviewNote))
                                {
                                    <div class="entity-note">
                                        @review.ReviewNote
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- Decisions -->

        <div class="col-lg-6">

            <div class="notebook-section">

                <div class="notebook-section-header">

                    <div class="notebook-section-title mb-0">
                        🧠 Research Decisions
                    </div>

                    <span class="section-count-badge">
                        @Model.Decisions.Count
                    </span>

                </div>


                @if (Model.Decisions.Count == 0)
                {
                    <div class="empty-state">
                        هنوز Decisionای برای این Work Item ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="d-grid gap-3">

                        @foreach (var decision in Model.Decisions)
                        {
                            <div class="decision-card">

                                <div class="entity-header">

                                    <div>

                                        <div class="entity-reference">
                                            @decision.ReferenceCode
                                        </div>

                                        <div class="entity-title">
                                            @decision.DecisionType
                                        </div>

                                    </div>

                                    <div class="entity-date">
                                        @decision.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                    </div>

                                </div>


                                <div class="decision-main">
                                    @decision.Decision
                                </div>


                                @if (!string.IsNullOrWhiteSpace(decision.Rationale))
                                {
                                    <div class="decision-detail">
                                        <strong>Rationale:</strong>
                                        @decision.Rationale
                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(decision.Evidence))
                                {
                                    <div class="decision-detail">
                                        <strong>Evidence:</strong>
                                        @decision.Evidence
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- Experiment Timeline -->

        <div class="col-12">

            <div class="notebook-section">

                <div class="notebook-section-header">

                    <div>
                        <div class="notebook-section-title mb-1">
                            🕒 Experiment Timeline
                        </div>

                        <div class="section-description">
                            تاریخچه فعالیت‌های پژوهشی مرتبط با این Experiment
                        </div>
                    </div>

                    <div class="section-counter">
                        <div class="section-counter-number">
                            @Model.Timeline.Count
                        </div>

                        <div class="section-counter-label">
                            رویداد
                        </div>
                    </div>

                </div>


                @if (Model.Timeline.Count == 0)
                {
                    <div class="empty-state">
                        هنوز رویداد پژوهشی برای این Experiment ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="timeline">

                        @foreach (var item in Model.Timeline)
                        {
                            <div class="timeline-item">

                                <div class="timeline-icon">
                                    @item.Icon
                                </div>

                                <div class="timeline-content">

                                    <div class="timeline-content-header">

                                        <div>

                                            <div class="timeline-type">
                                                @item.EventType
                                            </div>

                                            <div class="timeline-title">
                                                @item.Title
                                            </div>

                                        </div>

                                        <div class="entity-reference">
                                            @item.ReferenceCode
                                        </div>

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="timeline-description">
                                            @item.Description
                                        </div>
                                    }


                                    @if (item.OccurredAt.HasValue)
                                    {
                                        <div class="timeline-date">
                                            🕐
                                            @item.OccurredAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-date">
                                            زمان ثبت رویداد موجود نیست
                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>


        <!-- Notes -->

        <div class="col-12">

            <div class="notebook-section">

                <div class="notebook-section-title">
                    🧠 یادداشت‌های پژوهشی
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="field-value experiment-long-text">
                        @Model.Notes
                    </div>
                }
                else
                {
                    <div class="experiment-empty-inline">
                        هنوز یادداشتی برای این آزمایش ثبت نشده است.
                    </div>
                }

            </div>

        </div>

    </div>

</div>