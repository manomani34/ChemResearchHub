@model ChemResearchHub.Web.Models.Experiments.CreateExperimentViewModel

@{
    ViewData["Title"] = "Create Experiment";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/experiment-create.css"
          asp-append-version="true" />
}

<div class="experiment-create-page">

    <div class="experiment-create-header">

        <div class="experiment-create-heading">

            <div class="experiment-create-eyebrow">
                <span class="experiment-create-eyebrow-icon">
                    <i class="bi bi-kanban"></i>
                </span>
                Research Work Item
            </div>

            <h1>Create Experiment</h1>

            <p>
                Register a new experiment for this work item.
            </p>

        </div>

    </div>

    <div class="experiment-create-content">

        <div class="experiment-create-card">

            <div class="experiment-create-card-header">

                <div class="experiment-create-card-icon">
                    <i class="bi bi-flask"></i>
                </div>

                <div>
                    <h2>Experiment Information</h2>
                    <p>Define the experiment, methodology and execution details.</p>
                </div>

            </div>

            <div class="experiment-create-card-body">

                <form asp-action="Create" method="post">

                    <input asp-for="WorkItemId" type="hidden" />
                    <input asp-for="ProjectId" type="hidden" />
                    <input asp-for="BoardId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- Experiment Details -->

                    <div class="experiment-form-section">

                        <div class="experiment-section-heading">
                            <span class="experiment-section-number">01</span>
                            <span>Experiment Details</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Title" class="form-label"></label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="For example: NMR acquisition" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description" class="form-label"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe the purpose and scope of the experiment..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- Protocol -->

                    <div class="experiment-form-section">

                        <div class="experiment-section-heading">
                            <span class="experiment-section-number">02</span>
                            <span>Experimental Protocol</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Protocol" class="form-label"></label>

                            <textarea asp-for="Protocol"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Enter the experimental protocol, method, instrument settings, or procedure..."></textarea>

                            <span asp-validation-for="Protocol"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- Timeline -->

                    <div class="experiment-form-section">

                        <div class="experiment-section-heading">
                            <span class="experiment-section-number">03</span>
                            <span>Experiment Timeline</span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="StartedAt"
                                       class="form-label">
                                </label>

                                <input asp-for="StartedAt"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="StartedAt"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="CompletedAt"
                                       class="form-label">
                                </label>

                                <input asp-for="CompletedAt"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="CompletedAt"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- Notes -->

                    <div class="experiment-form-section experiment-notes-section">

                        <div class="experiment-section-heading">
                            <span class="experiment-section-number">04</span>
                            <span>Research Notes</span>
                        </div>

                        <div class="mb-3">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Additional observations, issues, or research notes..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- Actions -->

                    <div class="experiment-form-footer">

                        <button type="submit"
                                class="btn btn-primary experiment-create-submit">
                            <i class="bi bi-flask-fill"></i>
                            Create Experiment
                        </button>

                        <a asp-area="Research"
                           asp-controller="WorkItems"
                           asp-action="Details"
                           asp-route-id="@Model.WorkItemId"
                           asp-route-projectId="@Model.ProjectId"
                           asp-route-boardId="@Model.BoardId"
                           class="btn btn-outline-secondary experiment-create-cancel">
                            <i class="bi bi-arrow-left"></i>
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
