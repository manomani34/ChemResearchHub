@model ChemResearchHub.Web.Models.Experiments.ExperimentsListViewModel

@{
    ViewData["Title"] = "آزمایش‌ها";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/experiments-list.css"
          asp-append-version="true" />
}

<div class="experiments-page">

    <div class="experiments-header">

        <div>
            <div class="experiments-eyebrow">Research Experiments</div>
            <h1>آزمایش‌ها</h1>
            <p>فهرست آزمایش‌های ثبت‌شده در پروژه‌های پژوهشی</p>
        </div>

        <div class="experiments-count">
            <span class="experiments-count-number">@Model.Items.Count</span>
            <span>آزمایش ثبت‌شده</span>
        </div>

    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="experiments-empty">

            <div class="experiments-empty-icon">🧪</div>

            <h3>هنوز آزمایشی ثبت نشده است</h3>

            <p>
                آزمایش‌ها از داخل بخش کارهای پژوهشی ایجاد می‌شوند.
            </p>

            <a asp-area="Research"
               asp-controller="WorkItems"
               asp-action="Index"
               class="experiments-primary-button">
                مشاهده کارهای پژوهشی
            </a>

        </div>
    }
    else
    {
        <div class="experiments-table-card">

            <div class="experiments-table-heading">
                <div>
                    <h2>فهرست آزمایش‌ها</h2>
                    <p>اطلاعات و وضعیت آزمایش‌های ثبت‌شده</p>
                </div>

                <span class="experiments-table-total">
                    @Model.Items.Count مورد
                </span>
            </div>

            <div class="table-responsive">

                <table class="table experiments-table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>عنوان آزمایش</th>
                            <th>کار پژوهشی</th>
                            <th>شروع</th>
                            <th>پایان</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <div class="experiment-reference-copy">

                                        <span class="experiment-reference">
                                            @item.ReferenceCode
                                        </span>

                                        <button type="button"
                                                class="experiment-copy-button"
                                                data-reference="@item.ReferenceCode"
                                                title="کپی شناسه"
                                                aria-label="کپی شناسه @item.ReferenceCode">
                                            📋
                                        </button>

                                    </div>
                                </td>

                                <td>
                                    <div class="experiment-title">
                                        @item.Title
                                    </div>
                                </td>

                                <td>
                                    <div class="experiment-work-title">
                                        @item.WorkItemTitle
                                    </div>

                                    <div class="experiment-work-id">
                                        CRH-@item.WorkItemId.ToString("D6")
                                    </div>
                                </td>

                                <td>
                                    @if (item.StartedAt.HasValue)
                                    {
                                        <span class="experiment-date">
                                            @item.StartedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="experiment-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (item.CompletedAt.HasValue)
                                    {
                                        <span class="experiment-date">
                                            @item.CompletedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="experiment-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsCompleted)
                                    {
                                        <span class="experiment-status experiment-status-success">
                                            <span class="experiment-status-dot"></span>
                                            تکمیل‌شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="experiment-status experiment-status-warning">
                                            <span class="experiment-status-dot"></span>
                                            در حال انجام
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Experiments"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="experiment-details-button">
                                        🔬
                                        <span>مشاهده Notebook</span>
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const copyButtons =
                document.querySelectorAll(".experiments-page .experiment-copy-button");

            copyButtons.forEach(function (button) {

                button.addEventListener("click", async function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const referenceCode =
                        button.dataset.reference;

                    if (!referenceCode)
                        return;

                    try {

                        await navigator.clipboard.writeText(referenceCode);

                        const originalText =
                            button.textContent;

                        button.textContent = "✓";
                        button.classList.add("copied");
                        button.title = "کپی شد";

                        setTimeout(function () {

                            button.textContent = originalText;
                            button.classList.remove("copied");
                            button.title = "کپی شناسه";

                        }, 1200);

                    }
                    catch (error) {

                        console.error(
                            "Could not copy experiment reference:",
                            error
                        );

                    }

                });

            });

        });
    </script>

}