@model ChemResearchHub.Web.Models.Boards.BoardsListViewModel

@{
    ViewData["Title"] = "بوردهای پژوهشی";
}

<div class="boards-page">

    <div class="boards-header">
        <div>
            <div class="boards-eyebrow">Research Workspace</div>
            <h1 class="boards-header-title">بوردهای پژوهشی</h1>
            <p class="boards-header-subtitle">
                مدیریت بوردها و ورود به فضای Kanban
            </p>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="boards-empty">
            <div class="boards-empty-icon">📋</div>

            <h2 class="boards-empty-title">
                هنوز بوردی ایجاد نشده است
            </h2>

            <p class="boards-empty-text">
                ابتدا یک پروژه ایجاد کنید و سپس برای آن بورد پژوهشی بسازید.
            </p>

            <a asp-area="Research"
               asp-controller="Projects"
               asp-action="Index"
               class="crh-btn crh-btn-primary">
                مشاهده پروژه‌ها
            </a>
        </div>
    }
    else
    {
        <div class="boards-section-heading">
            <div>
                <h2>بوردهای در دسترس</h2>
                <p>فضاهای کاری Kanban پروژه‌های پژوهشی</p>
            </div>

            <span class="boards-count">@Model.Items.Count بورد</span>
        </div>

        <div class="boards-grid">

            @foreach (var item in Model.Items)
            {
                <article class="board-card">

                    <div class="board-card-top">
                        <div class="board-card-icon">📋</div>

                        <div class="board-card-project">
                            <span class="board-card-project-label">پروژه</span>
                            <span class="board-card-project-name">@item.ProjectName</span>
                        </div>
                    </div>

                    <div class="board-card-title">
                        @item.Name
                    </div>

                    <div class="board-card-meta">

                        <div class="board-card-meta-item">
                            <span class="board-card-meta-label">
                                ستون‌ها
                            </span>

                            <span class="board-card-meta-value">
                                @item.ColumnCount
                            </span>
                        </div>

                        <div class="board-card-meta-item">
                            <span class="board-card-meta-label">
                                شناسه
                            </span>

                            <span class="board-card-meta-value board-card-id">
                                #@item.Id
                            </span>
                        </div>

                    </div>

                    <div class="board-card-actions">
                        <a asp-area="Research"
                           asp-controller="Boards"
                           asp-action="Index"
                           asp-route-projectId="@item.ProjectId"
                           asp-route-boardId="@item.Id"
                           class="crh-btn crh-btn-primary">
                            ورود به بورد
                            <span class="board-enter-arrow">←</span>
                        </a>
                    </div>

                </article>
            }

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/boards-index.css"
          asp-append-version="true" />
}