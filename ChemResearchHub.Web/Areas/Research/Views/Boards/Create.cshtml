@model ChemResearchHub.Web.Models.Boards.CreateBoardViewModel

@{
    var project =
        (ChemResearchHub.Application.Projects.Dtos.ProjectDto)ViewBag.Project;

    ViewData["Title"] = "Create Board";
}

<div class="board-create-page">

    <div class="board-create-header">
        <div class="board-create-breadcrumb">
            <span>Research Workspace</span>
            <span class="board-create-breadcrumb-separator">/</span>
            <span>New Board</span>
        </div>

        <div class="board-create-heading">
            <div class="board-create-icon">📋</div>

            <div>
                <h1 class="board-create-title">ایجاد بورد پژوهشی</h1>
                <p class="board-create-subtitle">
                    ساخت فضای کاری Kanban برای مدیریت فعالیت‌های پژوهشی پروژه
                </p>
            </div>
        </div>
    </div>

    <div class="board-create-layout">

        <main class="board-create-main">
            <div class="board-create-card">

                <div class="board-create-card-heading">
                    <div>
                        <span class="board-create-step">01</span>
                        <h2>اطلاعات بورد</h2>
                        <p>مشخصات اولیه بورد پژوهشی را وارد کنید.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">

                    <input asp-for="ProjectId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="board-create-validation-summary">
                    </div>

                    <div class="board-create-field">
                        <label asp-for="Name" class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="For example: Main Research Board" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                        <div class="board-create-field-hint">
                            نامی کوتاه و معنادار برای فضای کاری پژوهش انتخاب کنید.
                        </div>
                    </div>

                    <div class="board-create-actions">
                        <button type="submit" class="board-create-submit">
                            Create Board
                        </button>

                        <a asp-action="Index"
                           asp-route-projectId="@Model.ProjectId"
                           class="board-create-cancel">
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </main>

        <aside class="board-create-sidebar">

            <div class="board-create-project-card">
                <div class="board-create-sidebar-label">
                    PROJECT CONTEXT
                </div>

                <div class="board-create-project-icon">🧪</div>

                <h3>@project.Name</h3>

                <p>
                    این بورد به پروژه پژوهشی بالا متصل خواهد شد.
                </p>
            </div>

            <div class="board-create-info-card">
                <div class="board-create-info-icon">💡</div>

                <h3>Research Kanban</h3>

                <p>
                    بورد Kanban فضای متمرکزی برای سازمان‌دهی فعالیت‌ها،
                    پیگیری پیشرفت و مدیریت جریان کار پژوهشی فراهم می‌کند.
                </p>
            </div>

        </aside>

    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/board-create.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}