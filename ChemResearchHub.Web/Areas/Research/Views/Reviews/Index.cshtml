@model ChemResearchHub.Web.Areas.Research.Controllers.ResearchReviewIndexViewModel
@using System.Security.Claims
@using ChemResearchHub.Domain.Entities.ResearchReview

@{
    ViewData["Title"] = "Research Review";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var isAdmin = User.IsInRole("Admin");
    var isResearcher = User.IsInRole("Researcher");
    var isReviewer = User.IsInRole("Reviewer");

    var canRequestReview = isAdmin || isResearcher;
    var canReview = isAdmin || isReviewer;
}

<div class="research-review-page" dir="rtl">

    <div class="rr-header">

        <div class="rr-header-content">
            <div class="rr-eyebrow">
                <i class="bi bi-clipboard2-check"></i>
                Research Workflow
            </div>

            <h1>بازبینی پژوهشی</h1>

            <p>
                مدیریت درخواست‌ها، بررسی نتایج و ثبت تصمیم‌های پژوهشی
            </p>

            <div class="rr-work-item-reference">
                <span>Work Item</span>
                <strong>#@Model.WorkItemId</strong>
                <span class="rr-reference-divider"></span>
                <strong class="rr-work-item-title">@Model.WorkItemTitle</strong>
            </div>
        </div>

        <a href="javascript:history.back()" class="rr-back-button">
            <i class="bi bi-arrow-right"></i>
            بازگشت
        </a>

    </div>

    @if (TempData["ReviewSuccess"] is string success)
    {
        <div class="rr-alert rr-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@success</span>
        </div>
    }

    @if (TempData["ReviewError"] is string error)
    {
        <div class="rr-alert rr-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@error</span>
        </div>
    }

    @if (canRequestReview)
    {
        <section class="rr-card rr-request-card">

            <div class="rr-card-header">
                <div class="rr-section-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>

                <div>
                    <h2>درخواست Review جدید</h2>
                    <p>
                        ارسال Work Item برای بررسی توسط یکی از اعضای تیم پژوهشی
                    </p>
                </div>
            </div>

            <div class="rr-card-body">

                <form method="post" action="/Research/Reviews/request">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="workItemId"
                           value="@Model.WorkItemId" />

                    <div class="rr-request-form">

                        <div class="rr-form-field">
                            <label for="reviewerUserId">
                                Reviewer
                                <span class="rr-optional">(اختیاری)</span>
                            </label>

                            <select id="reviewerUserId"
                                    name="reviewerUserId"
                                    class="rr-control">

                                <option value="">
                                    انتخاب Reviewer
                                </option>

                                @foreach (var reviewer in Model.Reviewers)
                                {
                                    <option value="@reviewer.Id">
                                        @reviewer.FullName

                                        @if (!string.IsNullOrWhiteSpace(reviewer.Email))
                                        {
                                            <text> — @reviewer.Email</text>
                                        }
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="rr-request-submit">
                            <button type="submit" class="rr-primary-button">
                                <i class="bi bi-send"></i>
                                ثبت درخواست Review
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </section>
    }

    <section class="rr-card rr-history-card">

        <div class="rr-card-header rr-history-header">

            <div class="rr-card-heading">
                <div class="rr-section-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <h2>Review History</h2>
                    <p>
                        سوابق درخواست‌ها و تصمیم‌های ثبت‌شده برای این Work Item
                    </p>
                </div>
            </div>

            <div class="rr-history-count">
                <span>@Model.Reviews.Count</span>
                <small>Reviews</small>
            </div>

        </div>

        <div class="rr-card-body rr-history-body">

            @if (Model.Reviews.Count == 0)
            {
                <div class="rr-empty-state">
                    <div class="rr-empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h3>هنوز Review ثبت نشده است</h3>

                    <p>
                        برای این Work Item تاکنون درخواست بازبینی پژوهشی ایجاد نشده است.
                    </p>
                </div>
            }
            else
            {
                foreach (var review in Model.Reviews)
                {
                    var badge = review.Status switch
                    {
                        ResearchReviewStatus.Approved => "approved",
                        ResearchReviewStatus.Rejected => "rejected",
                        ResearchReviewStatus.InReview => "in-review",
                        ResearchReviewStatus.Cancelled => "cancelled",
                        _ => "pending"
                    };

                    var statusText = review.Status switch
                    {
                        ResearchReviewStatus.Approved => "Approved",
                        ResearchReviewStatus.Rejected => "Rejected",
                        ResearchReviewStatus.InReview => "In Review",
                        ResearchReviewStatus.Cancelled => "Cancelled",
                        _ => "Pending"
                    };

                    var isRequester =
                        !string.IsNullOrWhiteSpace(currentUserId) &&
                        string.Equals(
                            review.RequestedByUserId,
                            currentUserId,
                            StringComparison.OrdinalIgnoreCase);

                    var canCancel = isAdmin || isRequester;

                    <article class="rr-review-item">

                        <div class="rr-review-top">

                            <div class="rr-review-identity">

                                <div class="rr-reference-copy">

                                    <span class="rr-reference-code">
                                        @review.ReferenceCode
                                    </span>

                                    <button type="button"
                                            class="review-copy-button rr-copy-button"
                                            data-reference="@review.ReferenceCode"
                                            title="کپی شناسه"
                                            aria-label="کپی شناسه @review.ReferenceCode">

                                        <i class="bi bi-copy"></i>

                                    </button>

                                </div>

                                <span class="rr-status-badge @badge">
                                    <span class="rr-status-dot"></span>
                                    @statusText
                                </span>

                            </div>

                            <div class="rr-review-date">
                                <i class="bi bi-calendar3"></i>
                                @review.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </div>

                        </div>

                        <div class="rr-review-meta">

                            <div class="rr-meta-item">
                                <span class="rr-meta-label">درخواست‌کننده</span>
                                <strong>
                                    @review.RequestedByUserName
                                </strong>
                            </div>

                            <div class="rr-meta-separator"></div>

                            <div class="rr-meta-item">
                                <span class="rr-meta-label">Reviewer</span>
                                <strong>
                                    @(review.ReviewerUserName ?? "تعیین نشده")
                                </strong>
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.ReviewNote))
                        {
                            <div class="rr-review-note">
                                <div class="rr-note-label">
                                    <i class="bi bi-chat-left-text"></i>
                                    Review Note
                                </div>

                                <div class="rr-note-content">
                                    @review.ReviewNote
                                </div>
                            </div>
                        }

                        @if (review.Status is
                            ResearchReviewStatus.Pending or
                            ResearchReviewStatus.InReview)
                        {
                            <div class="rr-review-actions">

                                @if (canReview)
                                {
                                    <form method="post"
                                          action="/Research/Reviews/start"
                                          class="rr-action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="reviewId"
                                               value="@review.Id" />

                                        <input type="hidden"
                                               name="workItemId"
                                               value="@Model.WorkItemId" />

                                        <button type="submit"
                                                class="rr-action-button rr-start-button">

                                            <i class="bi bi-play-circle"></i>
                                            شروع بررسی

                                        </button>

                                    </form>
                                }

                                @if (canReview)
                                {
                                    <form method="post"
                                          action="/Research/Reviews/approve"
                                          class="rr-action-form rr-decision-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="reviewId"
                                               value="@review.Id" />

                                        <input type="hidden"
                                               name="workItemId"
                                               value="@Model.WorkItemId" />

                                        <input type="text"
                                               name="note"
                                               placeholder="یادداشت تایید (اختیاری)"
                                               class="rr-action-input" />

                                        <button type="submit"
                                                class="rr-action-button rr-approve-button">

                                            <i class="bi bi-check-circle"></i>
                                            Approve

                                        </button>

                                    </form>
                                }

                                @if (canReview)
                                {
                                    <form method="post"
                                          action="/Research/Reviews/reject"
                                          class="rr-action-form rr-decision-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="reviewId"
                                               value="@review.Id" />

                                        <input type="hidden"
                                               name="workItemId"
                                               value="@Model.WorkItemId" />

                                        <input type="text"
                                               name="note"
                                               required
                                               placeholder="دلیل رد الزامی است"
                                               class="rr-action-input" />

                                        <button type="submit"
                                                class="rr-action-button rr-reject-button">

                                            <i class="bi bi-x-circle"></i>
                                            Reject

                                        </button>

                                    </form>
                                }

                                @if (canCancel)
                                {
                                    <form method="post"
                                          action="/Research/Reviews/cancel"
                                          class="rr-action-form rr-decision-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="reviewId"
                                               value="@review.Id" />

                                        <input type="hidden"
                                               name="workItemId"
                                               value="@Model.WorkItemId" />

                                        <input type="text"
                                               name="note"
                                               placeholder="یادداشت لغو (اختیاری)"
                                               class="rr-action-input" />

                                        <button type="submit"
                                                class="rr-action-button rr-cancel-button">

                                            <i class="bi bi-slash-circle"></i>
                                            لغو

                                        </button>

                                    </form>
                                }

                            </div>
                        }

                    </article>
                }
            }

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/research-review.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            document.querySelectorAll(".review-copy-button")
                .forEach(function(button) {

                    button.addEventListener("click", async function(event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode = button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(referenceCode);

                            const originalContent = button.innerHTML;

                            button.innerHTML = '<i class="bi bi-check-lg"></i>';
                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function() {
                                button.innerHTML = originalContent;
                                button.classList.remove("copied");
                                button.title = "کپی شناسه";
                            }, 1200);

                        } catch (error) {
                            console.error(
                                "Could not copy review reference:",
                                error
                            );
                        }
                    });
                });
        });
    </script>
}