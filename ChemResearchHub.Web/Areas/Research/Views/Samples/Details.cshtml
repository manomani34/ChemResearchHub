@model ChemResearchHub.Web.Models.Samples.SampleDetailsViewModel

@{
    ViewData["Title"] = "Sample Intelligence";
}

<style>
    .sample-reference {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        margin-bottom: 8px;
        padding: 4px 8px;
        border-radius: 6px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.4px;
        direction: ltr;
    }

    .sample-timeline {
        position: relative;
        margin-top: 10px;
        padding-right: 42px;
    }

    .sample-timeline::before {
        content: "";
        position: absolute;
        top: 12px;
        bottom: 12px;
        right: 15px;
        width: 2px;
        background: linear-gradient(
            to bottom,
            #dbeafe,
            #e5e7eb,
            #f1f5f9
        );
    }

    .sample-timeline-item {
        position: relative;
        margin-bottom: 18px;
    }

    .sample-timeline-item:last-child {
        margin-bottom: 0;
    }

    .sample-timeline-icon {
        position: absolute;
        top: 18px;
        right: -42px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid #dbeafe;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
        font-size: 14px;
        z-index: 2;
    }

    .sample-timeline-content {
        position: relative;
        padding: 16px 18px;
        background: linear-gradient(
            135deg,
            #ffffff,
            #f8fafc
        );
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(15, 23, 42, 0.05);
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease,
            border-color 0.15s ease;
    }

    .sample-timeline-content:hover {
        transform: translateY(-2px);
        border-color: #cbd5e1;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    }

    .sample-timeline-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
    }

    .sample-timeline-main {
        min-width: 0;
    }

    .sample-timeline-title {
        color: #111827;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.6;
    }

    .sample-timeline-type {
        display: inline-flex;
        align-items: center;
        margin-bottom: 6px;
        padding: 3px 8px;
        border-radius: 999px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .sample-timeline-reference {
        flex-shrink: 0;
        direction: ltr;
        padding: 4px 8px;
        border-radius: 6px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-family: monospace;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .sample-timeline-description {
        margin-top: 9px;
        color: #475569;
        font-size: 0.86rem;
        line-height: 1.8;
    }

    .sample-timeline-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
    }

    .sample-timeline-date {
        color: #94a3b8;
        font-size: 0.72rem;
    }

    .sample-timeline-date::before {
        content: "🕐";
        margin-left: 5px;
    }

    .sample-timeline-empty {
        padding: 25px 18px;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        background: #f8fafc;
        color: #64748b;
        text-align: center;
    }

    @@media (max-width: 576px) {
        .sample-timeline {
            padding-right: 34px;
        }

        .sample-timeline::before {
            right: 11px;
        }

        .sample-timeline-icon {
            right: -34px;
            width: 28px;
            height: 28px;
            font-size: 12px;
        }

        .sample-timeline-header {
            flex-direction: column;
            gap: 8px;
        }

        .sample-timeline-reference {
            align-self: flex-start;
        }
    }
</style>

<div class="container py-4">

    <div class="mb-4">

        <div class="text-muted mb-1">
            Sample Intelligence
        </div>

        <div class="sample-reference">
            @Model.ReferenceCode
        </div>

        <h1 class="h3 mb-1">
            🧫 @Model.SampleCode
        </h1>

        @if (!string.IsNullOrWhiteSpace(Model.Name))
        {
            <p class="text-muted mb-0">
                @Model.Name
            </p>
        }

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <!-- اطلاعات نمونه -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h2 class="h5 mb-4">
                        اطلاعات نمونه
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="text-muted small">
                                کد نمونه
                            </div>

                            <strong>
                                @Model.SampleCode
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                نوع نمونه
                            </div>

                            <strong>
                                @(Model.SampleType ?? "—")
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Matrix
                            </div>

                            <strong>
                                @(Model.Matrix ?? "—")
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                تاریخ جمع‌آوری
                            </div>

                            <strong>
                                @(Model.CollectedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- توضیحات -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h2 class="h5 mb-3">
                        توضیحات
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div>
                            @Model.Description
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            توضیحی برای این نمونه ثبت نشده است.
                        </div>
                    }

                </div>

            </div>


            <!-- مسیر پژوهشی -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h2 class="h5 mb-4">
                        🔬 مسیر پژوهشی
                    </h2>

                    <div class="mb-3">

                        <div class="text-muted small">
                            Project
                        </div>

                        <strong>
                            @Model.ProjectName
                        </strong>

                    </div>

                    <div class="mb-3">

                        <div class="text-muted small">
                            Experiment
                        </div>

                        <strong>
                            @Model.ExperimentTitle
                        </strong>

                        <div class="text-muted small">
                            EXP-@Model.ExperimentId.ToString("D6")
                        </div>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Work Item
                        </div>

                        <strong>
                            @Model.WorkItemReferenceCode
                        </strong>

                        <div>
                            @Model.WorkItemTitle
                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 Sample Timeline
                 ===================================================== -->

            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <div class="text-muted small mb-1">
                                Research Activity
                            </div>

                            <h2 class="h5 mb-1">
                                🧬 تاریخچه پژوهشی نمونه
                            </h2>

                            <div class="text-muted small">
                                مسیر ثبت و بررسی این نمونه در سیستم
                            </div>

                        </div>

                        <div class="text-center">

                            <div class="fw-bold"
                                 style="font-size:1.25rem;color:#334155;">
                                @Model.Timeline.Count
                            </div>

                            <div class="text-muted"
                                 style="font-size:0.68rem;">
                                رویداد
                            </div>

                        </div>

                    </div>


                    @if (Model.Timeline.Count == 0)
                    {
                        <div class="sample-timeline-empty">

                            <div style="font-size:2rem;margin-bottom:8px;">
                                🕒
                            </div>

                            <div class="fw-semibold mb-1">
                                هنوز فعالیت پژوهشی ثبت نشده است
                            </div>

                            <div class="small">
                                با ثبت Experiment، Result، Review یا Decision
                                تاریخچه نمونه به‌روزرسانی می‌شود.
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="sample-timeline">

                            @foreach (var item in Model.Timeline)
                            {
                                <div class="sample-timeline-item">

                                    <div class="sample-timeline-icon">
                                        @item.Icon
                                    </div>

                                    <div class="sample-timeline-content">

                                        <div class="sample-timeline-header">

                                            <div class="sample-timeline-main">

                                                <div class="sample-timeline-type">
                                                    @item.EventType
                                                </div>

                                                <div class="sample-timeline-title">
                                                    @item.Title
                                                </div>

                                            </div>

                                            <div class="sample-timeline-reference">
                                                @item.ReferenceCode
                                            </div>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="sample-timeline-description">
                                                @item.Description
                                            </div>
                                        }


                                        <div class="sample-timeline-footer">

                                            @if (item.OccurredAt.HasValue)
                                            {
                                                <div class="sample-timeline-date">
                                                    @item.OccurredAt.Value.ToString("yyyy/MM/dd HH:mm")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="sample-timeline-date">
                                                    تاریخ رویداد ثبت نشده است
                                                </div>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- اطلاعات تکمیلی -->

        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="h5 mb-4">
                        اطلاعات تکمیلی
                    </h2>

                    <div class="mb-3">

                        <div class="text-muted small">
                            External Reference
                        </div>

                        <div>
                            @(Model.ExternalReference ?? "—")
                        </div>

                    </div>

                    <div class="mb-3">

                        <div class="text-muted small">
                            Preparation Method
                        </div>

                        <div>
                            @(Model.PreparationMethod ?? "—")
                        </div>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Notes
                        </div>

                        <div>
                            @(Model.Notes ?? "—")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>