@model ChemResearchHub.Web.Models.Samples.SampleDetailsViewModel

@{
    ViewData["Title"] = "Sample Intelligence";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/sample-details.css"
          asp-append-version="true" />
}

<div class="sample-details-page">

    <div class="sample-details-header">

        <div class="sample-details-heading">
            <div class="sample-details-eyebrow">
                Sample Intelligence
            </div>

            <div class="sample-reference">
                @Model.ReferenceCode
            </div>

            <h1>
                🧫 @Model.SampleCode
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Name))
            {
                <p>@Model.Name</p>
            }
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="sample-info-card mb-4">

                <div class="sample-section-heading">
                    <span class="sample-section-icon">🧫</span>
                    <div>
                        <h2>اطلاعات نمونه</h2>
                        <p>مشخصات اصلی و اطلاعات جمع‌آوری نمونه</p>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="sample-field-label">کد نمونه</div>
                        <div class="sample-field-value sample-ltr">
                            @Model.SampleCode
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sample-field-label">نوع نمونه</div>
                        <div class="sample-field-value">
                            @(Model.SampleType ?? "—")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sample-field-label">Matrix</div>
                        <div class="sample-field-value">
                            @(Model.Matrix ?? "—")
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="sample-field-label">تاریخ جمع‌آوری</div>
                        <div class="sample-field-value sample-ltr">
                            @(Model.CollectedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                        </div>
                    </div>

                </div>

            </div>

            <div class="sample-info-card mb-4">

                <div class="sample-section-heading">
                    <span class="sample-section-icon">📝</span>
                    <div>
                        <h2>توضیحات</h2>
                        <p>شرح و اطلاعات توصیفی نمونه</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="sample-description">
                        @Model.Description
                    </div>
                }
                else
                {
                    <div class="sample-empty-text">
                        توضیحی برای این نمونه ثبت نشده است.
                    </div>
                }

            </div>

            <div class="sample-info-card mb-4">

                <div class="sample-section-heading">
                    <span class="sample-section-icon">🔬</span>
                    <div>
                        <h2>مسیر پژوهشی</h2>
                        <p>ارتباط نمونه با پروژه، آزمایش و کار پژوهشی</p>
                    </div>
                </div>

                <div class="sample-research-path">

                    <div class="sample-path-item">
                        <div class="sample-field-label">Project</div>
                        <div class="sample-field-value">
                            @Model.ProjectName
                        </div>
                    </div>

                    <div class="sample-path-item">
                        <div class="sample-field-label">Experiment</div>
                        <div class="sample-field-value">
                            @Model.ExperimentTitle
                        </div>
                        <div class="sample-field-meta sample-ltr">
                            EXP-@Model.ExperimentId.ToString("D6")
                        </div>
                    </div>

                    <div class="sample-path-item">
                        <div class="sample-field-label">Work Item</div>
                        <div class="sample-field-value">
                            @Model.WorkItemReferenceCode
                        </div>
                        <div class="sample-field-meta">
                            @Model.WorkItemTitle
                        </div>
                    </div>

                </div>

            </div>

            <div class="sample-info-card mb-4">

                <div class="sample-section-heading sample-timeline-heading">

                    <div class="sample-section-heading-main">
                        <span class="sample-section-icon">🧬</span>
                        <div>
                            <div class="sample-details-eyebrow">Research Activity</div>
                            <h2>تاریخچه پژوهشی نمونه</h2>
                            <p>مسیر ثبت و بررسی این نمونه در سیستم</p>
                        </div>
                    </div>

                    <div class="sample-timeline-count">
                        <strong>@Model.Timeline.Count</strong>
                        <span>رویداد</span>
                    </div>

                </div>

                @if (Model.Timeline.Count == 0)
                {
                    <div class="sample-timeline-empty">
                        <div class="sample-timeline-empty-icon">🕒</div>

                        <div class="fw-semibold mb-2">
                            هنوز فعالیت پژوهشی ثبت نشده است
                        </div>

                        <div class="small">
                            با ثبت Experiment، Result، Review یا Decision
                            تاریخچه نمونه به‌روزرسانی می‌شود.
                        </div>
                    </div>
                }
                else
                {
                    <div class="sample-timeline">

                        @foreach (var item in Model.Timeline)
                        {
                            <div class="sample-timeline-item">

                                <div class="sample-timeline-icon">
                                    @item.Icon
                                </div>

                                <div class="sample-timeline-content">

                                    <div class="sample-timeline-header">

                                        <div class="sample-timeline-main">

                                            <div class="sample-timeline-type">
                                                @item.EventType
                                            </div>

                                            <div class="sample-timeline-title">
                                                @item.Title
                                            </div>

                                        </div>

                                        <div class="sample-timeline-reference">
                                            @item.ReferenceCode
                                        </div>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="sample-timeline-description">
                                            @item.Description
                                        </div>
                                    }

                                    <div class="sample-timeline-footer">

                                        @if (item.OccurredAt.HasValue)
                                        {
                                            <div class="sample-timeline-date">
                                                @item.OccurredAt.Value.ToString("yyyy/MM/dd HH:mm")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sample-timeline-date">
                                                تاریخ رویداد ثبت نشده است
                                            </div>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

        <div class="col-lg-4">

            <div class="sample-info-card sample-additional-card">

                <div class="sample-section-heading">
                    <span class="sample-section-icon">📌</span>
                    <div>
                        <h2>اطلاعات تکمیلی</h2>
                        <p>اطلاعات آماده‌سازی و مراجع خارجی</p>
                    </div>
                </div>

                <div class="sample-additional-field">
                    <div class="sample-field-label">External Reference</div>
                    <div class="sample-field-value sample-ltr">
                        @(Model.ExternalReference ?? "—")
                    </div>
                </div>

                <div class="sample-additional-field">
                    <div class="sample-field-label">Preparation Method</div>
                    <div class="sample-field-value">
                        @(Model.PreparationMethod ?? "—")
                    </div>
                </div>

                <div class="sample-additional-field">
                    <div class="sample-field-label">Notes</div>
                    <div class="sample-field-value">
                        @(Model.Notes ?? "—")
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>