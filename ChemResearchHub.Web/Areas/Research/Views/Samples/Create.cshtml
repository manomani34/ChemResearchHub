@model ChemResearchHub.Web.Models.Samples.CreateSampleViewModel

@{
    ViewData["Title"] = "Create Sample";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/sample-create.css"
          asp-append-version="true" />
}

<div class="sample-create-page">

    <div class="sample-create-header">

        <div class="sample-create-eyebrow">
            Research Experiment
        </div>

        <h1>Create Sample</h1>

        <p>
            Register a new sample for this experiment.
        </p>

    </div>

    <div class="sample-create-card">

        <div class="sample-create-card-heading">
            <div class="sample-create-icon">🧫</div>

            <div>
                <h2>Sample Information</h2>
                <p>اطلاعات نمونه جدید را وارد کنید.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">

            <input asp-for="ExperimentId" type="hidden" />
            <input asp-for="WorkItemId" type="hidden" />
            <input asp-for="ProjectId" type="hidden" />
            <input asp-for="BoardId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="sample-validation-summary">
            </div>

            <div class="sample-form-section">

                <div class="sample-form-section-title">
                    مشخصات اصلی
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="SampleCode"
                               class="form-label">
                        </label>

                        <input asp-for="SampleCode"
                               class="form-control"
                               placeholder="For example: SAFF-001" />

                        <span asp-validation-for="SampleCode"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="For example: Iranian saffron sample" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SampleType"
                               class="form-label">
                        </label>

                        <input asp-for="SampleType"
                               class="form-control"
                               placeholder="For example: Saffron" />

                        <span asp-validation-for="SampleType"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Matrix"
                               class="form-label">
                        </label>

                        <input asp-for="Matrix"
                               class="form-control"
                               placeholder="For example: Plant material" />

                        <span asp-validation-for="Matrix"
                              class="text-danger">
                        </span>
                    </div>

                </div>

            </div>

            <div class="sample-form-section">

                <div class="sample-form-section-title">
                    آماده‌سازی و جمع‌آوری
                </div>

                <div class="mb-3">
                    <label asp-for="PreparationMethod"
                           class="form-label">
                    </label>

                    <textarea asp-for="PreparationMethod"
                              class="form-control"
                              rows="5"
                              placeholder="Describe sample preparation, extraction, dilution, solvent, concentration, etc."></textarea>

                    <span asp-validation-for="PreparationMethod"
                          class="text-danger">
                    </span>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="CollectedAt"
                               class="form-label">
                        </label>

                        <input asp-for="CollectedAt"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="CollectedAt"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExternalReference"
                               class="form-label">
                        </label>

                        <input asp-for="ExternalReference"
                               class="form-control"
                               placeholder="Laboratory or external reference" />

                        <span asp-validation-for="ExternalReference"
                              class="text-danger">
                        </span>
                    </div>

                </div>

            </div>

            <div class="sample-form-section">

                <div class="sample-form-section-title">
                    توضیحات و یادداشت‌ها
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the sample and its purpose..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div>
                    <label asp-for="Notes"
                           class="form-label">
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="5"
                              placeholder="Additional observations or laboratory notes..."></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>
                </div>

            </div>

            <div class="sample-form-actions">

                <button type="submit"
                        class="sample-submit-button">
                    Create Sample
                </button>

                <a asp-area="Research"
                   asp-controller="WorkItems"
                   asp-action="Details"
                   asp-route-id="@Model.WorkItemId"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-boardId="@Model.BoardId"
                   class="sample-cancel-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}