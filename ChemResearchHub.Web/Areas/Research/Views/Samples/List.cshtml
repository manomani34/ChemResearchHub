@model ChemResearchHub.Web.Models.Samples.SamplesListViewModel

@{
    ViewData["Title"] = "نمونه‌ها";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/samples-list.css"
          asp-append-version="true" />
}

<div class="samples-page">

    <div class="samples-header">
        <div>
            <div class="samples-eyebrow">Research Data</div>
            <h1>نمونه‌ها</h1>
            <p>فهرست نمونه‌های ثبت‌شده در آزمایش‌های پژوهشی</p>
        </div>

        <div class="samples-count">
            <span class="samples-count-number">@Model.Items.Count</span>
            <span>نمونه ثبت‌شده</span>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="samples-empty">
            <div class="samples-empty-icon">🧫</div>

            <h3>هنوز نمونه‌ای ثبت نشده است</h3>

            <p>
                نمونه‌ها از داخل بخش آزمایش‌های مربوط به کارهای پژوهشی ایجاد می‌شوند.
            </p>

            <a asp-area="Research"
               asp-controller="Experiments"
               asp-action="List"
               class="samples-primary-button">
                مشاهده آزمایش‌ها
            </a>
        </div>
    }
    else
    {
        <div class="samples-table-card">

            <div class="samples-table-heading">
                <div>
                    <h2>فهرست نمونه‌ها</h2>
                    <p>اطلاعات نمونه‌ها و ارتباط آن‌ها با آزمایش‌ها و کارهای پژوهشی</p>
                </div>

                <span class="samples-table-total">
                    @Model.Items.Count مورد
                </span>
            </div>

            <div class="table-responsive">

                <table class="table samples-table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>کد نمونه</th>
                            <th>نام نمونه</th>
                            <th>نوع</th>
                            <th>Matrix</th>
                            <th>آزمایش</th>
                            <th>کار پژوهشی</th>
                            <th>تاریخ جمع‌آوری</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="sample-reference-copy">
                                        <span class="sample-reference">
                                            SMP-@item.Id.ToString("D6")
                                        </span>

                                        <button type="button"
                                                class="sample-copy-button"
                                                data-reference="SMP-@item.Id.ToString("D6")"
                                                title="کپی شناسه"
                                                aria-label="کپی شناسه SMP-@item.Id.ToString("D6")">
                                            📋
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    <div class="sample-code">
                                        @item.SampleCode
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Name))
                                    {
                                        <div class="sample-primary-text">
                                            @item.Name
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="samples-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.SampleType))
                                    {
                                        <span class="sample-type-badge">
                                            @item.SampleType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="samples-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Matrix))
                                    {
                                        <span class="sample-matrix">
                                            @item.Matrix
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="samples-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="sample-primary-text">
                                        @item.ExperimentTitle
                                    </div>

                                    <div class="sample-secondary-text">
                                        آزمایش #@item.ExperimentId
                                    </div>
                                </td>

                                <td>
                                    <div class="sample-primary-text">
                                        @item.WorkItemTitle
                                    </div>

                                    <div class="sample-secondary-text">
                                        کار #@item.WorkItemId
                                    </div>
                                </td>

                                <td>
                                    @if (item.CollectedAt.HasValue)
                                    {
                                        <span class="sample-date">
                                            @item.CollectedAt.Value.ToString("yyyy/MM/dd HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="samples-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Samples"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="sample-details-button">
                                        مشاهده
                                        <span>←</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const copyButtons =
                document.querySelectorAll(".samples-page .sample-copy-button");

            copyButtons.forEach(function (button) {

                button.addEventListener("click", async function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const referenceCode =
                        button.dataset.reference;

                    if (!referenceCode) {
                        return;
                    }

                    try {

                        await navigator.clipboard.writeText(referenceCode);

                        const originalText = button.textContent;

                        button.textContent = "✓";
                        button.classList.add("copied");
                        button.title = "کپی شد";

                        setTimeout(function () {

                            button.textContent = originalText;
                            button.classList.remove("copied");
                            button.title = "کپی شناسه";

                        }, 1200);

                    }
                    catch (error) {

                        console.error(
                            "Could not copy sample reference:",
                            error
                        );

                    }

                });

            });

        });
    </script>
}