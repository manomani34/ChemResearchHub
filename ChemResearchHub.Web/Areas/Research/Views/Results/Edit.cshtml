@model ChemResearchHub.Web.Models.Results.EditResultViewModel

@{
    ViewData["Title"] = "Edit Result";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/result-forms.css"
          asp-append-version="true" />
}

<div class="result-form-page">

    <div class="result-form-header">
        <div class="result-form-eyebrow">Research Sample</div>
        <h1>Edit Result</h1>
        <p>Update the structured result.</p>
    </div>

    <div class="result-form-card">

        <div class="result-form-card-header">
            <div class="result-form-icon">📊</div>
            <div>
                <h2>Result Information</h2>
                <p>ویرایش اطلاعات و ارزیابی نتیجه پژوهشی</p>
            </div>
        </div>

        <div class="result-form-card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />
                <input asp-for="SampleId" type="hidden" />
                <input asp-for="ExperimentId" type="hidden" />
                <input asp-for="WorkItemId" type="hidden" />
                <input asp-for="ProjectId" type="hidden" />
                <input asp-for="BoardId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="result-validation-summary text-danger mb-3">
                </div>

                <div class="result-form-section">
                    <div class="result-form-section-title">
                        مشخصات اندازه‌گیری
                    </div>

                    <div class="result-form-field">
                        <label asp-for="MetricName" class="form-label"></label>
                        <input asp-for="MetricName" class="form-control" />
                        <span asp-validation-for="MetricName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="result-form-field">
                                <label asp-for="NumericValue" class="form-label"></label>
                                <input asp-for="NumericValue"
                                       class="form-control"
                                       type="number"
                                       step="0.000001" />
                                <span asp-validation-for="NumericValue" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="result-form-field">
                                <label asp-for="Unit" class="form-label"></label>
                                <input asp-for="Unit" class="form-control" />
                                <span asp-validation-for="Unit" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="result-form-field">
                        <label asp-for="TextValue" class="form-label"></label>
                        <textarea asp-for="TextValue"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="TextValue" class="text-danger"></span>
                    </div>

                    <div class="result-form-field">
                        <label asp-for="Method" class="form-label"></label>
                        <textarea asp-for="Method"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Method" class="text-danger"></span>
                    </div>

                    <div class="result-form-field">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Pass">Pass</option>
                            <option value="Fail">Fail</option>
                            <option value="Inconclusive">Inconclusive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="result-form-section">
                    <div class="result-form-section-title">
                        مستندات و یادداشت‌ها
                    </div>

                    <div class="result-form-field">
                        <label asp-for="Evidence" class="form-label"></label>
                        <textarea asp-for="Evidence"
                                  class="form-control"
                                  rows="5"></textarea>
                        <span asp-validation-for="Evidence" class="text-danger"></span>
                    </div>

                    <div class="result-form-field">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="5"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>

                <div class="result-form-actions">
                    <button type="submit" class="result-form-btn result-form-btn-primary">
                        Save Changes
                    </button>

                    <a asp-area="Research"
                       asp-controller="WorkItems"
                       asp-action="Details"
                       asp-route-id="@Model.WorkItemId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-boardId="@Model.BoardId"
                       class="result-form-btn result-form-btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}