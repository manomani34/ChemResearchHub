@model ChemResearchHub.Web.Models.Results.ResultsListViewModel

@{
    ViewData["Title"] = "نتایج";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/results-index.css"
          asp-append-version="true" />
}

<div class="results-index-page">

    <div class="results-header">
        <div class="results-heading">
            <div class="results-eyebrow">Research Data</div>
            <h1>نتایج پژوهشی</h1>
            <p>فهرست نتایج ثبت‌شده برای نمونه‌های پژوهشی</p>
        </div>

        <div class="results-count">
            <strong>@Model.Items.Count</strong>
            <span>نتیجه</span>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="results-empty">
            <div class="results-empty-icon">📊</div>

            <h3>هنوز نتیجه‌ای ثبت نشده است</h3>

            <p>
                نتایج از داخل نمونه‌های ثبت‌شده در بخش کارهای پژوهشی ایجاد می‌شوند.
            </p>

            <a asp-area="Research"
               asp-controller="Samples"
               asp-action="List"
               class="results-btn results-btn-primary">
                مشاهده نمونه‌ها
            </a>
        </div>
    }
    else
    {
        <div class="results-table-card">
            <div class="results-table-header">
                <div>
                    <h2>فهرست نتایج</h2>
                    <p>اطلاعات اندازه‌گیری‌ها و ارزیابی‌های ثبت‌شده</p>
                </div>

                <span class="results-table-total">
                    @Model.Items.Count مورد
                </span>
            </div>

            <div class="table-responsive">
                <table class="table results-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>نمونه</th>
                            <th>معیار</th>
                            <th>مقدار</th>
                            <th>واحد</th>
                            <th>روش</th>
                            <th>آزمایش</th>
                            <th>کار پژوهشی</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="result-reference-copy">
                                        <span class="result-reference-code">
                                            @item.ReferenceCode
                                        </span>

                                        <button type="button"
                                                class="result-copy-button"
                                                data-reference="@item.ReferenceCode"
                                                title="کپی شناسه"
                                                aria-label="کپی شناسه @item.ReferenceCode">
                                            📋
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    <div class="result-sample-code">
                                        @item.SampleCode
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.SampleName))
                                    {
                                        <div class="result-secondary-text">
                                            @item.SampleName
                                        </div>
                                    }

                                    <div class="result-secondary-text">
                                        نمونه #@item.SampleId
                                    </div>
                                </td>

                                <td>
                                    <div class="result-primary-text">
                                        @item.MetricName
                                    </div>
                                </td>

                                <td>
                                    @{
                                        var displayValue =
                                            item.NumericValue.HasValue
                                                ? item.NumericValue.Value.ToString("0.######")
                                                : item.TextValue;
                                    }

                                    @if (!string.IsNullOrWhiteSpace(displayValue))
                                    {
                                        <span class="result-value">
                                            @displayValue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Unit))
                                    {
                                        <span class="result-unit">
                                            @item.Unit
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Method))
                                    {
                                        @item.Method
                                    }
                                    else
                                    {
                                        <span class="result-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="result-primary-text">
                                        @item.ExperimentTitle
                                    </div>

                                    <div class="result-secondary-text">
                                        آزمایش #@item.ExperimentId
                                    </div>
                                </td>

                                <td>
                                    <div class="result-primary-text">
                                        @item.WorkItemTitle
                                    </div>

                                    <div class="result-secondary-text">
                                        کار #@item.WorkItemId
                                    </div>
                                </td>

                                <td>
                                    @{
                                        var statusClass =
                                            item.Status?.ToLowerInvariant() switch
                                            {
                                                "pass" => "result-status-pass",
                                                "fail" => "result-status-fail",
                                                "inconclusive" => "result-status-inconclusive",
                                                _ => "result-status-pending"
                                            };

                                        var statusText =
                                            item.Status?.ToLowerInvariant() switch
                                            {
                                                "pass" => "موفق",
                                                "fail" => "رد شده",
                                                "inconclusive" => "نامشخص",
                                                _ => "در انتظار"
                                            };
                                    }

                                    <span class="result-status @statusClass">
                                        @statusText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const page = document.querySelector(".results-index-page");

            if (!page)
                return;

            page.querySelectorAll(".result-copy-button")
                .forEach(function (button) {

                    button.addEventListener("click", async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode = button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(referenceCode);

                            const originalText = button.textContent;

                            button.textContent = "✓";
                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function () {
                                button.textContent = originalText;
                                button.classList.remove("copied");
                                button.title = "کپی شناسه";
                            }, 1200);

                        } catch (error) {
                            console.error(
                                "Could not copy result reference:",
                                error
                            );
                        }
                    });
                });
        });
    </script>
}