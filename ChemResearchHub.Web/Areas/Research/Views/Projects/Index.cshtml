
@model IReadOnlyList<ChemResearchHub.Application.Projects.Dtos.ProjectDto>

@{
    ViewData["Title"] = "پروژه‌های پژوهشی";
}

<div class="projects-page" dir="rtl">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="crh-alert crh-alert-success">
            <span class="crh-alert-icon">✓</span>
            <span>@successMessage</span>
        </div>
    }

    <div class="projects-header">
        <div class="projects-header-content">
            <div class="projects-eyebrow">Research Workspace</div>
            <h1 class="projects-header-title">پروژه‌های پژوهشی</h1>
            <p class="projects-header-subtitle">
                مدیریت پروژه‌های تحقیقاتی و مشاهده فضای پژوهش
            </p>
        </div>

        <a asp-action="Create" class="crh-btn crh-btn-primary projects-create-button">
            <span class="projects-button-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                </svg>
            </span>
            پروژه جدید
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="projects-empty">

            <div class="projects-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M9 3h6" />
                    <path d="M10 3v5.2L5.8 16a3.5 3.5 0 0 0 3.1 5h6.2a3.5 3.5 0 0 0 3.1-5L14 8.2V3" />
                    <path d="M8 15h8" />
                    <path d="M10 18h.01M14 17h.01" />
                </svg>
            </div>

            <h2 class="projects-empty-title">هنوز پروژه‌ای ثبت نشده است</h2>

            <p class="projects-empty-text">
                برای شروع، اولین پروژه پژوهشی خود را ایجاد کنید.
            </p>

            <a asp-action="Create" class="crh-btn crh-btn-primary">
                ایجاد اولین پروژه
            </a>
        </div>
    }
    else
    {
        <div class="projects-section-heading">
            <div>
                <h2>فضای پروژه‌ها</h2>
                <p>پروژه‌های ثبت‌شده در سامانه پژوهشی</p>
            </div>

            <div class="projects-section-tools">

                <span class="projects-count">
                    @Model.Count پروژه
                </span>

                <div class="projects-view-switch"
                     role="group"
                     aria-label="نحوه نمایش پروژه‌ها">

                    <button type="button"
                            class="projects-view-button"
                            data-view-mode="grid"
                            title="نمایش باکسی"
                            aria-label="نمایش باکسی">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="3" width="8" height="8" rx="1.5" />
                            <rect x="13" y="3" width="8" height="8" rx="1.5" />
                            <rect x="3" y="13" width="8" height="8" rx="1.5" />
                            <rect x="13" y="13" width="8" height="8" rx="1.5" />
                        </svg>

                    </button>

                    <button type="button"
                            class="projects-view-button"
                            data-view-mode="list"
                            title="نمایش لیستی"
                            aria-label="نمایش لیستی">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 6h13M8 12h13M8 18h13" />
                            <circle cx="3.5" cy="6" r="1" />
                            <circle cx="3.5" cy="12" r="1" />
                            <circle cx="3.5" cy="18" r="1" />
                        </svg>

                    </button>

                </div>

            </div>
        </div>

        <div class="projects-grid" id="projectsContainer">

            @foreach (var project in Model)
            {
                <article class="project-card">

                    <div class="project-card-header">

                        <div class="project-card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 3h6" />
                                <path d="M10 3v5.2L5.8 16a3.5 3.5 0 0 0 3.1 5h6.2a3.5 3.5 0 0 0 3.1-5L14 8.2V3" />
                                <path d="M8 15h8" />
                                <path d="M10 18h.01M14 17h.01" />
                            </svg>
                        </div>

                        <div class="project-card-id">
                            <span class="project-reference-label">
                                شناسه پروژه
                            </span>

                            <div class="project-reference-copy">
                                <span class="crh-id">@project.ReferenceCode</span>

                                <button type="button"
                                        class="project-copy-button"
                                        data-reference="@project.ReferenceCode"
                                        title="کپی شناسه"
                                        aria-label="کپی شناسه @project.ReferenceCode">

                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="8" y="8" width="12" height="12" rx="2" />
                                        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <span class="project-status @(project.IsActive ? "project-status-active" : "project-status-inactive")">
                            <span class="project-status-dot"></span>
                            @(project.IsActive ? "فعال" : "غیرفعال")
                        </span>

                    </div>

                    <div class="project-card-body">

                        <h3 class="project-card-title">
                            @project.Name
                        </h3>

                        <div class="project-card-description">
                            @if (string.IsNullOrWhiteSpace(project.Description))
                            {
                                <span class="project-description-empty">
                                    توضیحی برای این پروژه ثبت نشده است.
                                </span>
                            }
                            else
                            {
                                @project.Description
                            }
                        </div>

                    </div>

                    <div class="project-card-footer">
                        <div class="project-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                جزئیات
                            </a>

                            <a asp-area="Research"
                               asp-controller="Boards"
                               asp-action="Index"
                               asp-route-projectId="@project.Id"
                               class="crh-btn crh-btn-primary">
                                بورد
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                ویرایش
                            </a>

                        </div>
                    </div>

                </article>
            }

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/projects-index.css"
          asp-append-version="true" />

    <style>
        /* View switcher */

        .projects-section-tools {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .projects-view-switch {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid var(--crh-border, #e5e7eb);
            border-radius: 10px;
            background: var(--crh-surface, #fff);
        }

        .projects-view-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            padding: 7px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: var(--crh-text-muted, #89909c);
            cursor: pointer;
            transition: all .2s ease;
        }

        .projects-view-button svg {
            width: 19px;
            height: 19px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .projects-view-button:hover {
            background: rgba(100, 116, 139, .09);
            color: var(--crh-text, #334155);
        }

        .projects-view-button.active {
            background: var(--crh-primary, #2563eb);
            color: #fff;
        }

        /* List view */

        .projects-grid.is-list-view {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .projects-grid.is-list-view .project-card {
            display: grid;
            grid-template-columns: minmax(210px, 1.1fr) minmax(200px, 1fr) auto;
            align-items: center;
            gap: 22px;
            width: 100%;
            min-width: 0;
            padding: 18px 22px;
        }

        .projects-grid.is-list-view .project-card-header {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            min-width: 0;
            margin: 0;
        }

        .projects-grid.is-list-view .project-card-id {
            min-width: 0;
        }

        .projects-grid.is-list-view .project-card-body {
            min-width: 0;
            margin: 0;
        }

        .projects-grid.is-list-view .project-card-title {
            margin-top: 0;
            overflow-wrap: anywhere;
        }

        .projects-grid.is-list-view .project-card-description {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
        }

        .projects-grid.is-list-view .project-card-footer {
            margin: 0;
        }

        .projects-grid.is-list-view .project-card-actions {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 8px;
        }

        .projects-grid.is-list-view .project-card-actions .crh-btn {
            white-space: nowrap;
        }

        @@media (max-width: 1100px) {
            .projects-grid.is-list-view .project-card {
                grid-template-columns: minmax(0, 1fr) auto;
                gap: 14px;
            }

            .projects-grid.is-list-view .project-card-header {
                grid-column: 1;
            }

            .projects-grid.is-list-view .project-card-body {
                grid-column: 1;
            }

            .projects-grid.is-list-view .project-card-footer {
                grid-column: 2;
                grid-row: 1 / span 2;
            }
        }

        @@media (max-width: 650px) {
            .projects-section-tools {
                gap: 8px;
            }

            .projects-section-heading {
                flex-wrap: wrap;
                gap: 14px;
            }

            .projects-grid.is-list-view .project-card {
                grid-template-columns: minmax(0, 1fr);
                gap: 14px;
                padding: 16px;
            }

            .projects-grid.is-list-view .project-card-header,
            .projects-grid.is-list-view .project-card-body,
            .projects-grid.is-list-view .project-card-footer {
                grid-column: 1;
                grid-row: auto;
            }

            .projects-grid.is-list-view .project-card-header {
                flex-wrap: wrap;
            }

            .projects-grid.is-list-view .project-card-footer,
            .projects-grid.is-list-view .project-card-actions {
                width: 100%;
            }

            .projects-grid.is-list-view .project-card-actions {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .projects-grid.is-list-view .project-card-actions .crh-btn {
                justify-content: center;
                padding-inline: 8px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // View mode management

            const container = document.getElementById("projectsContainer");

            if (!container)
                return;

            const buttons = document.querySelectorAll(".projects-view-button");
            const storageKey = "crh-projects-view-mode";

            function setViewMode(mode) {

                const isList = mode === "list";

                container.classList.toggle("is-list-view", isList);

                buttons.forEach(function (button) {

                    const isActive = button.dataset.viewMode === mode;

                    button.classList.toggle("active", isActive);
                    button.setAttribute("aria-pressed", isActive.toString());

                });

                try {
                    localStorage.setItem(storageKey, mode);
                } catch (error) {
                    console.warn("Could not save projects view preference.", error);
                }
            }

            let savedMode = "grid";

            try {
                const storedMode = localStorage.getItem(storageKey);

                if (storedMode === "grid" || storedMode === "list") {
                    savedMode = storedMode;
                }
            } catch (error) {
                console.warn("Could not read projects view preference.", error);
            }

            buttons.forEach(function (button) {

                button.addEventListener("click", function () {
                    setViewMode(button.dataset.viewMode);
                });

            });

            setViewMode(savedMode);


            // Copy project reference

            document.querySelectorAll(".project-copy-button")
                .forEach(function (button) {

                    button.addEventListener("click", async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode = button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(referenceCode);

                            const originalContent = button.innerHTML;
                            const originalTitle = button.title;

                            button.innerHTML = `
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6" />
                                </svg>
                            `;

                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function () {
                                button.innerHTML = originalContent;
                                button.classList.remove("copied");
                                button.title = originalTitle;
                            }, 1200);

                        } catch (error) {
                            console.error(
                                "Could not copy project reference:",
                                error
                            );
                        }
                    });
                });
        });
    </script>
}
