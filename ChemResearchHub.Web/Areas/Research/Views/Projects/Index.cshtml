@model IReadOnlyList<ChemResearchHub.Application.Projects.Dtos.ProjectDto>

@{
    ViewData["Title"] = "پروژه‌های پژوهشی";
}

<div class="projects-page" dir="rtl">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="crh-alert crh-alert-success">
            <span class="crh-alert-icon">✓</span>
            <span>@successMessage</span>
        </div>
    }

    <div class="projects-header">
        <div class="projects-header-content">
            <div class="projects-eyebrow">Research Workspace</div>
            <h1 class="projects-header-title">پروژه‌های پژوهشی</h1>
            <p class="projects-header-subtitle">
                مدیریت پروژه‌های تحقیقاتی و مشاهده فضای پژوهش
            </p>
        </div>

        <a asp-action="Create" class="crh-btn crh-btn-primary projects-create-button">
            <span class="projects-button-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                </svg>
            </span>
            پروژه جدید
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="projects-empty">

            <div class="projects-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M9 3h6" />
                    <path d="M10 3v5.2L5.8 16a3.5 3.5 0 0 0 3.1 5h6.2a3.5 3.5 0 0 0 3.1-5L14 8.2V3" />
                    <path d="M8 15h8" />
                    <path d="M10 18h.01M14 17h.01" />
                </svg>
            </div>

            <h2 class="projects-empty-title">هنوز پروژه‌ای ثبت نشده است</h2>

            <p class="projects-empty-text">
                برای شروع، اولین پروژه پژوهشی خود را ایجاد کنید.
            </p>

            <a asp-action="Create" class="crh-btn crh-btn-primary">
                ایجاد اولین پروژه
            </a>
        </div>
    }
    else
    {
        <div class="projects-section-heading">
            <div>
                <h2>فضای پروژه‌ها</h2>
                <p>پروژه‌های ثبت‌شده در سامانه پژوهشی</p>
            </div>

            <span class="projects-count">
                @Model.Count پروژه
            </span>
        </div>

        <div class="projects-grid">

            @foreach (var project in Model)
            {
                <article class="project-card">

                    <div class="project-card-header">

                        <div class="project-card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 3h6" />
                                <path d="M10 3v5.2L5.8 16a3.5 3.5 0 0 0 3.1 5h6.2a3.5 3.5 0 0 0 3.1-5L14 8.2V3" />
                                <path d="M8 15h8" />
                                <path d="M10 18h.01M14 17h.01" />
                            </svg>
                        </div>

                        <div class="project-card-id">
                            <span class="project-reference-label">
                                شناسه پروژه
                            </span>

                            <div class="project-reference-copy">
                                <span class="crh-id">@project.ReferenceCode</span>

                                <button type="button"
                                        class="project-copy-button"
                                        data-reference="@project.ReferenceCode"
                                        title="کپی شناسه"
                                        aria-label="کپی شناسه @project.ReferenceCode">

                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="8" y="8" width="12" height="12" rx="2" />
                                        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <span class="project-status @(project.IsActive ? "project-status-active" : "project-status-inactive")">
                            <span class="project-status-dot"></span>
                            @(project.IsActive ? "فعال" : "غیرفعال")
                        </span>

                    </div>

                    <div class="project-card-body">

                        <h3 class="project-card-title">
                            @project.Name
                        </h3>

                        <div class="project-card-description">
                            @if (string.IsNullOrWhiteSpace(project.Description))
                            {
                                <span class="project-description-empty">
                                    توضیحی برای این پروژه ثبت نشده است.
                                </span>
                            }
                            else
                            {
                                @project.Description
                            }
                        </div>

                    </div>

                    <div class="project-card-footer">
                        <div class="project-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                جزئیات
                            </a>

                            <a asp-area="Research"
                               asp-controller="Boards"
                               asp-action="Index"
                               asp-route-projectId="@project.Id"
                               class="crh-btn crh-btn-primary">
                                بورد
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="crh-btn crh-btn-soft">
                                ویرایش
                            </a>

                        </div>
                    </div>

                </article>
            }

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/projects-index.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".project-copy-button")
                .forEach(function (button) {

                    button.addEventListener("click", async function (event) {

                        event.preventDefault();
                        event.stopPropagation();

                        const referenceCode = button.dataset.reference;

                        if (!referenceCode)
                            return;

                        try {
                            await navigator.clipboard.writeText(referenceCode);

                            const originalContent = button.innerHTML;

                            button.innerHTML = `
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m5 12 4 4L19 6" />
                                </svg>
                            `;

                            button.classList.add("copied");
                            button.title = "کپی شد";

                            setTimeout(function () {
                                button.innerHTML = originalContent;
                                button.classList.remove("copied");
                                button.title = "کپی شناسه";
                            }, 1200);

                        } catch (error) {
                            console.error(
                                "Could not copy project reference:",
                                error
                            );
                        }
                    });
                });
        });
    </script>
}