@model ChemResearchHub.Web.Models.WorkItems.WorkItemsIndexViewModel

@{
    ViewData["Title"] = "کارهای پژوهشی";
}

<div class="workitems-page" dir="rtl">

    <!-- Header -->

    <div class="workitems-header">

        <div class="workitems-header-content">

            <div class="workitems-eyebrow">
                <i class="bi bi-kanban"></i>
                Research Workspace
            </div>

            <h1 class="workitems-title">
                کارهای پژوهشی
            </h1>

            <p class="workitems-description">
                مشاهده، جستجو و پیگیری Work Itemهای ثبت‌شده در سامانه
            </p>

        </div>

        <div class="workitems-count-card">
            <div class="workitems-count-icon">
                <i class="bi bi-list-task"></i>
            </div>

            <div>
                <div class="workitems-count-label">
                    تعداد نتایج
                </div>

                <div class="workitems-count-value">
                    @Model.Items.Count
                </div>
            </div>
        </div>

    </div>


    <!-- Filters -->

    <section class="workitems-filter-card">

        <div class="workitems-card-header">

            <div class="workitems-section-icon">
                <i class="bi bi-funnel"></i>
            </div>

            <div>
                <h2>فیلتر و جستجو</h2>
                <p>برای پیدا کردن Work Item موردنظر از فیلترها استفاده کنید.</p>
            </div>

        </div>

        <div class="workitems-filter-body">

            <form asp-area="Research"
                  asp-controller="WorkItems"
                  asp-action="Index"
                  method="get">

                <div class="workitems-filter-grid">

                    <!-- Search -->

                    <div class="workitems-filter-field workitems-search-field">

                        <label for="search">
                            <i class="bi bi-search"></i>
                            جستجو
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@Model.Search"
                               class="form-control workitems-control"
                               placeholder="عنوان یا توضیحات Work Item..." />

                    </div>


                    <!-- Status -->

                    <div class="workitems-filter-field">

                        <label for="status">
                            <i class="bi bi-circle-half"></i>
                            وضعیت
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select workitems-control">

                            <option value="all"
                                    selected="@(Model.Status == "all")">
                                همه وضعیت‌ها
                            </option>

                            <option value="open"
                                    selected="@(Model.Status == "open")">
                                باز
                            </option>

                            <option value="completed"
                                    selected="@(Model.Status == "completed")">
                                تکمیل‌شده
                            </option>

                        </select>

                    </div>


                    <!-- Assignee -->

                    <div class="workitems-filter-field">

                        <label for="assignedToUserId">
                            <i class="bi bi-person"></i>
                            مسئول
                        </label>

                        <select id="assignedToUserId"
                                name="assignedToUserId"
                                class="form-select workitems-control">

                            <option value="">
                                همه مسئولان
                            </option>

                            @foreach (var user in Model.Assignees)
                            {
                                <option value="@user.Id"
                                        selected="@(Model.AssignedToUserId == user.Id)">
                                    @user.FullName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Tags -->

                    <div class="workitems-filter-field workitems-tag-filter">

                        <label for="tagDropdownToggle">
                            <i class="bi bi-tags"></i>
                            برچسب‌ها
                        </label>

                        @if (Model.AvailableTags.Count == 0)
                        {
                            <div class="workitems-no-tags">
                                <i class="bi bi-info-circle"></i>
                                برچسب فعالی وجود ندارد.
                            </div>
                        }
                        else
                        {
                            <div class="workitems-tag-filter-control">

                                <div class="workitems-tag-dropdown">

                                    <button type="button"
                                            id="tagDropdownToggle"
                                            class="workitems-tag-dropdown-toggle"
                                            aria-expanded="false"
                                            aria-controls="tagDropdownMenu">

                                        <span>
                                            <i class="bi bi-tag"></i>
                                            انتخاب برچسب...
                                        </span>

                                        <i class="bi bi-chevron-down"></i>

                                    </button>

                                    <div id="tagDropdownMenu"
                                         class="workitems-tag-dropdown-menu"
                                         hidden>

                                        <div class="workitems-tag-search">

                                            <i class="bi bi-search"></i>

                                            <input type="text"
                                                   id="tagSearchInput"
                                                   class="form-control"
                                                   placeholder="جستجوی برچسب..."
                                                   autocomplete="off" />

                                        </div>

                                        <div class="workitems-tag-options"
                                             id="tagOptions">

                                            @foreach (var tag in Model.AvailableTags)
                                            {
                                                <button type="button"
                                                        class="workitems-tag-option"
                                                        data-tag-id="@tag.Id"
                                                        data-tag-name="@tag.Name"
                                                        data-tag-color="@tag.Color"
                                                        aria-pressed="@Model.TagIds.Contains(tag.Id).ToString().ToLowerInvariant()">

                                                    <span class="badge"
                                                          style="background-color:@tag.Color;color:white;">
                                                        @tag.Name
                                                    </span>

                                                    <span class="workitems-tag-option-check">
                                                        @(Model.TagIds.Contains(tag.Id) ? "✓" : "")
                                                    </span>

                                                </button>
                                            }

                                        </div>

                                        <div class="workitems-tag-dropdown-footer">
                                            برای انتخاب یا حذف برچسب کلیک کنید.
                                        </div>

                                    </div>

                                </div>

                                <div id="selectedTags"
                                     class="workitems-selected-tags">

                                    @foreach (var tag in Model.AvailableTags.Where(x => Model.TagIds.Contains(x.Id)))
                                    {
                                        <span class="workitems-selected-tag"
                                              data-tag-id="@tag.Id"
                                              style="background-color:@tag.Color;color:white;">

                                            <span>@tag.Name</span>

                                            <button type="button"
                                                    class="workitems-remove-tag"
                                                    data-remove-tag="@tag.Id"
                                                    aria-label="حذف @tag.Name">
                                                <i class="bi bi-x"></i>
                                            </button>

                                        </span>

                                        <input type="hidden"
                                               name="tagIds"
                                               value="@tag.Id"
                                               data-tag-input="@tag.Id" />
                                    }

                                </div>

                            </div>
                        }

                    </div>


                    <!-- Actions -->

                    <div class="workitems-filter-actions">

                        <button type="submit"
                                class="workitems-search-button">

                            <i class="bi bi-search"></i>
                            جستجو

                        </button>

                        <a asp-area="Research"
                           asp-controller="WorkItems"
                           asp-action="Index"
                           class="workitems-reset-button">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            پاک کردن فیلترها

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </section>


    <!-- Work Items List -->

    <section class="workitems-list-card">

        <div class="workitems-list-header">

            <div class="workitems-list-heading">

                <div class="workitems-section-icon">
                    <i class="bi bi-card-list"></i>
                </div>

                <div>
                    <h2>فهرست کارهای پژوهشی</h2>
                    <p>نتایج مطابق فیلترهای انتخاب‌شده</p>
                </div>

            </div>

            <div class="workitems-list-result">
                <strong>@Model.Items.Count</strong>
                <span>مورد</span>
            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="workitems-empty">

                <div class="workitems-empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <div class="workitems-empty-title">
                    کاری پیدا نشد
                </div>

                <div class="workitems-empty-description">
                    با تغییر فیلترها یا عبارت جستجو دوباره تلاش کنید.
                </div>

            </div>
        }
        else
        {
            <div class="workitems-table-wrapper">

                <table class="table workitems-table">

                    <thead>
                        <tr>
                            <th>عنوان</th>
                            <th>پروژه</th>
                            <th>نوع</th>
                            <th>اولویت</th>
                            <th>مسئول</th>
                            <th>موعد</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <!-- Title -->

                                <td class="workitems-title-cell">

                                    <div class="workitem-table-title">
                                        @item.Title
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="workitem-table-description">
                                            @item.Description
                                        </div>
                                    }

                                    @if (item.Tags.Count > 0)
                                    {
                                        <div class="workitem-row-tags">

                                            @foreach (var tag in item.Tags)
                                            {
                                                <span class="workitem-row-tag"
                                                      style="background-color:@tag.Color;color:white;">
                                                    @tag.Name
                                                </span>
                                            }

                                        </div>
                                    }

                                </td>


                                <!-- Project -->

                                <td>
                                    <span class="workitem-project-badge">
                                        <i class="bi bi-folder2"></i>
                                        پروژه #@item.ProjectId
                                    </span>
                                </td>


                                <!-- Type -->

                                <td>
                                    <span class="workitem-type-badge">
                                        @item.Type
                                    </span>
                                </td>


                                <!-- Priority -->

                                <td>

                                    @{
                                        var priorityClass =
                                            item.Priority >= 8
                                                ? "priority-high"
                                                : item.Priority >= 5
                                                    ? "priority-medium"
                                                    : "priority-low";

                                        var priorityText =
                                            item.Priority >= 8
                                                ? "بالا"
                                                : item.Priority >= 5
                                                    ? "متوسط"
                                                    : "پایین";
                                    }

                                    <div class="workitem-priority-wrapper">

                                        <span class="workitem-priority @priorityClass">
                                            @priorityText
                                        </span>

                                        <span class="workitem-priority-number">
                                            @item.Priority
                                        </span>

                                    </div>

                                </td>


                                <!-- Assigned User -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.AssignedToUserName))
                                    {
                                        <span class="workitem-unassigned">
                                            <i class="bi bi-person-dash"></i>
                                            بدون مسئول
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-assignee">
                                            <i class="bi bi-person-circle"></i>
                                            @item.AssignedToUserName
                                        </span>
                                    }

                                </td>


                                <!-- Due Date -->

                                <td>

                                    @if (item.DueDate.HasValue)
                                    {
                                        <span class="workitem-due-date">
                                            <i class="bi bi-calendar3"></i>
                                            @item.DueDate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-unassigned">
                                            <i class="bi bi-calendar-minus"></i>
                                            بدون موعد
                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (item.IsCompleted)
                                    {
                                        <span class="workitem-status workitem-status-completed">
                                            <i class="bi bi-check-circle-fill"></i>
                                            تکمیل‌شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-status workitem-status-open">
                                            <span class="workitem-status-dot"></span>
                                            باز
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>


<script>
    (() => {
        const toggle = document.getElementById("tagDropdownToggle");
        const menu = document.getElementById("tagDropdownMenu");
        const search = document.getElementById("tagSearchInput");
        const options = document.getElementById("tagOptions");
        const selected = document.getElementById("selectedTags");

        if (!toggle || !menu || !search || !options || !selected) return;

        const closeMenu = () => {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
        };

        const openMenu = () => {
            menu.hidden = false;
            toggle.setAttribute("aria-expanded", "true");
            search.focus();
        };

        const updateOption = (id, isSelected) => {
            const option = Array.from(
                options.querySelectorAll(".workitems-tag-option")
            ).find(x => x.dataset.tagId === String(id));

            if (!option) return;

            option.setAttribute("aria-pressed", String(isSelected));

            const check = option.querySelector(".workitems-tag-option-check");

            if (check) {
                check.textContent = isSelected ? "✓" : "";
            }
        };

        const removeTag = id => {
            selected.querySelector(`[data-tag-id="${id}"]`)?.remove();
            selected.querySelector(`[data-tag-input="${id}"]`)?.remove();

            updateOption(id, false);
        };

        toggle.addEventListener("click", () => {
            if (menu.hidden) {
                openMenu();
            } else {
                closeMenu();
            }
        });

        search.addEventListener("input", () => {
            const term = search.value.trim().toLocaleLowerCase();

            options.querySelectorAll(".workitems-tag-option").forEach(option => {
                option.hidden = !option.dataset.tagName
                    .toLocaleLowerCase()
                    .includes(term);
            });
        });

        options.addEventListener("click", event => {
            const option = event.target.closest(".workitems-tag-option");

            if (!option) return;

            const id = option.dataset.tagId;
            const name = option.dataset.tagName;
            const color = option.dataset.tagColor;

            const existing = selected.querySelector(
                `[data-tag-id="${id}"]`
            );

            if (existing) {
                removeTag(id);
                return;
            }

            const badge = document.createElement("span");
            badge.className = "workitems-selected-tag";
            badge.dataset.tagId = id;
            badge.style.backgroundColor = color;
            badge.style.color = "white";

            const label = document.createElement("span");
            label.textContent = name;

            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "workitems-remove-tag";
            remove.setAttribute("aria-label", "حذف " + name);
            remove.innerHTML = '<i class="bi bi-x"></i>';

            remove.addEventListener("click", () => removeTag(id));

            badge.append(label, remove);
            selected.appendChild(badge);

            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "tagIds";
            input.value = id;
            input.dataset.tagInput = id;

            selected.appendChild(input);

            updateOption(id, true);
        });

        selected.addEventListener("click", event => {
            const button = event.target.closest("[data-remove-tag]");

            if (!button) return;

            removeTag(button.dataset.removeTag);
        });

        document.addEventListener("click", event => {
            if (!event.target.closest(".workitems-tag-dropdown")) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                closeMenu();
            }
        });

        // Initial selected tags state
        options.querySelectorAll(".workitems-tag-option").forEach(option => {
            const id = option.dataset.tagId;

            const isSelected = !!selected.querySelector(
                `[data-tag-id="${id}"]`
            );

            updateOption(id, isSelected);
        });

    })();
</script>


@section Styles {
    <link rel="stylesheet"
          href="~/css/work-items-index.css"
          asp-append-version="true" />
}