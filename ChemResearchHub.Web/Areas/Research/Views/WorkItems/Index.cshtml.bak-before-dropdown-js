@model ChemResearchHub.Web.Models.WorkItems.WorkItemsIndexViewModel

@{
    ViewData["Title"] = "کارهای پژوهشی";
}

<div class="workitems-page"
     dir="rtl">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="workitems-header">

        <div>

            <div class="workitems-eyebrow">
                پژوهش
            </div>

            <h1 class="workitems-title">
                کارهای پژوهشی
            </h1>

            <p class="workitems-description">
                مشاهده، جستجو و پیگیری Work Itemهای ثبت‌شده در سامانه
            </p>

        </div>

        <div class="workitems-count-card">

            <div class="workitems-count-label">
                تعداد نمایش
            </div>

            <div class="workitems-count-value">
                @Model.Items.Count
            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <div class="workitems-filter-card">

        <form asp-area="Research" method="get"
              asp-controller="WorkItems"
              asp-action="Index">

            <div class="workitems-filter-grid">

                <!-- Search -->

                <div class="workitems-filter-field">

                    <label for="search">
                        جستجو
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="عنوان یا توضیحات..." />

                </div>


                <!-- Status -->

                <div class="workitems-filter-field">

                    <label for="status">
                        وضعیت
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="all"
                                selected="@(Model.Status == "all")">

                            همه

                        </option>

                        <option value="open"
                                selected="@(Model.Status == "open")">

                            باز

                        </option>

                        <option value="completed"
                                selected="@(Model.Status == "completed")">

                            تکمیل‌شده

                        </option>

                    </select>

                </div>


                <!-- Assignee -->

                <div class="workitems-filter-field">

                    <label for="assignedToUserId">
                        مسئول
                    </label>

                    <select id="assignedToUserId"
                            name="assignedToUserId"
                            class="form-select">

                        <option value="">
                            همه
                        </option>

                        @foreach (var user in Model.Assignees)
                        {
                            <option value="@user.Id"
                                    selected="@(Model.AssignedToUserId == user.Id)">

                                @user.FullName

                            </option>
                        }

                    </select>

                </div>


                <!-- Tags -->
                <div class="workitems-filter-field workitems-tag-filter">
                    <label for="tagDropdownToggle">برچسب‌ها</label>

                    @if (Model.AvailableTags.Count == 0)
                    {
                        <span class="text-muted small">برچسب فعالی وجود ندارد.</span>
                    }
                    else
                    {
                        <div class="workitems-tag-filter-control">
                            <div class="workitems-tag-dropdown">
                                <button type="button"
                                        id="tagDropdownToggle"
                                        class="form-control workitems-tag-dropdown-toggle"
                                        aria-expanded="false"
                                        aria-controls="tagDropdownMenu">
                                    <span>انتخاب برچسب...</span>
                                    <span>▾</span>
                                </button>

                                <div id="tagDropdownMenu" class="workitems-tag-dropdown-menu" hidden>
                                    <input type="text"
                                           id="tagSearchInput"
                                           class="form-control"
                                           placeholder="جستجوی برچسب..."
                                           autocomplete="off" />

                                    <div class="workitems-tag-options" id="tagOptions">
                                        @foreach (var tag in Model.AvailableTags)
                                        {
                                            <button type="button"
                                                    class="workitems-tag-option"
                                                    data-tag-id="@tag.Id"
                                                    data-tag-name="@tag.Name"
                                                    data-tag-color="@tag.Color"
                                                    aria-pressed="@Model.TagIds.Contains(tag.Id).ToString().ToLowerInvariant()">
                                                <span class="badge"
                                                      style="background-color:@tag.Color;color:white;">
                                                    @tag.Name
                                                </span>
                                                <span class="workitems-tag-option-check">
                                                    @(Model.TagIds.Contains(tag.Id) ? "✓" : "")
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div id="selectedTags" class="workitems-selected-tags">
                                @foreach (var tag in Model.AvailableTags.Where(x => Model.TagIds.Contains(x.Id)))
                                {
                                    <span class="badge d-inline-flex align-items-center gap-2"
                                          data-tag-id="@tag.Id"
                                          style="background-color:@tag.Color;color:white;">
                                        @tag.Name
                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                aria-label="حذف @tag.Name"
                                                style="font-size:.55rem;"
                                                onclick="removeWorkItemTag(@tag.Id)"></button>
                                    </span>
                                    <input type="hidden" name="tagIds" value="@tag.Id" data-tag-input="@tag.Id" />
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Actions -->

                <div class="workitems-filter-actions">

                    <button type="submit"
                            class="btn btn-primary">

                        🔎 جستجو

                    </button>

                    <a asp-area="Research" asp-controller="WorkItems"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        پاک کردن فیلتر

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- =====================================================
         LIST
         ===================================================== -->

    <div class="workitems-list-card">

        <div class="workitems-list-header">

            <div>
                فهرست کارها
            </div>

            <div class="workitems-list-result">

                @Model.Items.Count مورد

            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="workitems-empty">

                <div class="workitems-empty-icon">
                    📭
                </div>

                <div class="workitems-empty-title">
                    کاری پیدا نشد
                </div>

                <div class="workitems-empty-description">
                    با تغییر فیلترها یا عبارت جستجو دوباره تلاش کنید.
                </div>

            </div>
        }
        else
        {
            <div class="workitems-table-wrapper">

                <table class="table workitems-table">

                    <thead>

                        <tr>

                            <th>
                                عنوان
                            </th>

                            <th>
                                پروژه
                            </th>

                            <th>
                                نوع
                            </th>

                            <th>
                                اولویت
                            </th>

                            <th>
                                مسئول
                            </th>

                            <th>
                                موعد
                            </th>

                            <th>
                                وضعیت
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <!-- Title -->

                                <td>

                                    <div class="workitem-table-title">
                                        @item.Title
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="workitem-table-description">
                                            @item.Description
                                        </div>
                                    }
                                    @if (item.Tags.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @foreach (var tag in item.Tags)
                                            {
                                                <span class="badge"
                                                      style="background-color: @tag.Color; color: white;">
                                                    @tag.Name
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>


                                <!-- Project -->

                                <td>

                                    <span class="workitem-project-badge">
                                        پروژه #@item.ProjectId
                                    </span>

                                </td>


                                <!-- Type -->

                                <td>

                                    <span class="workitem-type-badge">
                                        @item.Type
                                    </span>

                                </td>


                                <!-- Priority -->

                                <td>

                                    @{
                                        var priorityClass =
                                        item.Priority >= 8
                                        ? "priority-high"
                                        : item.Priority >= 5
                                        ? "priority-medium"
                                        : "priority-low";

                                        var priorityText =
                                        item.Priority >= 8
                                        ? "بالا"
                                        : item.Priority >= 5
                                        ? "متوسط"
                                        : "پایین";
                                    }

                                    <span class="workitem-priority @priorityClass">

                                        @priorityText

                                    </span>

                                    <div class="workitem-priority-number">
                                        @item.Priority
                                    </div>

                                </td>


                                <!-- Assigned User -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.AssignedToUserName))
                                    {
                                        <span class="workitem-unassigned">
                                            بدون مسئول
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-assignee">
                                            👤 @item.AssignedToUserName
                                        </span>
                                    }

                                </td>


                                <!-- Due Date -->

                                <td>

                                    @if (item.DueDate.HasValue)
                                    {
                                        <span class="workitem-due-date">

                                            @item.DueDate.Value.ToString("yyyy-MM-dd")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-unassigned">
                                            بدون موعد
                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (item.IsCompleted)
                                    {
                                        <span class="workitem-status workitem-status-completed">
                                            ✓ تکمیل‌شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="workitem-status workitem-status-open">
                                            ● باز
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<script>
    (() => {
        const selector = document.getElementById("tagSelector");
        const options = document.getElementById("availableTagOptions");
        const selectedContainer = document.getElementById("selectedTags");

        if (!selector || !options || !selectedContainer) return;

        selector.addEventListener("change", () => {
            const selectedName = selector.value.trim();
            const option = Array.from(options.options)
                .find(x => x.value === selectedName);

            if (!option) return;

            const tagId = option.dataset.tagId;
            const tagName = option.value;
            const tagColor = option.dataset.tagColor;

            if (!selectedContainer.querySelector(`[data-tag-id="${tagId}"]`)) {
                const badge = document.createElement("span");
                badge.className = "badge d-inline-flex align-items-center gap-2";
                badge.dataset.tagId = tagId;
                badge.style.backgroundColor = tagColor;
                badge.style.color = "white";

                const text = document.createElement("span");
                text.textContent = tagName;

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.className = "btn-close btn-close-white";
                removeButton.style.fontSize = ".55rem";
                removeButton.setAttribute("aria-label", "حذف " + tagName);
                removeButton.addEventListener("click", () => removeWorkItemTag(tagId));

                badge.append(text, removeButton);
                selectedContainer.appendChild(badge);

                const hiddenInput = document.createElement("input");
                hiddenInput.type = "hidden";
                hiddenInput.name = "tagIds";
                hiddenInput.value = tagId;
                hiddenInput.dataset.tagInput = tagId;
                selectedContainer.appendChild(hiddenInput);
            }

            selector.value = "";
        });

        window.removeWorkItemTag = (tagId) => {
            selectedContainer.querySelector(`[data-tag-id="${tagId}"]`)?.remove();
            selectedContainer.querySelector(`[data-tag-input="${tagId}"]`)?.remove();
        };
    })();
</script>
