@model ChemResearchHub.Application.WorkItemTransitions.Dtos.WorkItemFlowSummaryDto

@functions {
    string FormatDuration(TimeSpan? value)
    {
        if (!value.HasValue)
            return "-";

        var duration = value.Value;

        if (duration.TotalMinutes < 1)
            return "Less than 1 minute";

        if (duration.TotalHours < 1)
            return $"{Math.Max(1, (int)duration.TotalMinutes)} min";

        if (duration.TotalDays < 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";

        return $"{(int)duration.TotalDays}d {duration.Hours}h";
    }
}

@{
    ViewData["Title"] = "Board Flow Metrics";

    var boardName = ViewBag.BoardName as string ?? $"Board #{Model.BoardId}";
    var fromDate = Model.PeriodStartUtc.ToLocalTime().ToString("yyyy-MM-dd");
    var toDate = Model.PeriodEndUtc.AddDays(-1).ToLocalTime().ToString("yyyy-MM-dd");
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/flow-metrics.css"
          asp-append-version="true" />
}

<div class="flow-metrics-page">

    <div class="flow-metrics-header">
        <div class="flow-metrics-heading">
            <div class="flow-metrics-eyebrow">Research Flow</div>
            <h1>Board Flow Metrics</h1>
            <p>
                <span>@boardName</span>
                <span class="flow-header-separator">·</span>
                <span>Board #@Model.BoardId</span>
            </p>
        </div>

        <a asp-action="Index" class="flow-back-button">
            <span aria-hidden="true">←</span>
            Back to Work Items
        </a>
    </div>

    <section class="flow-period-card">

        <div class="flow-period-heading">
            <div class="flow-period-icon">📅</div>
            <div>
                <h2>Measurement Period</h2>
                <p>Choose a date range to calculate board flow metrics</p>
            </div>
        </div>

        <form asp-action="FlowMetrics"
              method="get"
              class="flow-period-form">

            <input type="hidden" name="boardId" value="@Model.BoardId" />

            <div class="flow-period-field">
                <label for="flowFromDate">From</label>
                <input type="date"
                       id="flowFromDate"
                       name="from"
                       value="@fromDate"
                       class="form-control" />
            </div>

            <div class="flow-period-field">
                <label for="flowToDate">To</label>
                <input type="date"
                       id="flowToDate"
                       name="to"
                       value="@toDate"
                       class="form-control" />
            </div>

            <div class="flow-period-action">
                <button type="submit" class="flow-primary-button">
                    Apply Period
                </button>
            </div>
        </form>

        <div class="flow-metric-explanation">
            <div>
                <strong>Throughput</strong>
                <span>counts Work Items completed during this period.</span>
            </div>
            <div>
                <strong>Lead Time</strong>
                <span>starts at Work Item creation.</span>
            </div>
            <div>
                <strong>Cycle Time</strong>
                <span>starts at its first workflow movement.</span>
            </div>
        </div>

    </section>

    <section class="flow-kpi-grid">

        <article class="flow-kpi-card flow-kpi-throughput">
            <div class="flow-kpi-top">
                <div class="flow-kpi-icon">✓</div>
                <span class="flow-kpi-label">Throughput</span>
            </div>

            <div class="flow-kpi-value">@Model.Throughput</div>
            <div class="flow-kpi-description">completed Work Items</div>
        </article>

        <article class="flow-kpi-card flow-kpi-lead">
            <div class="flow-kpi-top">
                <div class="flow-kpi-icon">⏱</div>
                <span class="flow-kpi-label">Average Lead Time</span>
            </div>

            <div class="flow-kpi-value flow-kpi-duration">
                @FormatDuration(Model.AverageLeadTime)
            </div>

            <div class="flow-kpi-median">
                <span>Median</span>
                <strong>@FormatDuration(Model.MedianLeadTime)</strong>
            </div>
        </article>

        <article class="flow-kpi-card flow-kpi-cycle">
            <div class="flow-kpi-top">
                <div class="flow-kpi-icon">↻</div>
                <span class="flow-kpi-label">Average Cycle Time</span>
            </div>

            <div class="flow-kpi-value flow-kpi-duration">
                @FormatDuration(Model.AverageCycleTime)
            </div>

            <div class="flow-kpi-median">
                <span>Median</span>
                <strong>@FormatDuration(Model.MedianCycleTime)</strong>
            </div>
        </article>

    </section>

    <section class="flow-completed-card">

        <div class="flow-completed-header">
            <div>
                <h2>Completed Work Items</h2>
                <p>Work Items completed within the selected period</p>
            </div>

            <span class="flow-completed-count">
                @Model.CompletedItems.Count
            </span>
        </div>

        @if (Model.CompletedItems.Count == 0)
        {
            <div class="flow-empty-state">
                <div class="flow-empty-icon">📋</div>
                <h3>No completed Work Items</h3>
                <p>
                    No Work Items were completed during this period.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table flow-completed-table align-middle">
                    <thead>
                        <tr>
                            <th>Work Item</th>
                            <th>Completed</th>
                            <th>Lead Time</th>
                            <th>Cycle Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.CompletedItems)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.WorkItemId"
                                       class="flow-work-item-link">
                                        @item.Title
                                    </a>

                                    <div class="flow-work-item-id">
                                        #@item.WorkItemId
                                    </div>
                                </td>

                                <td>
                                    <span class="flow-completed-date">
                                        @item.CompletedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </td>

                                <td>
                                    <span class="flow-duration-value">
                                        @FormatDuration(item.LeadTime)
                                    </span>
                                </td>

                                <td>
                                    <span class="flow-duration-value">
                                        @FormatDuration(item.CycleTime)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

</div>