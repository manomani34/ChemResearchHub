@using ChemResearchHub.Application.Meetings.DTOs
@model MeetingActionItemDto

<section class="card shadow-sm mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            <i class="bi bi-calendar-check me-2"></i>
            Research Meeting Action Item
        </h5>

        <span class="badge bg-primary">
            @Model.Type
        </span>

    </div>

    <div class="card-body">

        <h5 class="mb-3">
            @Model.Title
        </h5>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted">
                @Model.Description
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AcceptanceCriteria))
        {
            <div class="mb-3">
                <strong>Acceptance Criteria</strong>
                <p class="mb-0">
                    @Model.AcceptanceCriteria
                </p>
            </div>
        }

        <div class="row g-3">

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Action Item ID
                </small>
                <strong>#@Model.Id</strong>
            </div>

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Meeting Session
                </small>
                <strong>#@Model.MeetingSessionId</strong>
            </div>

            <div class="col-md-4">
                <small class="text-muted d-block">
                    Status
                </small>
                <strong>@Model.Status</strong>
            </div>

            @if (Model.DueDate.HasValue)
            {
                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Due Date
                    </small>
                    <strong>
                        @Model.DueDate.Value.ToLocalTime().ToString("yyyy/MM/dd")
                    </strong>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AssignedToUserId))
            {
                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Assigned To
                    </small>
                    <strong>
                        @Model.AssignedToUserId
                    </strong>
                </div>
            }

            @if (Model.CompletedAt.HasValue)
            {
                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Completed At
                    </small>
                    <strong>
                        @Model.CompletedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </strong>
                </div>
            }

        </div>

        <hr />

        <a asp-area="Research"
           asp-controller="MeetingActionItems"
           asp-action="Index"
           asp-route-meetingSessionId="@Model.MeetingSessionId"
           class="btn btn-outline-primary btn-sm">

            <i class="bi bi-box-arrow-up-right"></i>
            مشاهده Action Items جلسه

        </a>

    </div>

</section>