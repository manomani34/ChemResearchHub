@using ChemResearchHub.Application.Meetings.DTOs
@model MeetingActionItemDto

<style>

    /* =========================================
       Research Meeting Action Item
    ========================================= */

    .meeting-action-card {
        background: #fff;
        border: 1px solid #e9eaf1;
        border-radius: 16px;
        box-shadow: 0 3px 14px rgba(31, 35, 60, 0.045);
        overflow: hidden;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .meeting-action-card:hover {
            border-color: #dedbf8;
            box-shadow: 0 5px 18px rgba(101, 88, 211, 0.07);
        }

    .meeting-action-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 17px 18px;
        background: #fff;
        border-bottom: 1px solid #eeeef4;
    }

    .meeting-action-card__heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .meeting-action-card__icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6558d3;
        background: #f0efff;
        border-radius: 11px;
    }

        .meeting-action-card__icon svg {
            width: 20px;
            height: 20px;
        }

    .meeting-action-card__heading h5 {
        margin: 0;
        color: #292b3a;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.6;
    }

    .meeting-action-card__subtitle {
        display: block;
        margin-top: 2px;
        color: #9294a5;
        font-size: 11px;
    }

    .meeting-action-card__type {
        flex-shrink: 0;
        padding: 5px 10px;
        color: #6558d3;
        background: #f0efff;
        border: 1px solid #e5e2ff;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .meeting-action-card__body {
        padding: 18px;
    }

    .meeting-action-card__title {
        margin: 0 0 12px;
        color: #292b3a;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .meeting-action-card__description {
        margin: 0 0 17px;
        color: #77798b;
        font-size: 13px;
        line-height: 1.9;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .meeting-action-card__criteria {
        margin-bottom: 18px;
        padding: 12px 14px;
        background: #f8f8fc;
        border: 1px solid #ededf4;
        border-right: 3px solid #6558d3;
        border-radius: 9px;
    }

    .meeting-action-card__label {
        display: block;
        margin-bottom: 5px;
        color: #9294a5;
        font-size: 11px;
        font-weight: 500;
    }

    .meeting-action-card__criteria p {
        margin: 0;
        color: #55576a;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .meeting-action-card__details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .meeting-action-card__detail {
        min-width: 0;
        padding: 11px 12px;
        background: #fafafe;
        border: 1px solid #eeeef4;
        border-radius: 10px;
    }

        .meeting-action-card__detail strong {
            display: block;
            color: #414356;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

    .meeting-action-card__user {
        word-break: break-word;
    }

    .meeting-action-card__footer {
        margin-top: 17px;
        padding-top: 14px;
        border-top: 1px solid #eeeef4;
    }

    .meeting-action-card__link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        padding: 10px 13px;
        color: #6558d3;
        background: #f6f5ff;
        border: 1px solid #e8e5ff;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .meeting-action-card__link:hover {
            color: #5144bd;
            background: #eeecff;
            border-color: #d9d4ff;
        }

        .meeting-action-card__link svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    @@media (max-width: 575.98px) {
        .meeting-action-card__header,
        .meeting-action-card__body {
            padding: 14px;
        }

        .meeting-action-card__heading h5 {
            font-size: 12px;
        }

        .meeting-action-card__details {
            grid-template-columns: 1fr;
        }
    }

</style>

<section class="meeting-action-card mb-4 mt-4">

    <div class="meeting-action-card__header">
        <div class="meeting-action-card__heading">
            <span class="meeting-action-card__icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 10h18" />
                    <path d="m9 15 2 2 4-4" />
                </svg>
            </span>

            <div>
                <h5>Research Meeting Action Item</h5>
                <span class="meeting-action-card__subtitle">
                    Linked meeting action
                </span>
            </div>
        </div>

        <span class="meeting-action-card__type">
            @Model.Type
        </span>
    </div>

    <div class="meeting-action-card__body">

        <h5 class="meeting-action-card__title">
            @Model.Title
        </h5>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="meeting-action-card__description">
                @Model.Description
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AcceptanceCriteria))
        {
            <div class="meeting-action-card__criteria">
                <span class="meeting-action-card__label">
                    Acceptance Criteria
                </span>

                <p>
                    @Model.AcceptanceCriteria
                </p>
            </div>
        }

        <div class="meeting-action-card__details">

            <div class="meeting-action-card__detail">
                <span class="meeting-action-card__label">
                    Action Item ID
                </span>
                <strong>#@Model.Id</strong>
            </div>

            <div class="meeting-action-card__detail">
                <span class="meeting-action-card__label">
                    Meeting Session
                </span>
                <strong>#@Model.MeetingSessionId</strong>
            </div>

            <div class="meeting-action-card__detail">
                <span class="meeting-action-card__label">
                    Status
                </span>
                <strong>@Model.Status</strong>
            </div>

            @if (Model.DueDate.HasValue)
            {
                <div class="meeting-action-card__detail">
                    <span class="meeting-action-card__label">
                        Due Date
                    </span>
                    <strong>
                        @Model.DueDate.Value.ToLocalTime().ToString("yyyy/MM/dd")
                    </strong>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AssignedToUserId))
            {
                <div class="meeting-action-card__detail">
                    <span class="meeting-action-card__label">
                        Assigned To
                    </span>
                    <strong class="meeting-action-card__user">
                        @Model.AssignedToUserId
                    </strong>
                </div>
            }

            @if (Model.CompletedAt.HasValue)
            {
                <div class="meeting-action-card__detail">
                    <span class="meeting-action-card__label">
                        Completed At
                    </span>
                    <strong>
                        @Model.CompletedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </strong>
                </div>
            }

        </div>

        <div class="meeting-action-card__footer">
            <a asp-area="Research"
               asp-controller="MeetingActionItems"
               asp-action="Index"
               asp-route-meetingSessionId="@Model.MeetingSessionId"
               class="meeting-action-card__link">

                <span>مشاهده Action Items جلسه</span>

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M14 4h6v6" />
                    <path d="M10 14 20 4" />
                    <path d="M20 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h6" />
                </svg>
            </a>
        </div>

    </div>
</section>
